# Visa Convention — Environment Configuration Example
# Copy this file to .env for local runtime overrides.
# No secrets or private credentials are required for building the static website.

# Canonical public production URL (used for XML sitemap generation and Open Graph tags)
PUBLIC_SITE_URL=https://visaconvention.com

# Node.js runtime version enforcement
NODE_VERSION=20.18.0

# Optional: External CRM / Zapier / Make webhook URL for real-time lead dispatch
# If left unset or blank, leads are stored locally in client-content/leads/enquiries.json during server runtime
LEAD_WEBHOOK_URL=
