{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CountryDestinationSchema",
  "description": "Validated JSON Schema for Visa Convention Study Abroad Country Destinations",
  "type": "object",
  "required": [
    "id",
    "name",
    "slug",
    "flagCode",
    "continent",
    "heroImage",
    "shortDescription",
    "introduction",
    "whyStudyHere",
    "educationSystem",
    "studyLevels",
    "admissionGuidance",
    "visaGuidance",
    "servicesAvailable",
    "faqs",
    "relatedUniversityIds",
    "featured",
    "active",
    "publicationStatus",
    "sourceLinks",
    "lastReviewed"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^country-[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "flagCode": { "type": "string", "minLength": 2, "maxLength": 2 },
    "continent": {
      "type": "string",
      "enum": ["North America", "Europe", "Asia", "Oceania", "South America", "Africa"]
    },
    "heroImage": { "type": "string" },
    "shortDescription": { "type": "string", "minLength": 20 },
    "introduction": { "type": "string", "minLength": 50 },
    "whyStudyHere": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "educationSystem": {
      "type": ["object", "string"],
      "properties": {
        "overview": { "type": "string" },
        "keyPoints": { "type": "array", "items": { "type": "string" } },
        "structure": { "type": "string" }
      }
    },
    "studyLevels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Undergraduate", "Postgraduate", "Doctoral / PhD", "Diploma / Vocational"]
      },
      "minItems": 1
    },
    "admissionGuidance": {
      "type": ["object", "string"],
      "properties": {
        "overview": { "type": "string" },
        "generalRequirements": { "type": "array", "items": { "type": "string" } },
        "intakePeriods": { "type": "array", "items": { "type": "string" } },
        "languageRequirements": { "type": "string" }
      }
    },
    "visaGuidance": {
      "type": ["object", "string"],
      "properties": {
        "visaType": { "type": "string" },
        "overview": { "type": "string" },
        "keyRequirements": { "type": "array", "items": { "type": "string" } },
        "processingTime": { "type": "string" },
        "workRights": { "type": "string" },
        "disclaimer": { "type": "string" }
      }
    },
    "costInformation": {
      "type": ["object", "string"],
      "properties": {
        "tuitionRange": { "type": "string" },
        "livingCostRange": { "type": "string" },
        "currency": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "scholarshipInformation": {
      "type": ["object", "string"],
      "properties": {
        "available": { "type": "boolean" },
        "overview": { "type": "string" },
        "opportunities": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "servicesAvailable": {
      "type": "array",
      "items": { "type": "string" }
    },
    "faqs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "relatedUniversityIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "featured": { "type": "boolean" },
    "active": { "type": "boolean" },
    "publicationStatus": {
      "type": "string",
      "enum": ["published", "draft", "archived"]
    },
    "sourceLinks": {
      "type": "array",
      "items": {
        "type": ["object", "string"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "lastReviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}