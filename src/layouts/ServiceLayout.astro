---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import FAQAccordion from '../components/common/FAQAccordion.astro';
import EnquiryForm from '../components/forms/EnquiryForm.astro';
import type { DetailedService, Service } from '../types';
import { getFaqSchema } from '../utils/seo';
import { siteConfig } from '../data/site-config';
import { countriesData } from '../data/countries';

interface Props {
  service: DetailedService | Service;
}

const { service } = Astro.props;

// Published country slugs set to prevent broken links to draft/future country routes
const publishedCountrySlugs = new Set(
  countriesData.filter(c => c.publicationStatus === 'published').map(c => c.slug)
);

// Helper to determine if we have the full DetailedService schema
const isDetailed = 'assistanceIncludes' in service;
const detailed = isDetailed ? (service as DetailedService) : null;
const baseService = !isDetailed ? (service as Service) : null;

const pageTitle = isDetailed && detailed?.metaTitle 
  ? detailed.metaTitle 
  : `${service.title} — Visa Convention`;

const pageDescription = isDetailed && detailed?.metaDescription 
  ? detailed.metaDescription 
  : service.shortDescription;

const faqSchema = service.faqs.length > 0 ? getFaqSchema(service.faqs) : undefined;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={faqSchema}
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: service.title, href: `/services/${service.slug}/`, current: true },
      ]}
    />
  </div>

  <!-- Service Hero Section -->
  <section class="py-12 sm:py-16 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl text-left">
        <span class="inline-block px-3.5 py-1 mb-4 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
          {detailed?.badge ?? 'Professional Advisory'}
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4">
          {detailed?.heroHeadline ?? service.title}
        </h1>
        <p class="text-lg sm:text-xl font-semibold text-brand-blue mb-4 leading-snug">
          {service.subtitle}
        </p>
        <p class="text-base sm:text-lg text-brand-muted leading-relaxed mb-8">
          {service.shortDescription}
        </p>

        <!-- CTA Row -->
        <div class="flex flex-wrap items-center gap-4">
          <a
            href={detailed?.heroCtaHref ?? '#enquiry'}
            class="btn-primary inline-flex items-center gap-2"
          >
            <span>{detailed?.heroCtaText ?? 'Book Free Consultation'}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href="#process"
            class="btn-secondary inline-flex items-center gap-2"
          >
            <span>View Process Roadmap</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content & Form Grid -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">
      <!-- Left Column: Details, Destinations, Institutions, Eligibility, Compliance -->
      <div class="lg:col-span-7 space-y-14">
        
        <!-- SECTION 1: What Assistance Includes -->
        <section>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-red"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Scope of Work</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-6">
            What Our Guidance Includes
          </h2>

          {detailed?.assistanceIncludes ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {detailed.assistanceIncludes.map((item, idx) => (
                <div class="p-5 rounded-xl bg-white border border-brand-border shadow-2xs hover:border-brand-blue/30 transition-colors">
                  <div class="w-7 h-7 rounded-lg bg-brand-bg text-brand-blue flex items-center justify-center font-bold text-xs mb-3">
                    0{idx + 1}
                  </div>
                  <h3 class="text-base font-bold text-brand-navy mb-1.5">{item.title}</h3>
                  <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">{item.description}</p>
                </div>
              ))}
            </div>
          ) : baseService ? (
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {baseService.keyOfferings.map((offering: string) => (
                <li class="p-4 rounded-xl bg-white border border-brand-border text-sm text-brand-navy font-semibold flex items-start gap-2 shadow-2xs">
                  <span class="text-brand-red font-bold text-base leading-none">•</span>
                  <span>{offering}</span>
                </li>
              ))}
            </ul>
          ) : null}
        </section>

        <!-- SECTION 2: Supported Countries / Destination Highlights -->
        {detailed?.supportedCountries && detailed.supportedCountries.length > 0 && (
          <section>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-brand-blue"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Global Reach</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-6">
              Supported Countries & Key Pathways
            </h2>
            <div class="space-y-3">
              {detailed.supportedCountries.map((dest) => (
                <div class="p-4 rounded-xl bg-white border border-brand-border shadow-2xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-full bg-brand-bg text-brand-navy flex items-center justify-center font-bold text-xs flex-shrink-0">
                      🌍
                    </div>
                    <div>
                      <h4 class="font-bold text-brand-navy text-sm sm:text-base">{dest.name}</h4>
                      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">{dest.highlight}</p>
                    </div>
                  </div>
                  {dest.slug && publishedCountrySlugs.has(dest.slug) ? (
                    <a
                      href={`/study-abroad/${dest.slug}/`}
                      class="text-xs font-bold text-brand-blue hover:text-brand-red self-start sm:self-center flex-shrink-0 flex items-center gap-1 transition-colors"
                    >
                      <span>Explore Country</span>
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                      </svg>
                    </a>
                  ) : (
                    <span class="text-3xs font-semibold px-2.5 py-1 rounded-md bg-brand-bg text-brand-navy border border-brand-border self-start sm:self-center flex-shrink-0">
                      Advisory Stream
                    </span>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- SECTION 3: Featured Institutions / Universities Guided -->
        {detailed?.featuredInstitutions && detailed.featuredInstitutions.length > 0 && (
          <section>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Academic Network</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-3">
              Universities Guided / Eligible for Application
            </h2>
            <p class="text-xs text-brand-muted mb-6 leading-relaxed">
              <strong>Integrity Notice:</strong> The following institutions represent verified universities for which Visa Convention provides admissions profile matching, document verification, and student visa filing. Listings do not imply formal contractual partnerships unless explicitly substantiated.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {detailed.featuredInstitutions.map((inst) => (
                <div class="p-4 rounded-xl bg-white border border-brand-border shadow-2xs flex flex-col justify-between">
                  <div>
                    <span class="inline-block px-2 py-0.5 text-3xs font-bold uppercase rounded bg-brand-bg text-brand-navy mb-2">
                      {inst.country} {inst.city ? `• ${inst.city}` : ''}
                    </span>
                    <h4 class="font-bold text-brand-navy text-sm mb-1">{inst.name}</h4>
                    {inst.notes && (
                      <p class="text-xs text-brand-blue font-medium">{inst.notes}</p>
                    )}
                  </div>
                  {inst.website && (
                    <div class="mt-3 pt-3 border-t border-brand-border/60">
                      <a
                        href={inst.website}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-2xs font-semibold text-brand-muted hover:text-brand-navy flex items-center gap-1"
                      >
                        <span>Official Portal</span>
                        <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                        </svg>
                      </a>
                    </div>
                  )}
                </div>
              ))}
            </div>

            <div class="mt-4 text-center">
              <a
                href="/universities/"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-navy hover:text-brand-red transition-colors"
              >
                <span>Browse Complete University Directory</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </section>
        )}

        <!-- SECTION 4: Admission & Eligibility Criteria -->
        <section>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-navy"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Prerequisites</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-6">
            Eligibility & Documentation Criteria
          </h2>

          {detailed?.eligibilityAndCriteria ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {detailed.eligibilityAndCriteria.map((item) => (
                <div class="p-5 rounded-xl bg-white border border-brand-border shadow-2xs">
                  <div class="flex items-center gap-2 mb-2">
                    <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <h3 class="font-bold text-sm text-brand-navy">{item.title}</h3>
                  </div>
                  <p class="text-xs text-brand-muted leading-relaxed pl-6">{item.detail}</p>
                </div>
              ))}
            </div>
          ) : baseService ? (
            <div class="p-6 rounded-2xl bg-white border border-brand-border space-y-3">
              {baseService.eligibilityChecklist.map((check: string) => (
                <div class="flex items-start gap-3 text-sm text-brand-text">
                  <svg class="w-5 h-5 text-emerald-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>{check}</span>
                </div>
              ))}
            </div>
          ) : null}
        </section>

        <!-- SECTION 5: Mandatory Regulatory & Compliance Disclosures -->
        {detailed?.regulatoryCompliance ? (
          <section class="p-6 sm:p-7 rounded-2xl bg-brand-navy text-white shadow-md border-l-4 border-brand-red">
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0 text-amber-400 mt-0.5">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <div>
                <h3 class="text-base sm:text-lg font-bold text-white mb-1">
                  {detailed.regulatoryCompliance.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 mb-4 leading-relaxed font-medium">
                  {detailed.regulatoryCompliance.notice}
                </p>
                <ul class="space-y-2 text-xs text-slate-200">
                  {detailed.regulatoryCompliance.points.map((pt) => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-400 font-bold">•</span>
                      <span class="leading-relaxed">{pt}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </section>
        ) : baseService ? (
          <div class="p-6 rounded-2xl bg-amber-50/70 border border-amber-200/80 text-amber-900 text-xs sm:text-sm leading-relaxed">
            <strong class="font-bold block mb-1">Official Regulatory Disclaimer:</strong>
            {baseService.disclaimer}
          </div>
        ) : null}

        <!-- SECTION 6: Step-by-Step Application Roadmap -->
        <section id="process">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-red"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Workflow</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-6">
            Step-by-Step Application Process
          </h2>

          <div class="relative pl-6 border-l-2 border-brand-border space-y-8">
            {service.stepByStepProcess.map((step) => (
              <div class="relative group">
                <!-- Circle marker on the line -->
                <div class="absolute -left-[31px] top-0 w-8 h-8 rounded-full bg-white border-2 border-brand-navy text-brand-navy flex items-center justify-center font-bold text-xs group-hover:border-brand-red group-hover:text-brand-red group-hover:bg-brand-bg transition-colors">
                  0{step.stepNumber}
                </div>
                <div class="pt-0.5">
                  <h3 class="font-bold text-base text-brand-navy mb-1 group-hover:text-brand-red transition-colors">
                    {step.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                    {step.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>

        <!-- SECTION 7: Why Consult Visa Convention -->
        {detailed?.whyConsultUs && (
          <section>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-brand-blue"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">The Advantage</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-6">
              Why Consult Visa Convention
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {detailed.whyConsultUs.map((item) => (
                <div class="p-5 rounded-xl bg-white border border-brand-border shadow-2xs">
                  <h4 class="font-bold text-brand-navy text-sm mb-1.5 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-brand-red"></span>
                    <span>{item.title}</span>
                  </h4>
                  <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">{item.description}</p>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- SECTION 8: Important Conditions & Disclaimers -->
        {detailed?.conditionsAndDisclaimers && (
          <section class="p-6 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700">
            <h4 class="font-bold text-brand-navy text-sm mb-3 uppercase tracking-wider">
              Important Conditions & Disclaimers
            </h4>
            <ul class="space-y-2 list-disc list-inside">
              {detailed.conditionsAndDisclaimers.map((cond) => (
                <li class="leading-relaxed">{cond}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- SECTION 9: Frequently Asked Questions -->
        {service.faqs.length > 0 && (
          <section>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2.5 h-2.5 rounded-full bg-brand-navy"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Clarity</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy mb-6">
              Frequently Asked Questions
            </h2>
            <FAQAccordion faqs={service.faqs} />
          </section>
        )}

      </div>

      <!-- Right Column: Sticky Consultation Form & Office Info -->
      <div class="lg:col-span-5" id="enquiry">
        <div class="sticky top-28 space-y-6">
          <EnquiryForm
            selectedService={service.slug}
            title={`Enquire: ${service.title}`}
            subtitle="Submit your details for a factual, confidential preliminary evaluation by our counselors."
          />

          <!-- Direct Office Contact Card -->
          <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-2xs space-y-4">
            <h4 class="font-bold text-brand-navy text-sm">
              Visit Our Hanumangarh Office
            </h4>
            <div class="space-y-2.5 text-xs text-brand-muted">
              <div class="flex items-start gap-2.5">
                <svg class="w-4 h-4 text-brand-navy flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>{siteConfig.officeAddress}</span>
              </div>
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-brand-navy flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="font-semibold text-brand-navy hover:text-brand-red transition-colors">
                  {siteConfig.phone}
                </a>
              </div>
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-brand-navy flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <a href={`mailto:${siteConfig.email}`} class="font-semibold text-brand-navy hover:text-brand-red transition-colors">
                  {siteConfig.email}
                </a>
              </div>
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-brand-navy flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Monday – Saturday: 9:30 AM – 6:30 PM</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>