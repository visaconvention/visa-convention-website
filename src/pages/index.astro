---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ReviewsCarousel from '../components/home/ReviewsCarousel.astro';
---

<BaseLayout
  title="Visa Convention — Study Abroad, Visa & Travel Services | Hanumangarh"
  description="Explore international university admissions across 35+ countries, consular visa guidance, and flight reservations with the Visa Convention counseling team in Hanumangarh, Rajasthan."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO (PREMIUM INTERNATIONAL-LANDMARK VISUAL) -->
  <!-- ========================================================================= -->
  <HeroSection
    headline="Explore the World with Visa Convention"
    subheadline="Study Abroad, Visa & Travel Services"
    description="Structured guidance for university admissions across 35+ countries, consular visa dossiers, and flight reservations from our Hanumangarh counseling practice."
    primaryCtaText="Explore Study Abroad"
    primaryCtaHref="/study-abroad/"
    secondaryCtaText="Explore Services"
    secondaryCtaHref="#services"
    imageSrc="/assets/images/hero-landmarks.jpg"
    imageAlt="World iconic landmarks including the Statue of Liberty, Big Ben, Eiffel Tower, and Sydney Opera House"
  />

  <!-- ========================================================================= -->
  <!-- SECTION 2: SIX CORE SERVICE CATEGORIES (3x2 PHOTOGRAPHIC DISCOVERY GRID) -->
  <!-- ========================================================================= -->
  <section id="services" class="py-12 sm:py-16 bg-brand-bg">
    <div class="site-container">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 text-left">
        <div>
          <span class="inline-block px-3.5 py-1 mb-2.5 text-xs font-bold tracking-wider uppercase rounded-full bg-white text-brand-blue border border-brand-blue/20 shadow-2xs">
            Our Services
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
            Services & Areas of Guidance
          </h2>
          <p class="mt-2 text-sm sm:text-base text-brand-muted max-w-[64ch]">
            From European university admissions and medical faculties to consular visitor visas, administrative work compliance, and flight coordination.
          </p>
        </div>
        <div class="mt-4 sm:mt-0">
          <a href="/services/" class="btn-outline text-xs inline-flex items-center gap-1.5 bg-white">
            <span>View All Services Directory</span>
            <span class="text-brand-blue">→</span>
          </a>
        </div>
      </div>

      <!-- 3-Column, 2-Row Photographic Service Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
        
        <!-- Card 1: Study Abroad -->
        <div class="card-premium relative group overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-lg hover:border-brand-navy hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer">
          <div>
            <div class="relative aspect-video w-full overflow-hidden bg-brand-bg border-b border-brand-border flex items-center justify-center">
              <img
                src="/assets/images/services/Study%20Abroad_%20Your%20Global%20Future.png"
                alt="Visa Convention Study Abroad — Your Global Future"
                width="1672"
                height="941"
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Study Abroad
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Undergraduate & postgraduate admissions across 35+ countries with guidance on transcripts, intakes, and student visa files.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/study-abroad/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors min-h-[44px] after:absolute after:inset-0 after:z-10 focus-visible:outline-2 focus-visible:outline-brand-blue focus-visible:outline-offset-2 rounded-xl"
            >
              <span>Explore Study Abroad</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 2: MBBS / PhD Abroad (Separately Accessible) -->
        <div class="card-premium relative group overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-lg hover:border-brand-navy hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer">
          <div>
            <div class="relative aspect-video w-full overflow-hidden bg-brand-bg border-b border-brand-border flex items-center justify-center">
              <img
                src="/assets/images/services/MBBS%20&%20PhD%20Courses%20Abroad.png"
                alt="Visa Convention MBBS and PhD Courses Abroad"
                width="1670"
                height="813"
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                <a
                  href="/services/mbbs/"
                  class="after:absolute after:inset-0 after:z-10 focus-visible:outline-2 focus-visible:outline-brand-blue focus-visible:outline-offset-2 rounded-xl"
                  aria-label="MBBS and PhD Courses Abroad Overview"
                >
                  MBBS / PhD Abroad
                </a>
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Recognized medical faculties in Europe & Central Asia, alongside doctoral research proposals and supervisor outreach.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60 flex items-center justify-between gap-3 relative z-20">
            <a
              href="/services/mbbs/"
              class="relative z-20 inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-brand-navy hover:text-brand-red transition-colors min-h-[44px] focus-visible:ring-2 focus-visible:ring-brand-blue rounded-lg px-1"
            >
              <span>MBBS Abroad</span>
              <span class="text-brand-red">→</span>
            </a>
            <span class="text-brand-border font-light select-none" aria-hidden="true">|</span>
            <a
              href="/services/phd/"
              class="relative z-20 inline-flex items-center gap-1 text-xs sm:text-sm font-bold text-brand-navy hover:text-brand-red transition-colors min-h-[44px] focus-visible:ring-2 focus-visible:ring-brand-blue rounded-lg px-1"
            >
              <span>PhD Abroad</span>
              <span class="text-brand-red">→</span>
            </a>
          </div>
        </div>

        <!-- Card 3: Work Visa -->
        <div class="card-premium relative group overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-lg hover:border-brand-navy hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer">
          <div>
            <div class="relative aspect-video w-full overflow-hidden bg-brand-bg border-b border-brand-border flex items-center justify-center">
              <img
                src="/assets/images/services/Global%20Work%20Visa%20Opportunities.png"
                alt="Visa Convention Global Work Visa Opportunities"
                width="1672"
                height="828"
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Work Visa
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Administrative documentation compliance and contract vetting for 14 destinations across Europe, the Gulf, and Asia-Pacific.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/work-visa/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors min-h-[44px] after:absolute after:inset-0 after:z-10 focus-visible:outline-2 focus-visible:outline-brand-blue focus-visible:outline-offset-2 rounded-xl"
            >
              <span>Work Visa Assistance</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 4: Tourist Visa -->
        <div class="card-premium relative group overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-lg hover:border-brand-navy hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer">
          <div>
            <div class="relative aspect-video w-full overflow-hidden bg-brand-bg border-b border-brand-border flex items-center justify-center">
              <img
                src="/assets/images/services/Vibrant%20Tourist%20Visa%20Travel%20Poster.png"
                alt="Visa Convention Tourist Visa Travel Guidance"
                width="1672"
                height="835"
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Tourist Visa
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Consular file compilation across 27 destinations, tailored documentation by applicant profile, and legitimate booking holds.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/tourist-visa/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors min-h-[44px] after:absolute after:inset-0 after:z-10 focus-visible:outline-2 focus-visible:outline-brand-blue focus-visible:outline-offset-2 rounded-xl"
            >
              <span>Tourist Visa Assistance</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 5: Flight Booking -->
        <div class="card-premium relative group overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-lg hover:border-brand-navy hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer">
          <div>
            <div class="relative aspect-video w-full overflow-hidden bg-brand-bg border-b border-brand-border flex items-center justify-center">
              <img
                src="/assets/images/services/Flight%20Booking%20and%20Dummy%20Tickets.png"
                alt="Visa Convention Flight Booking and Reservation Assistance"
                width="1672"
                height="788"
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Flight Booking
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Genuine GDS airline hold itineraries for visa dossiers, 40kg–46kg student baggage fares, and confirmed e-tickets.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/flight-booking/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors min-h-[44px] after:absolute after:inset-0 after:z-10 focus-visible:outline-2 focus-visible:outline-brand-blue focus-visible:outline-offset-2 rounded-xl"
            >
              <span>Request Flight Assistance</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 6: Additional Services -->
        <div class="card-premium relative group overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-lg hover:border-brand-navy hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer">
          <div>
            <div class="relative aspect-video w-full overflow-hidden bg-brand-bg border-b border-brand-border flex items-center justify-center">
              <img
                src="/assets/images/services/Additional%20Visa%20Services%20Guide.png"
                alt="Visa Convention Additional Services Guide — Passport Applications, MEA Apostille, PCC, and Documentation Assistance"
                width="1672"
                height="941"
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Additional Services
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Passport applications, document attestation, PCC, translations, and other documentation assistance.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/additional-services/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors min-h-[44px] after:absolute after:inset-0 after:z-10 focus-visible:outline-2 focus-visible:outline-brand-blue focus-visible:outline-offset-2 rounded-xl"
            >
              <span>Explore Additional Services</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: ANIMATED CLIENT REVIEWS CAROUSEL -->
  <!-- ========================================================================= -->
  <ReviewsCarousel />
</BaseLayout>

