---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import CountryCard from '../components/countries/CountryCard.astro';
import ConsultationCTA from '../components/common/ConsultationCTA.astro';
import { getFeaturedCountries } from '../data/countries';
import { siteConfig } from '../data/site-config';

// Priority Destinations (6 featured countries with verified destination photographs)
const priorityCountries = getFeaturedCountries().slice(0, 6);
---

<BaseLayout
  title="Visa Convention — Study Abroad, Visa & Travel Services | Hanumangarh"
  description="Explore universities abroad, learn about our visa services, and speak directly with the Visa Convention counseling team in Hanumangarh, Rajasthan."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO (TWO-COLUMN WITH INTERNATIONAL LANDMARKS VISUAL) -->
  <!-- ========================================================================= -->
  <HeroSection
    eyebrow="Hanumangarh, Rajasthan"
    headline="Study Abroad, Visa & Travel Services"
    subheadline="Explore international study destinations, visa assistance and travel services with Visa Convention."
    primaryCtaText="Explore Services"
    primaryCtaHref="#services"
    secondaryCtaText="Contact Us"
    secondaryCtaHref="/contact/"
    imageSrc="/assets/images/hero-landmarks.jpg"
    imageAlt="World iconic landmarks including the Statue of Liberty, Big Ben, Eiffel Tower, and Sydney Opera House"
  />

  <!-- ========================================================================= -->
  <!-- SECTION 2: SIX CORE SERVICE CATEGORIES (3x2 PHOTOGRAPHIC DISCOVERY GRID) -->
  <!-- ========================================================================= -->
  <section id="services" class="py-12 sm:py-16 bg-white border-b border-brand-border">
    <div class="site-container">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 text-left">
        <div>
          <span class="inline-block px-3.5 py-1 mb-2.5 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
            Comprehensive Offerings
          </span>
          <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
            Explore Our Services
          </h2>
          <p class="mt-2 text-sm sm:text-base text-brand-muted max-w-[64ch]">
            From university admissions and medical faculties to consular visitor visas, administrative work compliance, and flight coordination.
          </p>
        </div>
        <div class="mt-4 sm:mt-0">
          <a href="/services/" class="btn-outline text-xs inline-flex items-center gap-1.5">
            <span>View All Services Directory</span>
            <span class="text-brand-blue">→</span>
          </a>
        </div>
      </div>

      <!-- 3-Column, 2-Row Photographic Service Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
        
        <!-- Card 1: Study Visa -->
        <div class="card-premium overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy transition-all duration-200 flex flex-col justify-between group text-left">
          <div>
            <div class="relative h-40 sm:h-44 w-full overflow-hidden bg-brand-bg border-b border-brand-border">
              <img
                src="/assets/images/services/service-study-visa.jpg"
                alt="Students walking on an international university campus"
                width="600"
                height="340"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md bg-brand-navy/90 text-white backdrop-blur-xs border border-white/20">
                Study Abroad
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Study Visa
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Undergraduate & postgraduate admissions across 35+ countries with guidance on transcripts, intakes, and student visa files.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/study-visa/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
            >
              <span>Explore Study Visa</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 2: MBBS / PhD Abroad -->
        <div class="card-premium overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy transition-all duration-200 flex flex-col justify-between group text-left">
          <div>
            <div class="relative h-40 sm:h-44 w-full overflow-hidden bg-brand-bg border-b border-brand-border">
              <img
                src="/assets/images/mbbs-education.jpg"
                alt="International medical students training in university clinical laboratory"
                width="600"
                height="340"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md bg-brand-red/90 text-white backdrop-blur-xs border border-white/20">
                Medical & Doctoral
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                MBBS / PhD Abroad
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Recognized medical faculties in Europe & Central Asia, alongside doctoral research proposals and supervisor outreach.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/mbbs/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
            >
              <span>Explore Programmes</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 3: Tourist Visa -->
        <div class="card-premium overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy transition-all duration-200 flex flex-col justify-between group text-left">
          <div>
            <div class="relative h-40 sm:h-44 w-full overflow-hidden bg-brand-bg border-b border-brand-border">
              <img
                src="/assets/images/services/service-tourist-visa.jpg"
                alt="Travelers exploring a scenic international destination with travel luggage"
                width="600"
                height="340"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md bg-brand-navy/90 text-white backdrop-blur-xs border border-white/20">
                Visitor Visas
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Tourist Visa
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Consular file compilation across 27 destinations, tailored documentation by applicant profile, and legitimate booking holds.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/tourist-visa/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
            >
              <span>Tourist Visa Assistance</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 4: Work Visa -->
        <div class="card-premium overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy transition-all duration-200 flex flex-col justify-between group text-left">
          <div>
            <div class="relative h-40 sm:h-44 w-full overflow-hidden bg-brand-bg border-b border-brand-border">
              <img
                src="/assets/images/services/service-work-visa.jpg"
                alt="Skilled technical and engineering professionals in a modern workplace"
                width="600"
                height="340"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md bg-brand-navy/90 text-white backdrop-blur-xs border border-white/20">
                Administrative Compliance
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Work Visa
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Administrative documentation compliance and contract vetting for 14 destinations across Europe, the Gulf, and Asia-Pacific.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/work-visa/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
            >
              <span>Work Visa Assistance</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 5: Flight Booking -->
        <div class="card-premium overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy transition-all duration-200 flex flex-col justify-between group text-left">
          <div>
            <div class="relative h-40 sm:h-44 w-full overflow-hidden bg-brand-bg border-b border-brand-border">
              <img
                src="/assets/images/flight-hero-aviation.jpg"
                alt="Commercial passenger jet soaring through sunset golden-hour clouds"
                width="600"
                height="340"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md bg-brand-blue/90 text-white backdrop-blur-xs border border-white/20">
                Aviation Desk
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Flight Booking
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Genuine GDS airline hold itineraries for visa dossiers, 40kg–46kg student baggage fares, and confirmed e-tickets.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/services/flight-booking/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
            >
              <span>Request Flight Assistance</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Card 6: Explore Universities -->
        <div class="card-premium overflow-hidden rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy transition-all duration-200 flex flex-col justify-between group text-left">
          <div>
            <div class="relative h-40 sm:h-44 w-full overflow-hidden bg-brand-bg border-b border-brand-border">
              <img
                src="/assets/images/services/service-universities.jpg"
                alt="Prestigious university campus architecture and academic halls"
                width="600"
                height="340"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wider rounded-md bg-brand-navy/90 text-white backdrop-blur-xs border border-white/20">
                Institution Search
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
                Explore Universities
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
                Search over 1,000+ higher education institutions across North America, the UK, Europe, Australia, and Asia.
              </p>
            </div>
          </div>
          <div class="px-6 pb-6 pt-2 mt-auto border-t border-brand-border/60">
            <a
              href="/universities/"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
            >
              <span>Find Universities</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: FEATURED STUDY DESTINATIONS & UNIVERSITY SHORTCUT -->
  <!-- ========================================================================= -->
  <section class="py-12 sm:py-16 bg-brand-bg border-y border-brand-border">
    <div class="site-container">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 text-left">
        <div>
          <span class="badge-pill mb-2.5">
            Study Abroad
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
            Featured Study Destinations
          </h2>
          <p class="mt-1.5 text-sm sm:text-base text-brand-muted max-w-[62ch]">
            Compare admissions, living environments, and academic faculties across premier global destinations.
          </p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-3">
          <a href="/study-abroad/" class="btn-outline text-xs bg-white">
            <span>Explore All 35+ Destinations</span>
          </a>
        </div>
      </div>

      <!-- 6 Priority Destinations Grid (Balanced 3x2 grid) -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch mb-8">
        {priorityCountries.map((country) => (
          <CountryCard country={country} />
        ))}
      </div>

      <!-- University Directory Shortcut Banner -->
      <div class="bg-white rounded-2xl p-6 sm:p-7 border border-brand-border shadow-2xs flex flex-col md:flex-row items-center justify-between gap-4 text-left">
        <div class="space-y-1">
          <h3 class="text-base sm:text-lg font-bold text-brand-navy">
            Looking for a specific university?
          </h3>
          <p class="text-xs sm:text-sm text-brand-muted max-w-xl">
            Search our comprehensive directory of 1,000+ accredited institutions across North America, the UK, Europe, Australia, and Asia.
          </p>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
          <a href="/universities/" class="btn-primary w-full md:w-auto text-center text-xs py-3 px-6">
            <span>Find Universities</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 4: ABOUT VISA CONVENTION -->
  <!-- ========================================================================= -->
  <section class="py-10 sm:py-14 site-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <div class="lg:col-span-7 space-y-4 text-left">
        <span class="badge-pill">About Visa Convention</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
          Advising Students & Travelers from Hanumangarh
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed font-normal">
          Based in Hanumangarh, Rajasthan, Visa Convention provides structured guidance for international university admissions, student visas, visitor itineraries, and flight reservations.
        </p>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed font-normal">
          We conduct careful document audits, explain host-nation immigration requirements clearly, and assist with legitimate applications without misleading promises.
        </p>
        <div class="pt-2">
          <a href="/about/" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-brand-navy hover:text-brand-red transition-colors">
            <span>Read More About Our Team & Ethics</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-brand-bg rounded-2xl p-6 border border-brand-border space-y-3.5 text-left">
          <h3 class="text-base font-bold text-brand-navy">Consultation Center</h3>
          <p class="text-xs text-brand-muted leading-relaxed font-normal">
            {siteConfig.officeAddress}
          </p>
          <div class="text-xs text-brand-navy space-y-1.5 pt-2 border-t border-brand-border/80">
            <p><strong>Hours:</strong> {siteConfig.businessHours}</p>
            <p><strong>Phone:</strong> <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="text-brand-blue font-bold hover:underline">{siteConfig.phone}</a></p>
            <p><strong>Email:</strong> <a href={`mailto:${siteConfig.email}`} class="text-brand-blue font-bold hover:underline">{siteConfig.email}</a></p>
          </div>
          <div class="pt-2">
            <a href="/contact/" class="btn-primary w-full text-center text-xs py-2.5">
              <span>Request Consultation</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 5: THREE-STEP GUIDANCE PROCESS -->
  <!-- ========================================================================= -->
  <section class="py-10 sm:py-14 bg-white border-y border-brand-border">
    <div class="site-container">
      <SectionHeading
        title="Our Simple Process"
        description="Three client-guided steps designed to simplify admissions, documentation, and departure."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6 items-stretch">
        <!-- Step 1 -->
        <div class="card-premium p-6 rounded-2xl text-left relative group flex flex-col justify-between h-full">
          <div>
            <div class="w-8 h-8 rounded-lg bg-brand-navy text-white flex items-center justify-center font-bold text-sm mb-3.5">
              1
            </div>
            <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2 leading-snug">Profile Evaluation & Options</h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
              We review your academic background, test scores, and career goals to identify matching courses and destination countries.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="card-premium p-6 rounded-2xl text-left relative group flex flex-col justify-between h-full">
          <div>
            <div class="w-8 h-8 rounded-lg bg-brand-navy text-white flex items-center justify-center font-bold text-sm mb-3.5">
              2
            </div>
            <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2 leading-snug">Documentation & Applications</h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
              We help organize your Statement of Purpose, coordinate university submissions, and track conditional or unconditional offers.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="card-premium p-6 rounded-2xl text-left relative group flex flex-col justify-between h-full">
          <div>
            <div class="w-8 h-8 rounded-lg bg-brand-navy text-white flex items-center justify-center font-bold text-sm mb-3.5">
              3
            </div>
            <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2 leading-snug">Visa Filing & Travel Preparation</h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
              We audit financial records, organize embassy forms, conduct interview preparation, and arrange legitimate flight reservations.
            </p>
          </div>
        </div>
      </div>
      
      <p class="mt-6 text-center text-xs text-brand-muted">
        Independent advisory. Visa issuance decisions remain under the sole prerogative of sovereign embassies and consulates.
      </p>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 6: FINAL CONSULTATION CTA -->
  <!-- ========================================================================= -->
  <div class="site-container py-10 sm:py-14">
    <ConsultationCTA
      title="Ready to Plan Your Next Step?"
      subtitle="Speak directly with our counseling team in Hanumangarh or submit an initial assessment request online."
      primaryBtnText="Request Consultation"
      primaryBtnHref="/contact/"
      secondaryBtnText="Explore Study Countries"
      secondaryBtnHref="/study-abroad/"
    />
  </div>
</BaseLayout>
