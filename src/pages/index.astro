---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import CountryCard from '../components/countries/CountryCard.astro';
import ConsultationCTA from '../components/common/ConsultationCTA.astro';
import { getFeaturedCountries } from '../data/countries';
import { siteConfig } from '../data/site-config';

// Priority Destinations (3 by default for balanced 3-column desktop layout)
const priorityCountries = getFeaturedCountries().slice(0, 3);
---

<BaseLayout
  title="Visa Convention — Study Abroad, Visa & Travel Services | Hanumangarh"
  description="Explore universities abroad, learn about our visa services, and speak directly with the Visa Convention counseling team in Hanumangarh, Rajasthan."
>
  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO (TWO-COLUMN WITH AUTHENTIC EDUCATIONAL VISUAL) -->
  <!-- ========================================================================= -->
  <HeroSection
    eyebrow="VISA CONVENTION · HANUMANGARH"
    headline="Your Plans Abroad Start Here."
    subheadline="Explore study destinations, find universities, and get assistance with visas and travel."
    primaryCtaText="Explore Services"
    primaryCtaHref="#services"
    secondaryCtaText="Contact Our Team"
    secondaryCtaHref="/contact/"
    imageSrc="/assets/images/hero-education.jpg"
    imageAlt="Students studying at an international university campus"
  />

  <!-- ========================================================================= -->
  <!-- SECTION 2: THREE MAIN SERVICE PATHWAYS (HOW CAN WE HELP YOU?) -->
  <!-- ========================================================================= -->
  <section id="services" class="py-12 sm:py-16 max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      title="How Can We Help You?"
      description="Three primary pathways for study abroad aspirants, visa applicants, and travelers."
    />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      <!-- Card 1: Study Abroad -->
      <div class="card-premium p-7 sm:p-8 rounded-2xl flex flex-col justify-between h-full group hover:border-brand-navy hover:shadow-md transition-all text-left">
        <div>
          <div class="w-12 h-12 rounded-xl bg-brand-bg text-brand-navy border border-brand-border flex items-center justify-center text-xl mb-5 group-hover:bg-brand-navy group-hover:text-white transition-colors">
            🎓
          </div>
          <h3 class="text-xl font-bold text-brand-navy mb-2.5">
            Study Abroad
          </h3>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal mb-5">
            Comprehensive university exploration, admissions counseling, MBBS faculties, and doctoral research guidance across 35+ countries.
          </p>
          <div class="space-y-2 mb-6 text-xs text-brand-text">
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>Study Visa & Admissions</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>MBBS & PhD Programs</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>35+ Countries & 1,000+ Universities</span>
            </div>
          </div>
        </div>
        <div class="pt-4 border-t border-brand-border mt-auto">
          <a
            href="/study-abroad/"
            class="btn-primary w-full text-center text-xs py-3"
          >
            <span>Explore Study Abroad</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Card 2: Visa Services -->
      <div class="card-premium p-7 sm:p-8 rounded-2xl flex flex-col justify-between h-full group hover:border-brand-navy hover:shadow-md transition-all text-left">
        <div>
          <div class="w-12 h-12 rounded-xl bg-brand-bg text-brand-navy border border-brand-border flex items-center justify-center text-xl mb-5 group-hover:bg-brand-navy group-hover:text-white transition-colors">
            🛂
          </div>
          <h3 class="text-xl font-bold text-brand-navy mb-2.5">
            Visa Services
          </h3>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal mb-5">
            Structured documentation support, file audits, visitor itineraries, and work permit application preparation with sovereign consular compliance.
          </p>
          <div class="space-y-2 mb-6 text-xs text-brand-text">
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>Tourist & Visitor Visas</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>Work Visa Support</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>Consular Document Audits</span>
            </div>
          </div>
        </div>
        <div class="pt-4 border-t border-brand-border mt-auto">
          <a
            href="/services/"
            class="btn-primary w-full text-center text-xs py-3"
          >
            <span>View Visa Services</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Card 3: Flight Booking -->
      <div class="card-premium p-7 sm:p-8 rounded-2xl flex flex-col justify-between h-full group hover:border-brand-navy hover:shadow-md transition-all text-left">
        <div>
          <div class="w-12 h-12 rounded-xl bg-brand-bg text-brand-navy border border-brand-border flex items-center justify-center text-xl mb-5 group-hover:bg-brand-navy group-hover:text-white transition-colors">
            ✈️
          </div>
          <h3 class="text-xl font-bold text-brand-navy mb-2.5">
            Flight Booking
          </h3>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal mb-5">
            Airline flight reservations, legitimate carrier itinerary holds for visa filing, and student baggage allowance assistance.
          </p>
          <div class="space-y-2 mb-6 text-xs text-brand-text">
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>Legitimate Flight Tickets</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>Carrier Itinerary Holds</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-brand-red font-bold">✓</span>
              <span>Student Baggage Guidance</span>
            </div>
          </div>
        </div>
        <div class="pt-4 border-t border-brand-border mt-auto">
          <a
            href="/services/flight-booking/"
            class="btn-primary w-full text-center text-xs py-3"
          >
            <span>Enquire About Flights</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center">
      <a
        href="/services/"
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-bold text-brand-navy hover:text-brand-red transition-colors"
      >
        <span>View all service specifications & advisory tracks</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: FEATURED STUDY DESTINATIONS & UNIVERSITY SHORTCUT -->
  <!-- ========================================================================= -->
  <section class="py-12 sm:py-16 bg-white border-y border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 text-left">
        <div>
          <span class="badge-pill mb-3">
            Study Abroad
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
            Featured Study Destinations
          </h2>
          <p class="mt-2 text-sm sm:text-base text-brand-muted max-w-[62ch]">
            Compare admissions, living environments, and academic faculties across premier global destinations.
          </p>
        </div>
        <div class="mt-4 sm:mt-0 flex flex-wrap gap-3">
          <a href="/study-abroad/" class="btn-outline text-xs">
            <span>Explore All 35+ Destinations</span>
          </a>
        </div>
      </div>

      <!-- 3 Priority Destinations Grid (Equal 3-column row) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch mb-8">
        {priorityCountries.map((country) => (
          <CountryCard country={country} />
        ))}
      </div>

      <!-- University Directory Shortcut Banner -->
      <div class="bg-brand-bg rounded-2xl p-6 sm:p-7 border border-brand-border flex flex-col md:flex-row items-center justify-between gap-5 text-left">
        <div class="space-y-1">
          <h3 class="text-base sm:text-lg font-bold text-brand-navy">
            Looking for a specific university?
          </h3>
          <p class="text-xs sm:text-sm text-brand-muted max-w-xl">
            Search our comprehensive directory of 1,000+ accredited institutions across North America, the UK, Europe, Australia, and Asia.
          </p>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto shrink-0">
          <a href="/universities/" class="btn-primary w-full md:w-auto text-center text-xs py-2.5 px-5">
            <span>Find Universities</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 4: ABOUT VISA CONVENTION -->
  <!-- ========================================================================= -->
  <section class="py-12 sm:py-16 max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <div class="lg:col-span-7 space-y-4 text-left">
        <span class="badge-pill">About Visa Convention</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
          Advising Students & Travelers from Hanumangarh
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed font-normal">
          Based in Hanumangarh, Rajasthan, Visa Convention provides structured guidance for international university admissions, student visas, visitor itineraries, and flight reservations.
        </p>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed font-normal">
          We conduct careful document audits, explain host-nation immigration requirements clearly, and assist with legitimate applications without misleading promises.
        </p>
        <div class="pt-2">
          <a href="/about/" class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-navy hover:text-brand-red transition-colors">
            <span>Read More About Our Team & Ethics</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="bg-brand-bg rounded-3xl p-6 sm:p-7 border border-brand-border space-y-4 text-left">
          <h3 class="text-base font-bold text-brand-navy">Consultation Center</h3>
          <p class="text-xs text-brand-muted leading-relaxed font-normal">
            {siteConfig.officeAddress}
          </p>
          <div class="text-xs text-brand-navy space-y-1.5 pt-2 border-t border-brand-border/80">
            <p><strong>Hours:</strong> {siteConfig.businessHours}</p>
            <p><strong>Phone:</strong> <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="text-brand-blue font-bold hover:underline">{siteConfig.phone}</a></p>
            <p><strong>Email:</strong> <a href={`mailto:${siteConfig.email}`} class="text-brand-blue font-bold hover:underline">{siteConfig.email}</a></p>
          </div>
          <div class="pt-2">
            <a href="/contact/" class="btn-primary w-full text-center text-xs">
              <span>Request Consultation</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 5: THREE-STEP GUIDANCE PROCESS -->
  <!-- ========================================================================= -->
  <section class="py-12 sm:py-16 bg-white border-y border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        title="Our Simple Process"
        description="Three client-guided steps designed to simplify admissions, documentation, and departure."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
        <!-- Step 1 -->
        <div class="card-premium p-7 sm:p-8 text-left relative group flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-navy text-white flex items-center justify-center font-bold text-base mb-5">
              1
            </div>
            <h3 class="text-lg font-bold text-brand-navy mb-2.5 leading-snug">Profile Evaluation & Options</h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
              We review your academic background, test scores, and career goals to identify matching courses and destination countries.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="card-premium p-7 sm:p-8 text-left relative group flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-navy text-white flex items-center justify-center font-bold text-base mb-5">
              2
            </div>
            <h3 class="text-lg font-bold text-brand-navy mb-2.5 leading-snug">Documentation & Applications</h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
              We help organize your Statement of Purpose, coordinate university submissions, and track conditional or unconditional offers.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="card-premium p-7 sm:p-8 text-left relative group flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-xl bg-brand-navy text-white flex items-center justify-center font-bold text-base mb-5">
              3
            </div>
            <h3 class="text-lg font-bold text-brand-navy mb-2.5 leading-snug">Visa Filing & Travel Preparation</h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
              We audit financial records, organize embassy forms, conduct interview preparation, and arrange legitimate flight reservations.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 6: FINAL CONSULTATION CTA -->
  <!-- ========================================================================= -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <ConsultationCTA
      title="Ready to Plan Your Next Step?"
      subtitle="Speak directly with our counseling team in Hanumangarh or submit an initial assessment request online."
      primaryBtnText="Request Consultation"
      primaryBtnHref="/contact/"
      secondaryBtnText="Explore Study Countries"
      secondaryBtnHref="/study-abroad/"
    />
  </div>
</BaseLayout>
