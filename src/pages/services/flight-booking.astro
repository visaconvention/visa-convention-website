---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import FAQAccordion from '../../components/common/FAQAccordion.astro';
import FlightEnquiryForm from '../../components/forms/FlightEnquiryForm.astro';
import { getFaqSchema } from '../../utils/seo';
import { siteConfig } from '../../data/site-config';

// SEO Metadata
const pageTitle = 'Flight Booking & Reservation Assistance — Visa Convention';
const pageDescription = 'Share your travel plans with Visa Convention. Our team can review your request and explain the available ticketing and reservation options.';

// FAQs tailored specifically to flight booking, reservations, and consular requirements
const flightFaqs = [
  {
    question: 'What is the difference between a flight reservation and a confirmed ticket?',
    answer: 'A confirmed ticket is a fully paid, issued electronic airline ticket with live e-ticket numbers. A flight reservation (or hold) is an active temporary booking generated through licensed Global Distribution Systems (GDS) with a valid PNR, held for visa application purposes without paying the complete airfare upfront. An itinerary is a proposed schedule illustrating flight timings and transit routes.',
  },
  {
    question: 'Why do embassies advise against purchasing confirmed tickets before visa approval?',
    answer: 'Sovereign immigration authorities (including the U.S. Department of State, UKVI, and Schengen consulates) explicitly recommend that applicants avoid purchasing non-refundable air tickets before receiving their visa vignette. Instead, embassies accept verifiable flight reservations or round-trip itineraries demonstrating travel intent.',
  },
  {
    question: 'Does Visa Convention provide dummy tickets or fake PNR numbers?',
    answer: 'NEVER. Creating, distributing, or submitting fake flight tickets or fabricated PNR codes is fraudulent, illegal, and will lead to immediate visa refusal and potential travel bans. Visa Convention facilitates only legitimate, authorized reservation holds through accredited airline distribution systems.',
  },
  {
    question: 'How do international students obtain extra baggage allowances (40kg–46kg)?',
    answer: 'Major international airlines (such as British Airways, Air India, Emirates, Qatar Airways, and Lufthansa) offer special student tariff codes. When booking with an official university offer letter and student visa, students receive expanded baggage allowances of 40kg to 46kg (typically 2 checked pieces of 23kg each) at standard economy prices.',
  },
  {
    question: 'What happens if my visa processing is delayed after holding a reservation?',
    answer: 'Temporary airline reservation holds have carrier-mandated time limits (typically 24 to 72 hours, depending on airline fare rules and departure proximity). If visa processing extends beyond the hold window, our travel desk can refresh the reservation or update travel dates to reflect your adjusted departure schedule.',
  },
  {
    question: 'What are the cancellation and date change policies for confirmed tickets?',
    answer: 'All ticket cancellations, date changes, and refunds are governed strictly by the operating airline fare rules. Visa Convention charges zero hidden agency penalties and passes through carrier refund schedules transparently.',
  },
];

const faqSchema = getFaqSchema(flightFaqs);

// Service comparison points
const serviceComparison = [
  {
    type: 'Confirmed Flight Ticket',
    purpose: 'Post-visa grant or visa-free travel',
    status: 'Fully paid & issued',
    pnrType: 'Live, ticketed e-ticket',
    bestFor: 'Travelers with approved visas ready to fly',
  },
  {
    type: 'Flight Reservation Hold',
    purpose: 'Visa application dossier evidence',
    status: 'Temporary GDS airline hold',
    pnrType: 'Verifiable airline booking code',
    bestFor: 'Visa applicants fulfilling consular travel evidence',
  },
  {
    type: 'Travel Itinerary Assistance',
    purpose: 'Trip planning & transit scheduling',
    status: 'Proposed routing schedule',
    pnrType: 'Illustrative travel plan',
    bestFor: 'Vacation planners and preliminary schedule review',
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={faqSchema}
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'Flight Booking & Reservations', href: '/services/flight-booking/', current: true },
      ]}
    />
  </div>

  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO (TWO-COLUMN WITH AVIATION PHOTOGRAPHY) -->
  <!-- ========================================================================= -->
  <section class="py-10 sm:py-14 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Headline & Advisory Scope -->
        <div class="lg:col-span-7 text-left">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block px-3 py-1 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
              Aviation & Travel Coordination
            </span>
            <span class="hidden sm:inline-block text-xs font-semibold text-brand-muted">
              • Verified Airline Hold Desks
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4 text-balance">
            Flight Booking & Reservation Assistance
          </h1>

          <p class="text-base sm:text-lg text-brand-muted leading-relaxed mb-6 font-normal max-w-[62ch]">
            Share your travel plans with Visa Convention. Our team can review your request and explain the available ticketing and reservation options.
          </p>

          <!-- Key Guarantees Bar -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-8">
            <div class="p-3.5 rounded-xl bg-white border border-brand-border shadow-2xs">
              <span class="block text-xs font-bold text-brand-navy mb-0.5">Verifiable Holds</span>
              <span class="block text-[11px] text-brand-muted">Legitimate GDS reservation codes for embassy dossiers</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white border border-brand-border shadow-2xs">
              <span class="block text-xs font-bold text-brand-navy mb-0.5">Student Baggage</span>
              <span class="block text-[11px] text-brand-muted">40kg–46kg student tariff code coordination</span>
            </div>
            <div class="p-3.5 rounded-xl bg-white border border-brand-border shadow-2xs">
              <span class="block text-xs font-bold text-brand-navy mb-0.5">Zero Fake PNRs</span>
              <span class="block text-[11px] text-brand-muted">Strict compliance with foreign consulate advisories</span>
            </div>
          </div>

          <!-- Hero Action CTAs -->
          <div class="flex flex-wrap items-center gap-4">
            <a href="#flight-enquiry-section" class="btn-primary inline-flex items-center gap-2">
              <span>Request Flight Assistance</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a href="#service-differences" class="btn-secondary inline-flex items-center gap-2">
              <span>Compare Tickets vs. Holds</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Premium Aviation Photography Visual -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-[4/3] sm:aspect-[16/11]">
            <img
              src="/assets/images/flight-hero-aviation.jpg"
              alt="Commercial passenger jetliner wing soaring above sunset clouds"
              width="1536"
              height="1024"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/60 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute bottom-4 left-4 right-4 text-white text-left pointer-events-none">
              <span class="inline-block px-2.5 py-0.5 rounded bg-brand-navy/80 text-[10px] font-bold uppercase tracking-wider mb-1 backdrop-blur-xs">
                Global Travel Corridors
              </span>
              <p class="text-xs sm:text-sm font-semibold leading-tight text-white/95">
                Connecting Hanumangarh travelers to North America, UK, Europe, Australia & the Gulf.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: SERVICE PATHWAYS DIFFERENTIATION PANEL (CLARITY OVER HYPE) -->
  <!-- ========================================================================= -->
  <section id="service-differences" class="py-12 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <div class="max-w-3xl mb-8">
        <span class="inline-block px-3 py-1 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-navy border border-brand-border mb-3">
          Travel Service Clarity
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Understanding Flight Tickets vs. Reservation Holds
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          A proposed travel itinerary, a genuine temporary flight reservation, and an issued confirmed flight ticket are not interchangeable. Learn which option fits your immigration stage.
        </p>
      </div>

      <!-- 3 Service Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <!-- Option 1: Confirmed Ticket -->
        <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-2xs hover:border-brand-navy/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md bg-emerald-100 text-emerald-900 border border-emerald-200">
                Post-Visa Approval
              </span>
              <span class="text-xs font-bold text-brand-muted">Option 01</span>
            </div>
            <h3 class="text-lg font-bold text-brand-navy mb-2">
              Confirmed Flight Ticket
            </h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-4">
              A fully paid, issued electronic airline ticket with live e-ticket numbers (e.g. 13-digit carrier ticket numbers).
            </p>
            <ul class="space-y-2 text-xs text-brand-navy/90 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Includes student baggage codes (40kg–46kg)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Seat assignments and special meal requests</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-emerald-600 font-bold">✓</span>
                <span>Subject to airline cancellation / date-change tariffs</span>
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-brand-border/70 text-xs font-semibold text-brand-muted">
            Recommended when your visa is approved.
          </div>
        </div>

        <!-- Option 2: Flight Reservation Hold -->
        <div class="p-6 rounded-2xl bg-blue-50/30 border border-brand-blue/30 shadow-2xs hover:border-brand-blue transition-all flex flex-col justify-between ring-1 ring-brand-blue/20">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md bg-brand-bg text-brand-blue border border-brand-blue/30">
                Visa Application Dossier
              </span>
              <span class="text-xs font-bold text-brand-blue">Option 02</span>
            </div>
            <h3 class="text-lg font-bold text-brand-navy mb-2">
              Flight Reservation Hold
            </h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-4">
              A genuine, verifiable temporary airline reservation generated through Global Distribution Systems (GDS) with an active booking code (PNR).
            </p>
            <ul class="space-y-2 text-xs text-brand-navy/90 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-brand-blue font-bold">✓</span>
                <span>Fulfills embassy round-trip proof requirements</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-blue font-bold">✓</span>
                <span>Avoids risking full airfare before visa outcome</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-blue font-bold">✓</span>
                <span>Subject strictly to carrier hold validity rules</span>
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-brand-border/70 text-xs font-semibold text-brand-blue">
            Recommended during visa application filing.
          </div>
        </div>

        <!-- Option 3: Travel Itinerary Assistance -->
        <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-2xs hover:border-brand-navy/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-md bg-brand-bg text-brand-navy border border-brand-border">
                Route Planning
              </span>
              <span class="text-xs font-bold text-brand-muted">Option 03</span>
            </div>
            <h3 class="text-lg font-bold text-brand-navy mb-2">
              Travel Itinerary Assistance
            </h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-4">
              A detailed proposed route schedule mapping connection times, airport terminal transfers, and layover visa prerequisites.
            </p>
            <ul class="space-y-2 text-xs text-brand-navy/90 mb-6">
              <li class="flex items-start gap-2">
                <span class="text-brand-navy font-bold">✓</span>
                <span>Optimal transit corridors (avoiding complex transit visas)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-navy font-bold">✓</span>
                <span>Flight timing and stopover comparison</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-navy font-bold">✓</span>
                <span>Scheduling blueprint for tourist cover letters</span>
              </li>
            </ul>
          </div>
          <div class="pt-4 border-t border-brand-border/70 text-xs font-semibold text-brand-muted">
            Recommended for vacation & budget planning.
          </div>
        </div>
      </div>

      <!-- Statutory Consular Integrity Notice -->
      <div class="p-5 rounded-2xl bg-amber-50/70 border border-amber-200 text-xs text-amber-950 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <div>
            <span class="font-bold block text-sm mb-0.5">Consular Advisory & Document Integrity Policy</span>
            <p class="text-xs leading-relaxed text-amber-900">
              The U.S. Department of State, UKVI, and European consulates explicitly recommend that visa applicants do not purchase non-refundable tickets prior to visa issuance. Visa Convention strictly refuses to create or distribute fake tickets, invented PNRs, or fabricated boarding passes. All reservations provided are legitimate, verifiable airline hold bookings.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: INTERACTIVE ENQUIRY FORM & SUPPORTING GUIDANCE (65% / 35%) -->
  <!-- ========================================================================= -->
  <section id="flight-enquiry-section" class="py-12 sm:py-16 bg-brand-bg/50">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <!-- Left: Dedicated Flight Enquiry Form (approx. 65% width) -->
        <div class="lg:col-span-8">
          <FlightEnquiryForm />
        </div>

        <!-- Right: Supporting Information & Practical Desk Rules (approx. 35% width) -->
        <div class="lg:col-span-4 space-y-6 text-left">
          <!-- Card 1: 4-Step Process -->
          <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-2xs">
            <div class="flex items-center gap-2 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-brand-navy"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">How We Coordinate</span>
            </div>
            <h3 class="text-base font-bold text-brand-navy mb-4">
              4-Step Travel Desk Workflow
            </h3>
            <ol class="space-y-4 text-xs text-brand-muted">
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-bg text-brand-navy font-bold flex items-center justify-center shrink-0 border border-brand-border text-[11px]">
                  01
                </span>
                <div>
                  <span class="font-bold text-brand-navy block">Submit Your Route</span>
                  <span>Share departure, destination, intended travel dates, and passenger profile.</span>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-bg text-brand-navy font-bold flex items-center justify-center shrink-0 border border-brand-border text-[11px]">
                  02
                </span>
                <div>
                  <span class="font-bold text-brand-navy block">Carrier & Fare Comparison</span>
                  <span>Our desk checks major global carriers for optimal student tariffs and luggage rules.</span>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-bg text-brand-navy font-bold flex items-center justify-center shrink-0 border border-brand-border text-[11px]">
                  03
                </span>
                <div>
                  <span class="font-bold text-brand-navy block">Transparent Option Briefing</span>
                  <span>We share verified schedules via WhatsApp or email with exact layovers and fare conditions.</span>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="w-6 h-6 rounded-full bg-brand-bg text-brand-navy font-bold flex items-center justify-center shrink-0 border border-brand-border text-[11px]">
                  04
                </span>
                <div>
                  <span class="font-bold text-brand-navy block">GDS Hold or E-Ticket</span>
                  <span>Receive your legitimate airline reservation hold receipt or confirmed e-ticket.</span>
                </div>
              </li>
            </ol>
          </div>

          <!-- Card 2: Student Baggage Optimization -->
          <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-2xs">
            <span class="inline-block px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider rounded bg-brand-bg text-brand-blue border border-brand-blue/20 mb-2">
              Student Privilege
            </span>
            <h3 class="text-base font-bold text-brand-navy mb-2">
              40kg–46kg Student Baggage
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed mb-3">
              Standard economy tickets restrict check-in baggage to 23kg (1 bag). By booking under accredited student tariff codes using your university offer letter and student visa, students receive:
            </p>
            <div class="space-y-1.5 text-xs text-brand-navy font-medium mb-3">
              <div class="flex items-center gap-1.5">
                <span class="text-brand-blue">✓</span>
                <span>2 pieces of 23kg each (46kg total) on transatlantic carriers</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-brand-blue">✓</span>
                <span>40kg total allowance on Gulf & European routes</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="text-brand-blue">✓</span>
                <span>Zero excess luggage penalty charges at airport check-in</span>
              </div>
            </div>
            <p class="text-[11px] text-brand-subtle italic">
              Applies to Air India, British Airways, Emirates, Qatar Airways, Lufthansa & Virgin Atlantic.
            </p>
          </div>

          <!-- Card 3: Fare Rules & Cancellation Policy -->
          <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-2xs">
            <h3 class="text-base font-bold text-brand-navy mb-2">
              Fair Pricing & Tariff Transparency
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed mb-3">
              All airline cancellations, schedule revisions, and refund amounts are governed strictly by the operating carrier's published fare rules:
            </p>
            <ul class="space-y-2 text-xs text-brand-muted">
              <li class="flex items-start gap-2">
                <span class="text-brand-navy font-bold">•</span>
                <span><strong>Carrier Tariffs:</strong> Cancellation charges are deducted directly by the airline based on fare class (refundable vs non-refundable).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-navy font-bold">•</span>
                <span><strong>No Hidden Agency Penalties:</strong> Visa Convention charges zero artificial cancellation fees.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-brand-navy font-bold">•</span>
                <span><strong>Hold Expirations:</strong> Reservation holds expire automatically without financial penalties if not converted to ticketed flights.</span>
              </li>
            </ul>
          </div>

          <!-- Card 4: Immediate Phone & WhatsApp Actions -->
          <div class="p-6 rounded-2xl bg-brand-navy text-white shadow-md text-left">
            <span class="text-[10px] font-bold uppercase tracking-wider text-brand-blue block mb-1">
              Direct Travel Desk
            </span>
            <h3 class="text-lg font-bold mb-2 text-white">
              Need Urgent Itinerary Advice?
            </h3>
            <p class="text-xs text-white/80 leading-relaxed mb-4">
              Speak with our senior travel coordinator in Hanumangarh for immediate flight schedules, student ticket codes, or reservation holds.
            </p>
            <div class="space-y-2.5">
              <a
                href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello Visa Convention Travel Desk, I need assistance with an international flight booking or reservation hold.')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-primary w-full text-xs py-3 bg-brand-red hover:bg-brand-red/90 text-white flex items-center justify-center gap-2"
              >
                <span>WhatsApp Travel Coordinator</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a
                href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
                class="w-full text-xs py-3 px-4 rounded-xl border border-white/20 text-white hover:bg-white/10 flex items-center justify-center gap-2 font-bold transition-all"
              >
                <span>Call {siteConfig.phone}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 4: FREQUENTLY ASKED QUESTIONS (FAQ ACCORDION) -->
  <!-- ========================================================================= -->
  <section class="py-12 sm:py-16 bg-white border-t border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-left">
      <div class="max-w-3xl mb-8">
        <span class="inline-block px-3.5 py-1 mb-2.5 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
          Travel Guidance & FAQs
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight mb-2">
          Frequently Asked Questions
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          Clear, transparent answers regarding flight reservation holds, student baggage codes, and consular requirements.
        </p>
      </div>

      <div class="max-w-3xl">
        <FAQAccordion faqs={flightFaqs} />
      </div>
    </div>
  </section>
</BaseLayout>
