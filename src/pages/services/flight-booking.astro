---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import FlightEnquiryForm from '../../components/forms/FlightEnquiryForm.astro';

// SEO Metadata
const pageTitle = 'Flight Booking & Reservation Assistance — Visa Convention';
const pageDescription = 'Share your travel plans with Visa Convention. Our team can review your request and explain the available ticketing and reservation options.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'Flight Booking & Reservations', href: '/services/flight-booking/', current: true },
      ]}
    />
  </div>

  <!-- ========================================================================= -->
  <!-- SECTION 1: HERO (TWO-COLUMN WITH AVIATION PHOTOGRAPHY) -->
  <!-- ========================================================================= -->
  <section class="py-10 sm:py-14 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left: Headline & Advisory Scope -->
        <div class="lg:col-span-7 text-left">
          <div class="flex items-center gap-2 mb-3">
            <span class="inline-block px-3 py-1 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
              Aviation & Travel Coordination
            </span>
            <span class="hidden sm:inline-block text-xs font-semibold text-brand-muted">
              • Verified Airline Hold Desks
            </span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4 text-balance">
            Flight Booking & Reservation Assistance
          </h1>

          <p class="text-base sm:text-lg text-brand-muted leading-relaxed mb-6 font-normal max-w-[62ch]">
            Share your travel plans with Visa Convention. Our team can review your request and explain the available ticketing and reservation options.
          </p>

          <!-- Hero Action CTAs -->
          <div class="flex flex-wrap items-center gap-4">
            <a href="#flight-enquiry-section" class="btn-primary inline-flex items-center gap-2">
              <span>Request Flight Assistance</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: Approved Client Flight Booking Visual -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video">
            <img
              src="/assets/images/services/Flight%20Booking%20and%20Dummy%20Tickets.png"
              alt="Visa Convention Flight Booking and Reservation Assistance"
              width="1672"
              height="941"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: DEDICATED FLIGHT ENQUIRY FORM (CENTERED PRIMARY FOCUS) -->
  <!-- ========================================================================= -->
  <section id="flight-enquiry-section" class="py-10 sm:py-14 bg-brand-bg/50 scroll-mt-24 sm:scroll-mt-28">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <FlightEnquiryForm />

      <!-- Concise Booking Terms & Consular Notice -->
      <p class="mt-6 text-center text-xs text-brand-muted max-w-2xl mx-auto leading-relaxed">
        <strong>Booking Terms & Consular Notice:</strong> Consular authorities (including the U.S. Department of State, UKVI, and European consulates) recommend holding verifiable flight reservations before visa issuance. Visa Convention strictly refuses to create or distribute fake tickets, invented PNRs, or fabricated boarding passes. All reservations are authentic airline holds.
      </p>
    </div>
  </section>


</BaseLayout>
