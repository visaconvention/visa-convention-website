---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import CountryCard from '../../components/countries/CountryCard.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import { touristDestinations } from '../../data/tourist-visa-data';

const pageTitle = 'Tourist & Visitor Visa Assistance — Visa Convention Hanumangarh';
const pageDescription = 'Documentation guidance for Schengen, UK, US, Canada, Australia, and UAE tourist visas. Verified itineraries, consular requirements, and biometric scheduling.';

// Format destination items with official flag paths for CountryCard
const destinations = touristDestinations.map((d) => ({
  ...d,
  flagSvg: `/assets/flags/${(d.flagCode || d.slug).toLowerCase()}.svg`,
}));

const groupCounts = {
  all: destinations.length,
  schengen: destinations.filter((d) => d.group === 'schengen').length,
  individual: destinations.filter((d) => d.group === 'individual').length,
  uae: destinations.filter((d) => d.group === 'uae').length,
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1240px] xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 page-header-gap pb-2 sm:pb-3">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'Tourist Visa', href: '/services/tourist-visa/', current: true },
      ]}
    />
  </div>

  <!-- Hero Section -->
  <section class="pt-3 sm:pt-4 lg:pt-5 pb-8 sm:pb-10 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1240px] xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-7 text-left">
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-3">
            Tourist Visa Assistance
          </h1>
          <p class="text-base sm:text-lg font-semibold text-brand-blue mb-3 leading-snug">
            Meticulous Documentation & Itinerary Planning for Global Leisure & Family Visits
          </p>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6 font-normal">
            Explore 27 global destinations, review documentation tailored to your travel plans, and request expert filing assistance. From Schengen holidays and UK family visits to US and Canadian visitor visas, we structure consular dossiers with zero ambiguity and strict evidentiary truth.
          </p>

          <!-- Streamlined Quick Jump Navigation -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <a
              href="#destinations"
              class="px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
              <span>Destinations ({destinations.length})</span>
            </a>
            <a
              href="#enquiry"
              class="btn-primary text-xs py-1.5 px-3.5 shadow-sm inline-flex items-center gap-1.5"
            >
              <span>Request Assessment</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video">
            <img
              src="/assets/images/services/Vibrant%20Tourist%20Visa%20Travel%20Poster.png"
              alt="Visa Convention Tourist Visa Travel Guidance"
              width="1672"
              height="941"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Two-Column Directory & Assessment Section -->
  <section class="py-8 sm:py-10 max-w-[1240px] xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 min-[1100px]:grid-cols-12 gap-5 lg:gap-6 items-start">
      <!-- Left Column (~70%): Choose Your Destination, Filters, Country Grid & Destination Info -->
      <div class="min-[1100px]:col-span-8 space-y-5" id="destinations">
        <!-- Section Header -->
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-1.5">
            Choose Your Destination
          </h2>
          <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
            Explore all {destinations.length} approved tourist destinations. Select a country to review consular requirements and automatically apply it to your assessment request.
          </p>
        </div>

        <!-- Search & Filter Controls -->
        <div class="space-y-3">
          <!-- Live Search Bar -->
          <div class="relative w-full">
            <label for="tourist-search-input" class="sr-only">Search destination country by name</label>
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-brand-muted">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              id="tourist-search-input"
              placeholder="Search destination country (e.g. Canada, Germany, UAE, UK)..."
              class="w-full pl-10 pr-4 py-2.5 sm:py-3 rounded-xl border border-brand-border bg-white text-sm text-brand-navy placeholder:text-brand-muted focus:outline-hidden focus:ring-2 focus:ring-brand-blue shadow-2xs transition-all"
            />
          </div>

          <!-- Group Filter Pills -->
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="tourist-group-filters">
            <button
              type="button"
              data-group="all"
              class="tourist-group-btn px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-brand-navy text-white shadow-2xs cursor-pointer"
            >
              All Destinations ({groupCounts.all})
            </button>
            <button
              type="button"
              data-group="schengen"
              class="tourist-group-btn px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy shadow-2xs cursor-pointer"
            >
              Schengen Area ({groupCounts.schengen})
            </button>
            <button
              type="button"
              data-group="individual"
              class="tourist-group-btn px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy shadow-2xs cursor-pointer"
            >
              Other International ({groupCounts.individual})
            </button>
            <button
              type="button"
              data-group="uae"
              class="tourist-group-btn px-3.5 py-1.5 rounded-full text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy shadow-2xs cursor-pointer"
            >
              United Arab Emirates ({groupCounts.uae})
            </button>
          </div>
        </div>

        <!-- Results Count Header -->
        <div class="flex items-center justify-between pb-2 border-b border-brand-border/70">
          <span class="text-xs text-brand-muted">
            Showing <strong id="tourist-visible-count" class="text-brand-navy">{destinations.length}</strong> destination(s)
          </span>
          <span class="text-[11px] text-brand-muted hidden sm:inline">
            Tap a tile to reveal consular requirements & apply to form
          </span>
        </div>

        <!-- Empty State Container -->
        <div id="tourist-empty-state" class="hidden my-4">
          <EmptyState
            title="No Tourist Destinations Found"
            description="No tourist destinations match your query. We provide documentation assistance for major destinations globally."
            actionLabel="Reset Search"
            actionHref="javascript:void(0)"
          />
        </div>

        <!-- Country Cards Grid (3-4 cards per row desktop, 3 tablet, 2 mobile) -->
        <div class="grid grid-cols-2 md:grid-cols-3 min-[1100px]:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-3 items-stretch" id="tourist-countries-grid">
          {destinations.map((dest) => (
            <div
              class="tourist-card-wrapper"
              data-name={dest.name.toLowerCase()}
              data-slug={dest.slug}
              data-group={dest.group}
            >
              <CountryCard
                as="button"
                country={{
                  name: dest.name,
                  slug: dest.slug,
                  flagSvg: dest.flagSvg,
                }}
                class="tourist-country-btn"
                dataAttrs={{
                  'data-dest-slug': dest.slug,
                  'data-dest-name': dest.name,
                  'data-dest-group': dest.group,
                }}
              />
            </div>
          ))}
        </div>

        <!-- Interactive Destination Details Panel (Revealed on click) -->
        <div id="tourist-details-panel" class="hidden mt-4 p-5 rounded-2xl bg-white border border-brand-border shadow-md">
          <div class="flex items-start justify-between gap-3 pb-3 mb-3 border-b border-brand-border/70">
            <div class="flex items-center gap-2.5 min-w-0">
              <img id="detail-flag" src="" alt="" class="w-8 h-5.5 rounded object-cover border border-slate-200" />
              <div>
                <h3 id="detail-title" class="text-base sm:text-lg font-bold text-brand-navy leading-snug"></h3>
                <span id="detail-group" class="inline-block text-[10px] font-bold uppercase tracking-wider text-brand-blue bg-blue-50 px-2 py-0.5 rounded border border-blue-100 mt-0.5"></span>
              </div>
            </div>
            <button
              type="button"
              id="close-details-btn"
              class="text-xs font-bold text-brand-muted hover:text-brand-navy p-1 px-2 rounded-lg border border-brand-border hover:bg-slate-50 transition-colors"
              aria-label="Close destination details"
            >
              ✕
            </button>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs mb-3.5">
            <div class="p-3 rounded-xl bg-brand-bg/50 border border-brand-border/60">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-navy mb-0.5">Visa Stream:</span>
              <span id="detail-stream" class="text-brand-navy font-semibold"></span>
            </div>
            <div class="p-3 rounded-xl bg-brand-bg/50 border border-brand-border/60">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-navy mb-0.5">Permitted Stay:</span>
              <span id="detail-stay" class="text-brand-navy font-semibold"></span>
            </div>
          </div>

          <div class="space-y-2 text-xs mb-4">
            <div>
              <strong class="block text-brand-navy font-bold mb-1">Key Consular Requirements:</strong>
              <p id="detail-requirements" class="text-brand-muted leading-relaxed"></p>
            </div>
            <div id="detail-notice-box" class="p-3 rounded-xl bg-amber-50/80 border border-amber-200 text-amber-900 leading-relaxed text-xs">
              <strong class="font-bold">Consular Notice:</strong> <span id="detail-notice"></span>
            </div>
          </div>

          <div class="pt-3 border-t border-brand-border/70 flex items-center justify-between flex-wrap gap-2">
            <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200 inline-flex items-center gap-1.5">
              <span>✓ Pre-selected in Consultation Form</span>
            </span>
            <a
              href="#enquiry"
              class="btn-primary text-xs py-2 px-4 shadow-2xs inline-flex items-center gap-1.5"
            >
              <span>Proceed to Assessment</span>
              <span>↓</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column (~30%): Compact Sticky Tourist Visa Assessment Form -->
      <aside class="min-[1100px]:col-span-4 w-full scroll-mt-24" id="enquiry">
        <div class="min-[1100px]:sticky min-[1100px]:top-24 space-y-4">
          <EnquiryForm
            selectedService="tourist-visa"
            title="Tourist Visa Assessment"
            subtitle=""
            singleColumn={true}
          />
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ destinations }}>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('tourist-search-input');
    const groupButtons = document.querySelectorAll('.tourist-group-btn');
    const cards = document.querySelectorAll('.tourist-card-wrapper');
    const visibleCountEl = document.getElementById('tourist-visible-count');
    const emptyState = document.getElementById('tourist-empty-state');
    const countriesGrid = document.getElementById('tourist-countries-grid');

    // Details Panel Elements
    const detailsPanel = document.getElementById('tourist-details-panel');
    const detailFlag = document.getElementById('detail-flag');
    const detailTitle = document.getElementById('detail-title');
    const detailGroup = document.getElementById('detail-group');
    const detailStream = document.getElementById('detail-stream');
    const detailStay = document.getElementById('detail-stay');
    const detailRequirements = document.getElementById('detail-requirements');
    const detailNoticeBox = document.getElementById('detail-notice-box');
    const detailNotice = document.getElementById('detail-notice');
    const closeDetailsBtn = document.getElementById('close-details-btn');

    const countrySelect = document.getElementById('form-country');
    const contextBanner = document.getElementById('enquiry-context-banner');
    const contextBannerText = document.getElementById('context-banner-text');

    let currentGroup = 'all';
    let currentQuery = '';

    function filterDestinations() {
      let count = 0;
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const group = card.getAttribute('data-group') || '';
        const matchesQuery = !currentQuery || name.includes(currentQuery);
        const matchesGroup = currentGroup === 'all' || group === currentGroup;

        if (matchesQuery && matchesGroup) {
          card.classList.remove('hidden');
          count++;
        } else {
          card.classList.add('hidden');
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = count;
      if (emptyState) emptyState.classList.toggle('hidden', count > 0);
      if (countriesGrid) countriesGrid.classList.toggle('hidden', count === 0);
    }

    // Search input listener
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentQuery = e.target.value.trim().toLowerCase();
        filterDestinations();
      });
    }

    // Group filter buttons listener
    groupButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        groupButtons.forEach((b) => {
          b.classList.remove('bg-brand-navy', 'text-white');
          b.classList.add('bg-white', 'text-brand-navy');
        });
        btn.classList.remove('bg-white', 'text-brand-navy');
        btn.classList.add('bg-brand-navy', 'text-white');

        currentGroup = btn.getAttribute('data-group') || 'all';
        filterDestinations();
      });
    });

    // Close details panel
    if (closeDetailsBtn) {
      closeDetailsBtn.addEventListener('click', () => {
        if (detailsPanel) detailsPanel.classList.add('hidden');
      });
    }

    // Country button click listener
    const countryButtons = document.querySelectorAll('.tourist-country-btn');
    countryButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-dest-slug');
        const dest = destinations.find((d) => d.slug === slug);
        if (!dest) return;

        // Populate details panel
        if (detailFlag) {
          detailFlag.src = dest.flagSvg;
          detailFlag.alt = `Flag of ${dest.name}`;
        }
        if (detailTitle) detailTitle.textContent = dest.name;
        if (detailGroup) {
          const groupLabels = {
            schengen: 'Schengen Area',
            individual: 'Other International',
            uae: 'United Arab Emirates',
          };
          detailGroup.textContent = groupLabels[dest.group] || dest.group.toUpperCase();
        }
        if (detailStream) detailStream.textContent = dest.visaStream || 'Tourist / Visitor Visa';
        if (detailStay) detailStay.textContent = dest.stayDuration || 'Per consular grant';
        if (detailRequirements) detailRequirements.textContent = dest.keyRequirementsOverview || 'Standard consular documentation required.';

        if (dest.highlightNotice) {
          if (detailNotice) detailNotice.textContent = dest.highlightNotice;
          if (detailNoticeBox) detailNoticeBox.classList.remove('hidden');
        } else {
          if (detailNoticeBox) detailNoticeBox.classList.add('hidden');
        }

        if (detailsPanel) {
          detailsPanel.classList.remove('hidden');
          detailsPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Sync with enquiry form
        if (countrySelect && dest.slug) {
          countrySelect.value = dest.slug;
          countrySelect.dispatchEvent(new Event('change', { bubbles: true }));
        }

        if (contextBanner && contextBannerText) {
          contextBannerText.textContent = `Enquiring for: TOURIST VISA • ${dest.name.toUpperCase()}`;
          contextBanner.classList.remove('hidden');
        }
      });
    });
  });
</script>
