---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import FAQAccordion from '../../components/common/FAQAccordion.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import DestinationAccordion, { type DestinationGroup } from '../../components/services/DestinationAccordion.astro';
import { 
  touristDestinations, 
  applicantCategories, 
  uaePreparationGuidance, 
  schengenFacts, 
  touristFaqs 
} from '../../data/tourist-visa-data';
import { getFaqSchema } from '../../utils/seo';

const pageTitle = 'Tourist & Visitor Visa Assistance — Visa Convention Hanumangarh';
const pageDescription = 'Documentation guidance for Schengen, UK, US, Canada, Australia, and UAE tourist visas. 6 applicant categories, verified itineraries, and biometric scheduling.';

const faqSchema = getFaqSchema(touristFaqs);

// Destination groups according to specifications: Schengen, Other International, and UAE
const destinationGroups: DestinationGroup[] = [
  {
    id: 'schengen',
    name: 'Schengen Area',
    count: touristDestinations.filter(d => d.group === 'schengen').length,
    items: touristDestinations
      .filter(d => d.group === 'schengen')
      .map(d => ({
        id: d.id,
        name: d.name,
        slug: d.slug,
        streamOrAuthorityLabel: 'Visa Stream',
        streamOrAuthorityValue: d.visaStream,
        secondaryLabel: 'Permitted Stay',
        secondaryValue: d.stayDuration,
        overview: d.keyRequirementsOverview,
        notice: d.highlightNotice,
      })),
  },
  {
    id: 'individual',
    name: 'Other International',
    count: touristDestinations.filter(d => d.group === 'individual').length,
    items: touristDestinations
      .filter(d => d.group === 'individual')
      .map(d => ({
        id: d.id,
        name: d.name,
        slug: d.slug,
        streamOrAuthorityLabel: 'Visa Stream',
        streamOrAuthorityValue: d.visaStream,
        secondaryLabel: 'Permitted Stay',
        secondaryValue: d.stayDuration,
        overview: d.keyRequirementsOverview,
        notice: d.highlightNotice,
      })),
  },
  {
    id: 'uae',
    name: 'United Arab Emirates',
    count: touristDestinations.filter(d => d.group === 'uae').length,
    items: touristDestinations
      .filter(d => d.group === 'uae')
      .map(d => ({
        id: d.id,
        name: d.name,
        slug: d.slug,
        streamOrAuthorityLabel: 'Visa Stream',
        streamOrAuthorityValue: d.visaStream,
        secondaryLabel: 'Permitted Stay',
        secondaryValue: d.stayDuration,
        overview: d.keyRequirementsOverview,
        notice: d.highlightNotice,
      })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={faqSchema}
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'Tourist Visa', href: '/services/tourist-visa/', current: true },
      ]}
    />
  </div>

  <!-- Hero Section (Preserving original client poster image) -->
  <section class="py-10 sm:py-14 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-7 text-left">
          <span class="inline-block px-3 py-1 mb-3 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
            Tourist & Visitor Visa Advisory
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-3">
            Tourist Visa Assistance
          </h1>
          <p class="text-base sm:text-lg font-semibold text-brand-blue mb-3 leading-snug">
            Meticulous Documentation & Itinerary Planning for Global Leisure & Family Visits
          </p>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6 font-normal">
            Explore 27 global destinations, review documentation tailored to your socioeconomic profile, and request expert filing assistance. From Schengen holidays and UK family visits to US and Canadian visitor visas, we structure consular dossiers with zero ambiguity and strict evidentiary truth.
          </p>

          <!-- Streamlined Quick Jump Navigation -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <a
              href="#destinations"
              class="px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
              <span>Destinations (27)</span>
            </a>
            <a
              href="#applicant-categories"
              class="px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-brand-red"></span>
              <span>Applicant Profile</span>
            </a>
            <a
              href="#specific-guidance"
              class="px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <span>Special Frameworks</span>
            </a>
            <a
              href="#enquiry"
              class="btn-primary text-xs py-1.5 px-3.5 shadow-sm inline-flex items-center gap-1.5"
            >
              <span>Request Assessment</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video">
            <img
              src="/assets/images/services/Vibrant%20Tourist%20Visa%20Travel%20Poster.png"
              alt="Visa Convention Tourist Visa Travel Guidance"
              width="1672"
              height="941"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 01: Choose Your Destination (Compact Searchable Accordion) -->
  <section id="destinations" class="py-10 sm:py-14 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Choose Your Destination
        </h2>
        <p class="text-sm text-brand-muted leading-relaxed">
          Explore all 27 approved tourist destinations. Select a country to review consular requirements and automatically apply it to your assessment request.
        </p>
      </div>

      <!-- Reusable Compact Destination Accordion -->
      <DestinationAccordion
        groups={destinationGroups}
        serviceType="tourist"
        searchPlaceholder="Search destination country (e.g. Canada, Germany, UAE, UK)..."
        searchInputId="destination-search-input"
      />

      <!-- Consular Note -->
      <div class="mt-6 p-3.5 rounded-xl bg-blue-50/60 border border-blue-100 text-xs text-brand-muted leading-relaxed">
        <strong>Schengen Zone Information:</strong> Visa Convention lists 16 primary Schengen destinations based on typical applicant demand. The Schengen Area comprises 29 European states operating under a unified visa code. A visa issued by any member state permits travel throughout the entire zone within authorized validity.
      </div>
    </div>
  </section>

  <!-- SECTION 02: Applicant Category Guidance (Compact Checklist) -->
  <section id="applicant-categories" class="py-10 sm:py-14 bg-brand-bg/60 border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Applicant Category Guidance
        </h2>
        <p class="text-sm text-brand-muted leading-relaxed">
          Select your primary occupation or status in India. The checklist updates immediately and automatically pre-fills your enquiry below.
        </p>
      </div>

      <!-- Compact Category Tab Selector -->
      <div
        class="flex flex-wrap items-center gap-2 mb-6"
        role="tablist"
        aria-label="Applicant Categories"
        id="tourist-category-tabs"
      >
        {applicantCategories.map((cat, idx) => (
          <button
            type="button"
            class={`category-tab-btn min-h-[42px] px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold border transition-all ${
              idx === 0
                ? 'bg-brand-navy text-white border-brand-navy shadow-2xs'
                : 'bg-white text-brand-navy border-brand-border hover:border-brand-navy'
            }`}
            data-category-id={cat.id}
            data-category-label={cat.shortLabel}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`category-panel-${cat.id}`}
          >
            {cat.shortLabel}
          </button>
        ))}
      </div>

      <!-- Category Panels Container -->
      <div id="category-panels-container">
        {applicantCategories.map((cat, idx) => (
          <div
            id={`category-panel-${cat.id}`}
            class={`category-panel bg-white rounded-2xl p-5 sm:p-7 border border-brand-border shadow-2xs ${idx === 0 ? '' : 'hidden'}`}
            role="tabpanel"
            aria-labelledby={`tab-${cat.id}`}
          >
            <div class="mb-5 pb-4 border-b border-brand-border/70 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-brand-navy">
                  {cat.title}
                </h3>
                <p class="text-xs text-brand-muted mt-0.5">
                  {cat.description}
                </p>
              </div>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200 self-start sm:self-auto">
                <svg class="w-3.5 h-3.5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Applied to Form</span>
              </span>
            </div>

            <!-- Concise Document Checklist Rows (Desktop 2-column, Mobile 1-column) -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-3">
              {cat.documentGuidance.map((doc) => (
                <div class="flex items-start gap-2.5 py-1.5">
                  <span class="w-5 h-5 rounded-full bg-brand-bg text-brand-blue flex items-center justify-center font-bold text-xs flex-shrink-0 mt-0.5 border border-brand-blue/20">
                    ✓
                  </span>
                  <div class="min-w-0">
                    <h4 class="text-sm font-semibold text-brand-navy leading-snug">
                      {doc.title}
                    </h4>
                    <p class="text-xs text-brand-muted leading-relaxed mt-0.5">
                      {doc.detail}
                    </p>
                    {doc.conditionalNotice && (
                      <p class="text-[11px] text-brand-subtle mt-0.5">
                        <span class="font-medium text-brand-navy">Note:</span> {doc.conditionalNotice}
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>

            <!-- Official Consistency Note -->
            {cat.officialNote && (
              <div class="mt-5 p-3 rounded-xl bg-amber-50/70 border border-amber-200/80 text-xs text-amber-900 leading-relaxed flex items-start gap-2">
                <svg class="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <div>
                  <strong>Consular Consistency:</strong> {cat.officialNote}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>

      <!-- Single Mandatory Clarification (Displayed once) -->
      <p class="text-xs text-brand-muted text-center mt-5">
        Document requirements vary by destination and applicant circumstances. Additional documents may be required.
      </p>
    </div>
  </section>

  <!-- SECTION 03: Special Destination Frameworks (Collapsed Dropdowns) -->
  <section id="specific-guidance" class="py-10 sm:py-14 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Special Destination Frameworks
        </h2>
        <p class="text-sm text-brand-muted leading-relaxed">
          Specific statutory frameworks apply to UAE electronic permits and Schengen Area visitor visas. Expand below for verified consular guidelines.
        </p>
      </div>

      <!-- Two Collapsed Dropdowns (Mutual Exclusion: Opening one closes the other) -->
      <div class="space-y-3 max-w-4xl" id="special-frameworks-accordion">
        <!-- Dropdown 1: UAE Tourist Visa Requirements -->
        <div class="rounded-2xl border border-brand-border bg-white overflow-hidden shadow-2xs">
          <button
            type="button"
            class="framework-toggle w-full min-h-[52px] px-4 sm:px-5 py-3.5 bg-brand-bg/50 hover:bg-brand-bg text-left flex items-center justify-between gap-3 transition-colors focus-visible:outline-2 focus-visible:outline-brand-blue"
            aria-expanded="false"
            aria-controls="framework-panel-uae"
            data-target="framework-panel-uae"
          >
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="text-sm sm:text-base font-bold text-brand-navy">
                UAE Tourist Visa Requirements
              </span>
            </div>
            <svg
              class="framework-chevron w-4 h-4 text-brand-navy transition-transform duration-200 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div id="framework-panel-uae" class="framework-panel hidden px-4 sm:px-6 py-5 bg-white border-t border-brand-border/60">
            <h3 class="text-sm sm:text-base font-bold text-brand-navy mb-2">
              {uaePreparationGuidance.headline}
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed mb-4">
              {uaePreparationGuidance.overview}
            </p>

            <h4 class="text-xs font-bold uppercase tracking-wider text-brand-navy mb-2.5">
              Client Preparation Checklist:
            </h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-4">
              {uaePreparationGuidance.documents.map((item) => (
                <div class="p-2.5 rounded-xl bg-brand-bg/50 border border-brand-border/70 text-xs flex items-start gap-2">
                  <span class="text-emerald-600 font-bold">✓</span>
                  <div>
                    <span class="font-bold text-brand-navy">{item.name}:</span>{' '}
                    <span class="text-brand-muted">{item.note}</span>
                  </div>
                </div>
              ))}
            </div>

            <div class="text-[11px] text-brand-subtle bg-amber-50/70 p-3 rounded-xl border border-amber-200/70 leading-relaxed">
              <strong>Advisory Notice:</strong> {uaePreparationGuidance.regulatoryNotice}
            </div>
          </div>
        </div>

        <!-- Dropdown 2: Schengen Visa Requirements -->
        <div class="rounded-2xl border border-brand-border bg-white overflow-hidden shadow-2xs">
          <button
            type="button"
            class="framework-toggle w-full min-h-[52px] px-4 sm:px-5 py-3.5 bg-brand-bg/50 hover:bg-brand-bg text-left flex items-center justify-between gap-3 transition-colors focus-visible:outline-2 focus-visible:outline-brand-blue"
            aria-expanded="false"
            aria-controls="framework-panel-schengen"
            data-target="framework-panel-schengen"
          >
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-brand-blue"></span>
              <span class="text-sm sm:text-base font-bold text-brand-navy">
                Schengen Visa Requirements
              </span>
            </div>
            <svg
              class="framework-chevron w-4 h-4 text-brand-navy transition-transform duration-200 flex-shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div id="framework-panel-schengen" class="framework-panel hidden px-4 sm:px-6 py-5 bg-white border-t border-brand-border/60">
            <h3 class="text-sm sm:text-base font-bold text-brand-navy mb-2">
              {schengenFacts.coverageTitle}
            </h3>

            <div class="space-y-2.5 text-xs text-brand-muted leading-relaxed mb-4">
              <div class="p-3 rounded-xl bg-brand-bg/50 border border-brand-border/70">
                <h4 class="font-bold text-brand-navy mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
                  Mandatory €30,000 Travel Medical Insurance
                </h4>
                <p>{schengenFacts.insuranceRule}</p>
              </div>

              <div class="p-3 rounded-xl bg-brand-bg/50 border border-brand-border/70">
                <h4 class="font-bold text-brand-navy mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-brand-red"></span>
                  Certified Bank Statement Periods
                </h4>
                <p>{schengenFacts.evidenceRule}</p>
              </div>

              <div class="p-3 rounded-xl bg-brand-bg/50 border border-brand-border/70">
                <h4 class="font-bold text-brand-navy mb-1 flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                  29-Nation Zone Freedom of Movement
                </h4>
                <p>{schengenFacts.coverageCount}</p>
              </div>
            </div>

            <div class="text-[11px] text-brand-subtle bg-slate-50 p-3 rounded-xl border border-brand-border leading-relaxed">
              <strong>Statutory Rule:</strong> Visa Convention facilitates diligent documentation under official consular rules. We never manufacture false employment records, bogus tax filings, or unverified reservations.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 04: Combined FAQs & Consultation Assessment Section -->
  <section class="py-10 sm:py-16 bg-brand-bg/60 border-t border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 2-Column Responsive Grid (Below 900px: Stacked. 900px+: 2 Balanced Columns with 24-32px gap, aligned at top) -->
      <div class="grid grid-cols-1 min-[900px]:grid-cols-2 gap-6 lg:gap-8 items-start">
        
        <!-- Left Column: Frequently Asked Questions (DOM Order 1: Appears first on mobile) -->
        <div id="faq" class="w-full scroll-mt-6">
          <div class="mb-5 sm:mb-6">
            <span class="inline-block px-3 py-1 mb-2 text-xs font-bold tracking-wider uppercase rounded-full bg-white text-brand-blue border border-brand-blue/20">
              Questions & Clarity
            </span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
              Frequently Asked Questions
            </h2>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
              Essential consular and documentation guidance for tourist and visitor visa applicants.
            </p>
          </div>

          <FAQAccordion faqs={touristFaqs} allCollapsed={true} class="w-full" />
        </div>

        <!-- Right Column: Consultation Assessment Form (DOM Order 2: Appears second on mobile) -->
        <div id="enquiry" class="w-full scroll-mt-6">
          <EnquiryForm
            selectedService="tourist-visa"
            title="Tourist Visa Assessment"
            subtitle="Confidential file evaluation for tourist and family visitor visas."
          />
        </div>

      </div>

      <!-- Statutory Advisory Disclaimer Banner (Preserved Essential Legal Notice) -->
      <div class="mt-8 p-4 rounded-xl bg-slate-50 border border-brand-border text-xs text-brand-muted leading-relaxed text-center">
        <strong class="text-brand-navy font-bold">Statutory Note:</strong> Visa issuance authority rests solely with the destination government's consular officers. Visa Convention provides professional administrative and documentation assistance without fraudulent claims or artificial approvals.
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Tourist Visa Page Client Interactions
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Category Tab Switcher & Automatic Form Autofill
    const categoryBtns = document.querySelectorAll('.category-tab-btn');
    const categoryPanels = document.querySelectorAll('.category-panel');
    const messageField = document.getElementById('form-message') as HTMLTextAreaElement | null;
    const contextBanner = document.getElementById('enquiry-context-banner');
    const contextBannerText = document.getElementById('context-banner-text');
    const countrySelect = document.getElementById('form-country') as HTMLSelectElement | null;

    function applyCategorySelection(categoryId: string, categoryLabel: string) {
      // Toggle Tab Active State
      categoryBtns.forEach((b) => {
        const isMatch = b.getAttribute('data-category-id') === categoryId;
        b.classList.toggle('bg-brand-navy', isMatch);
        b.classList.toggle('text-white', isMatch);
        b.classList.toggle('border-brand-navy', isMatch);
        b.classList.toggle('shadow-2xs', isMatch);
        b.classList.toggle('bg-white', !isMatch);
        b.classList.toggle('text-brand-navy', !isMatch);
        b.classList.toggle('border-brand-border', !isMatch);
        b.setAttribute('aria-selected', String(isMatch));
      });

      // Toggle Panel
      categoryPanels.forEach((panel) => {
        const panelEl = panel as HTMLElement;
        panelEl.classList.toggle('hidden', panelEl.id !== `category-panel-${categoryId}`);
      });

      // Automatically Populate Enquiry Form Message
      if (messageField && categoryLabel) {
        const prefix = `[Tourist Visa Profile: ${categoryLabel}] `;
        if (!messageField.value.includes(prefix)) {
          messageField.value = prefix + messageField.value.replace(/\[Tourist Visa Profile:.*?\]\s*/g, '');
        }
      }

      // Update Context Banner
      if (contextBanner && contextBannerText) {
        const countryVal = countrySelect && countrySelect.value ? countrySelect.value.toUpperCase() : '';
        const parts = ['TOURIST VISA'];
        if (countryVal) parts.push(countryVal);
        parts.push(categoryLabel.toUpperCase());
        contextBannerText.textContent = `Enquiring for: ${parts.join(' • ')}`;
        contextBanner.classList.remove('hidden');
      }
    }

    categoryBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const catId = btn.getAttribute('data-category-id') || 'employed';
        const catLabel = btn.getAttribute('data-category-label') || 'Employed';
        applyCategorySelection(catId, catLabel);
      });
    });

    // 2. Special Destination Frameworks Dropdown Accordion (Mutual Exclusion)
    const frameworkToggles = document.querySelectorAll('.framework-toggle');
    frameworkToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        const targetId = toggle.getAttribute('data-target');
        const targetPanel = targetId ? document.getElementById(targetId) : null;
        const chevron = toggle.querySelector('.framework-chevron');
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        // Close all framework panels first (mutual exclusion)
        frameworkToggles.forEach((otherToggle) => {
          const otherTargetId = otherToggle.getAttribute('data-target');
          const otherPanel = otherTargetId ? document.getElementById(otherTargetId) : null;
          const otherChevron = otherToggle.querySelector('.framework-chevron');

          otherToggle.setAttribute('aria-expanded', 'false');
          if (otherPanel) otherPanel.classList.add('hidden');
          if (otherChevron) otherChevron.classList.remove('rotate-180');
        });

        // If it was not expanded before, expand it now
        if (!isExpanded && targetPanel) {
          toggle.setAttribute('aria-expanded', 'true');
          targetPanel.classList.remove('hidden');
          if (chevron) chevron.classList.add('rotate-180');
        }
      });
    });
  });
</script>
