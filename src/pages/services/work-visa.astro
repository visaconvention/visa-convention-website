---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import FAQAccordion from '../../components/common/FAQAccordion.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import { 
  statutoryWorkDisclaimer,
  workDestinations,
  occupationalCategories,
  employmentEvaluationFactors,
  workVisaAssistanceScope,
  workFaqs 
} from '../../data/work-visa-data';
import { getFaqSchema } from '../../utils/seo';

const pageTitle = 'Work Visa & Permit Documentation Guidance — Visa Convention';
const pageDescription = 'Regulatory visa documentation guidance for candidates holding verified foreign job offers. Gulf and European permit paperwork, PCC, and credential evaluations.';

const faqSchema = getFaqSchema(workFaqs);
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={faqSchema}
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'Work Visa', href: '/services/work-visa/', current: true },
      ]}
    />
  </div>

  <!-- Hero Section -->
  <section class="py-12 sm:py-16 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl text-left">
        <span class="inline-block px-3.5 py-1 mb-4 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
          Work Permit Compliance & Procedural Advisory
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4">
          Work Visa Assistance
        </h1>
        <p class="text-lg sm:text-xl font-semibold text-brand-blue mb-4 leading-snug">
          Administrative Documentation & Regulatory Compliance for Sponsored Foreign Employment
        </p>
        <p class="text-base sm:text-lg text-brand-muted leading-relaxed mb-8">
          Explore destination options and request guidance about work authorization and documentation. Visa Convention provides meticulous paperwork support, educational credential evaluation guidance, and consular petition preparation for skilled workers, tradespeople, and technicians holding verified foreign employment offers.
        </p>

        <!-- Quick Navigation Jump Pill Row -->
        <div class="flex flex-wrap items-center gap-2.5 pt-2">
          <a
            href="#destinations"
            class="px-3.5 py-2 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
            <span>01 Destinations (14)</span>
          </a>
          <a
            href="#occupations"
            class="px-3.5 py-2 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-brand-red"></span>
            <span>02 Occupational Areas</span>
          </a>
          <a
            href="#contract-factors"
            class="px-3.5 py-2 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            <span>03 Contract Checklist</span>
          </a>
          <a
            href="#how-we-assist"
            class="px-3.5 py-2 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span>04 Our Scope</span>
          </a>
          <a
            href="#enquiry"
            class="btn-primary text-xs py-2 px-4 shadow-sm inline-flex items-center gap-1.5"
          >
            <span>Verify Eligibility</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- STATUTORY REGULATORY DISCLOSURE BANNER (Crucial Legal Guardrail) -->
  <section class="py-8 bg-amber-50/80 border-b border-amber-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 rounded-2xl bg-white border border-amber-300 shadow-2xs">
        <div class="flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-xl bg-amber-100 text-amber-900 flex items-center justify-center font-extrabold text-sm flex-shrink-0 mt-0.5">
            ⚠️
          </div>
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-amber-900 block mb-1">
              {statutoryWorkDisclaimer.title}
            </span>
            <p class="text-xs sm:text-sm font-bold text-brand-navy mb-2">
              {statutoryWorkDisclaimer.notice}
            </p>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-brand-muted mb-3">
              {statutoryWorkDisclaimer.rules.map((rule) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-amber-700 font-bold">•</span>
                  <span>{rule}</span>
                </li>
              ))}
            </ul>
            <div class="text-[11px] text-amber-800 font-semibold border-t border-amber-100 pt-2 flex items-center justify-between flex-wrap gap-2">
              <span>Statutory Compliance: {statutoryWorkDisclaimer.lawReference}</span>
              <span>Advisory Service Only · Zero Placement Commissions</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 01: Explore Work Visa Destinations -->
  <section id="destinations" class="py-14 sm:py-18 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-8">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-blue"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Step 01</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight mb-3">
          Explore Work Visa Destinations
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          The client poster identifies 14 distinct countries across the Gulf, Europe, and global regions. Select any destination to review regulatory requirements and apply it to your assessment.
        </p>
      </div>

      <!-- Regional Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 mb-8" role="tablist" aria-label="Work Visa Regions">
        <button
          type="button"
          class="work-region-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-brand-navy text-white shadow-2xs"
          data-region="all"
        >
          All Destinations ({workDestinations.length})
        </button>
        <button
          type="button"
          class="work-region-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy"
          data-region="Gulf"
        >
          Gulf Cooperation Council (5)
        </button>
        <button
          type="button"
          class="work-region-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy"
          data-region="Europe"
        >
          European Union (7)
        </button>
        <button
          type="button"
          class="work-region-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy"
          data-region="Other"
        >
          Other Global (2)
        </button>
      </div>

      <!-- Destinations Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {workDestinations.map((dest) => (
          <div
            class="work-dest-card p-5 rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-blue/50 transition-all flex flex-col justify-between"
            data-region={dest.region}
            data-slug={dest.slug}
          >
            <div>
              <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2.5">
                  <span class="w-8 h-8 rounded-lg bg-brand-bg text-brand-navy flex items-center justify-center font-extrabold text-xs border border-brand-border shadow-2xs">
                    {dest.flagCode}
                  </span>
                  <div>
                    <h3 class="text-lg font-bold text-brand-navy leading-tight">{dest.country}</h3>
                    {dest.locations && (
                      <span class="text-[11px] text-brand-blue font-semibold block">
                        {dest.locations.join(' · ')}
                      </span>
                    )}
                    {!dest.locations && (
                      <span class="text-[11px] text-brand-subtle block">
                        {dest.region} Work Authorization
                      </span>
                    )}
                  </div>
                </div>

                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-brand-bg text-brand-navy border border-brand-border">
                  {dest.region}
                </span>
              </div>

              <div class="space-y-2 text-xs text-brand-muted mb-4">
                <div>
                  <span class="font-bold text-brand-navy block text-[11px]">Sponsoring Authority:</span>
                  <span class="text-brand-navy text-[11px]">{dest.permitAuthority}</span>
                </div>
                <div>
                  <span class="font-bold text-brand-navy block text-[11px]">Advisory Pathway:</span>
                  <p class="text-[11px] leading-relaxed text-brand-subtle">{dest.advisoryNote}</p>
                </div>
              </div>
            </div>

            <div class="pt-3 border-t border-brand-border/60">
              <button
                type="button"
                class="select-work-dest-btn w-full py-2 px-3 rounded-xl bg-brand-bg hover:bg-brand-navy hover:text-white text-xs font-bold text-brand-navy transition-colors text-center"
                data-slug={dest.slug}
                data-country={dest.country}
              >
                Select & Apply to Form ↓
              </button>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 p-4 rounded-xl bg-blue-50/50 border border-blue-100 text-xs text-brand-muted leading-relaxed">
        <strong>Single UAE Country Entry:</strong> Dubai and Abu Dhabi are emirates of the United Arab Emirates, governed under the federal MOHRE and respective residency authorities (GDRFA Dubai / ICP Abu Dhabi). They are grouped under one national country entry with specific emirate routing.
      </div>
    </div>
  </section>

  <!-- SECTION 02: Occupational Categories (Work Categories / Areas) -->
  <section id="occupations" class="py-14 sm:py-18 bg-brand-bg/60 border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-8">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-red"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Step 02</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight mb-2">
          Occupational Focus Areas
        </h2>
        <span class="inline-block px-3 py-1 mb-3 text-xs font-bold tracking-wider uppercase rounded-md bg-amber-100 text-amber-900 border border-amber-200">
          Occupational Categories — Not Live Job Vacancies
        </span>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          The client poster outlines 12 trade and skilled work categories. Visa Convention provides documentation and credential assistance for candidates with proven experience in these areas who hold authorized employer sponsorship.
        </p>
      </div>

      <!-- Sector Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 mb-8" role="tablist" aria-label="Occupational Sectors">
        <button
          type="button"
          class="work-sector-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-brand-navy text-white shadow-2xs"
          data-sector="all"
        >
          All Categories ({occupationalCategories.length})
        </button>
        <button
          type="button"
          class="work-sector-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy"
          data-sector="Trades & Construction"
        >
          Trades & Construction (7)
        </button>
        <button
          type="button"
          class="work-sector-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy"
          data-sector="Logistics & Warehousing"
        >
          Logistics & Transport (2)
        </button>
        <button
          type="button"
          class="work-sector-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy"
          data-sector="Technical & Equipment"
        >
          Technical & Equipment (2)
        </button>
        <button
          type="button"
          class="work-sector-btn px-3 py-1.5 rounded-lg text-xs font-bold transition-all bg-white border border-brand-border text-brand-navy hover:border-brand-navy"
          data-sector="Security & Facilities"
        >
          Security & Facilities (1)
        </button>
      </div>

      <!-- Occupational Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {occupationalCategories.map((occ) => (
          <div
            class="occupation-card p-5 rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-blue/50 transition-all flex flex-col justify-between"
            data-sector={occ.sector}
            data-occ-id={occ.id}
          >
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-brand-bg text-brand-blue border border-brand-border">
                  {occ.sector}
                </span>
              </div>

              <h3 class="text-base font-bold text-brand-navy mb-1.5">{occ.title}</h3>
              <p class="text-xs text-brand-muted leading-relaxed mb-3">
                {occ.description}
              </p>

              <div class="mb-4">
                <span class="text-[10px] font-bold uppercase tracking-wider text-brand-navy block mb-1">
                  Sample Roles:
                </span>
                <div class="flex flex-wrap gap-1">
                  {occ.sampleRoles.map((role) => (
                    <span class="text-[10px] bg-brand-bg px-2 py-0.5 rounded-md text-brand-navy font-medium border border-brand-border/60">
                      {role}
                    </span>
                  ))}
                </div>
              </div>

              <div class="mb-4">
                <span class="text-[10px] font-bold uppercase tracking-wider text-brand-navy block mb-1">
                  Document Readiness:
                </span>
                <ul class="text-[10px] text-brand-muted space-y-0.5">
                  {occ.documentReadiness.map((doc) => (
                    <li class="flex items-start gap-1">
                      <span class="text-brand-blue">•</span>
                      <span>{doc}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-3 border-t border-brand-border/60">
              <button
                type="button"
                class="select-occ-btn w-full py-1.5 px-3 rounded-lg bg-brand-bg hover:bg-brand-navy hover:text-white text-xs font-bold text-brand-navy transition-colors text-center"
                data-occ-id={occ.id}
                data-occ-title={occ.title}
              >
                Select & Enquire ↓
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 03: Employment Terms & Contract Evaluation Checklist -->
  <section id="contract-factors" class="py-14 sm:py-18 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Step 03</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight mb-3">
          Employment Terms & Contract Evaluation
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          The client poster references salary, overtime, accommodation, and transportation benefits. We evaluate foreign contracts against these critical criteria to protect workers from unverified offers and legal disputes.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {employmentEvaluationFactors.map((factor, idx) => (
          <div class="p-6 rounded-2xl bg-brand-bg/60 border border-brand-border shadow-2xs flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="w-8 h-8 rounded-lg bg-white text-brand-navy flex items-center justify-center font-bold text-xs border border-brand-border shadow-2xs">
                  0{idx + 1}
                </span>
                <span class="text-[10px] font-bold uppercase px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-200">
                  {factor.importance}
                </span>
              </div>
              <h3 class="text-base font-bold text-brand-navy mb-2">
                {factor.title}
              </h3>
              <p class="text-xs text-brand-muted leading-relaxed">
                {factor.detail}
              </p>
            </div>
          </div>
        ))}
      </div>

      <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 leading-relaxed flex items-start gap-2.5">
        <svg class="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <strong>Protective Advisory:</strong> Never pay cash for foreign employment or accept unstructured offers. A valid employment visa is issued only on the foundation of a registered company contract filed with host-nation labor ministries.
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 04: What Assistance Is Available -->
  <section id="how-we-assist" class="py-14 sm:py-18 bg-brand-bg/60 border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Step 04</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight mb-3">
          Our Scope of Documentation Assistance
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed">
          How Visa Convention supports your legal work authorization pathway from Hanumangarh.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
        {workVisaAssistanceScope.map((scope) => (
          <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-2xs">
            <div class="w-9 h-9 rounded-xl bg-brand-bg text-brand-navy flex items-center justify-center font-extrabold text-sm mb-4 border border-brand-border">
              0{scope.stepNumber}
            </div>
            <h3 class="text-base font-bold text-brand-navy mb-2">{scope.title}</h3>
            <p class="text-xs text-brand-muted leading-relaxed">
              {scope.description}
            </p>
          </div>
        ))}
      </div>

      <div class="p-5 rounded-2xl bg-brand-navy text-white text-xs leading-relaxed flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="font-bold text-white text-sm block mb-1">
            Holding a Genuine Job Offer from Abroad?
          </span>
          <span class="text-white/80">
            Let our compliance specialists audit your employer's sponsorship credentials and guide your work visa petition paperwork.
          </span>
        </div>
        <a
          href="#enquiry"
          class="px-4 py-2 rounded-xl bg-brand-red text-white font-bold hover:bg-brand-red/90 whitespace-nowrap self-start sm:self-auto text-center"
        >
          Verify Offer Letter
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 05: Frequently Asked Questions -->
  <section class="py-14 sm:py-18 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <span class="inline-block px-3 py-1 mb-3 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
          Regulations & Clarity
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-3">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-brand-muted">
          Important legal and operational answers regarding work permit documentation.
        </p>
      </div>

      <FAQAccordion faqs={workFaqs} />
    </div>
  </section>

  <!-- SECTION 06: Context-Aware Enquiry Form -->
  <section id="enquiry" class="py-14 sm:py-20 bg-brand-bg">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8">
        <span class="badge-pill mb-3">
          Step 05 · Regulatory Assessment
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-brand-navy tracking-tight mb-2">
          Request Work Visa Documentation Guidance
        </h2>
        <p class="text-sm text-brand-muted max-w-xl mx-auto">
          Share your target destination country and occupational background. Our team will verify employer documentation prerequisites and guide your petition.
        </p>
      </div>

      <EnquiryForm
        selectedService="work-visa"
        title="Work Visa Assessment"
        subtitle="Confidential file evaluation for sponsored foreign employment and work authorization."
      />
    </div>
  </section>
</BaseLayout>

<script>
  // Dynamic UI Script for Work Visa Page
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Destination Regional Filter
    const regionBtns = document.querySelectorAll('.work-region-btn');
    const destCards = document.querySelectorAll('.work-dest-card');

    regionBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const region = btn.getAttribute('data-region') || 'all';

        regionBtns.forEach((b) => {
          b.classList.remove('bg-brand-navy', 'text-white', 'shadow-2xs');
          b.classList.add('bg-white', 'border', 'border-brand-border', 'text-brand-navy');
        });
        btn.classList.add('bg-brand-navy', 'text-white', 'shadow-2xs');
        btn.classList.remove('bg-white', 'border', 'border-brand-border');

        destCards.forEach((card) => {
          const cardRegion = card.getAttribute('data-region');
          const isVisible = region === 'all' || cardRegion === region;
          (card as HTMLElement).classList.toggle('hidden', !isVisible);
        });
      });
    });

    // 2. Occupational Sector Filter
    const sectorBtns = document.querySelectorAll('.work-sector-btn');
    const occCards = document.querySelectorAll('.occupation-card');

    sectorBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sector = btn.getAttribute('data-sector') || 'all';

        sectorBtns.forEach((b) => {
          b.classList.remove('bg-brand-navy', 'text-white', 'shadow-2xs');
          b.classList.add('bg-white', 'border', 'border-brand-border', 'text-brand-navy');
        });
        btn.classList.add('bg-brand-navy', 'text-white', 'shadow-2xs');
        btn.classList.remove('bg-white', 'border', 'border-brand-border');

        occCards.forEach((card) => {
          const cardSector = card.getAttribute('data-sector');
          const isVisible = sector === 'all' || cardSector === sector;
          (card as HTMLElement).classList.toggle('hidden', !isVisible);
        });
      });
    });

    // 3. One-Click Apply to Form
    const countrySelect = document.getElementById('form-country') as HTMLSelectElement | null;
    const messageField = document.getElementById('form-message') as HTMLTextAreaElement | null;
    const contextBanner = document.getElementById('enquiry-context-banner');
    const contextBannerText = document.getElementById('context-banner-text');

    function populateWorkFormContext(countrySlug?: string, occTitle?: string) {
      if (countrySlug && countrySelect) {
        countrySelect.value = countrySlug;
      }

      if (occTitle && messageField) {
        const prefix = `[Work Visa Occupation: ${occTitle}] `;
        if (!messageField.value.includes(prefix)) {
          messageField.value = prefix + messageField.value.replace(/\[Work Visa Occupation:.*?\]\s*/g, '');
        }
      }

      if (contextBanner && contextBannerText) {
        const parts = ['WORK VISA'];
        if (countrySlug) parts.push(countrySlug.toUpperCase());
        if (occTitle) parts.push(occTitle.toUpperCase());
        contextBannerText.textContent = `Enquiring for: ${parts.join(' • ')}`;
        contextBanner.classList.remove('hidden');
      }

      // Smooth scroll to form
      const enquirySection = document.getElementById('enquiry');
      if (enquirySection) {
        enquirySection.scrollIntoView({ behavior: 'smooth' });
      }
    }

    // Connect work destination buttons
    document.querySelectorAll('.select-work-dest-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug') || undefined;
        populateWorkFormContext(slug, undefined);
      });
    });

    // Connect occupational category buttons
    document.querySelectorAll('.select-occ-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-occ-title') || undefined;
        populateWorkFormContext(undefined, title);
      });
    });
  });
</script>
