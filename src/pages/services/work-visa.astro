---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import FAQAccordion from '../../components/common/FAQAccordion.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import DestinationAccordion, { type DestinationGroup } from '../../components/services/DestinationAccordion.astro';
import OccupationAccordion from '../../components/services/OccupationAccordion.astro';
import { 
  statutoryWorkDisclaimer,
  workDestinations,
  occupationalCategories,
  employmentEvaluationFactors,
  workFaqs 
} from '../../data/work-visa-data';
import { getFaqSchema } from '../../utils/seo';

const pageTitle = 'Work Visa & Permit Documentation Guidance — Visa Convention';
const pageDescription = 'Regulatory visa documentation guidance for candidates holding verified foreign job offers. Gulf and European permit paperwork, PCC, and credential evaluations.';

const faqSchema = getFaqSchema(workFaqs);

// Destination groups according to specifications: Gulf, Europe, and Other
const destinationGroups: DestinationGroup[] = [
  {
    id: 'gulf',
    name: 'Gulf Cooperation Council',
    count: workDestinations.filter(d => d.region === 'Gulf').length,
    items: workDestinations
      .filter(d => d.region === 'Gulf')
      .map(d => ({
        id: d.id,
        name: d.country,
        slug: d.slug,
        streamOrAuthorityLabel: 'Permit Authority',
        streamOrAuthorityValue: d.permitAuthority,
        secondaryLabel: d.locations ? 'Locations / Emirates' : undefined,
        secondaryValue: d.locations ? d.locations.join(' · ') : undefined,
        overview: d.advisoryNote,
      })),
  },
  {
    id: 'europe',
    name: 'European Union',
    count: workDestinations.filter(d => d.region === 'Europe').length,
    items: workDestinations
      .filter(d => d.region === 'Europe')
      .map(d => ({
        id: d.id,
        name: d.country,
        slug: d.slug,
        streamOrAuthorityLabel: 'Permit Authority',
        streamOrAuthorityValue: d.permitAuthority,
        overview: d.advisoryNote,
      })),
  },
  {
    id: 'other',
    name: 'Other Global Destinations',
    count: workDestinations.filter(d => d.region === 'Other').length,
    items: workDestinations
      .filter(d => d.region === 'Other')
      .map(d => ({
        id: d.id,
        name: d.country,
        slug: d.slug,
        streamOrAuthorityLabel: 'Permit Authority',
        streamOrAuthorityValue: d.permitAuthority,
        overview: d.advisoryNote,
      })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  schema={faqSchema}
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'Work Visa', href: '/services/work-visa/', current: true },
      ]}
    />
  </div>

  <!-- Hero Section (Preserving original client poster image) -->
  <section class="py-10 sm:py-14 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
        <div class="lg:col-span-7 text-left">
          <span class="inline-block px-3 py-1 mb-3 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
            Work Permit Compliance & Procedural Advisory
          </span>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-3">
            Work Visa Assistance
          </h1>
          <p class="text-base sm:text-lg font-semibold text-brand-blue mb-3 leading-snug">
            Administrative Documentation & Regulatory Compliance for Sponsored Foreign Employment
          </p>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6 font-normal">
            Explore destinations and request guidance regarding work authorization and documentation. Visa Convention provides meticulous paperwork support, educational credential evaluation guidance, and consular petition preparation for candidates holding verified foreign employment offers.
          </p>

          <!-- Streamlined Quick Jump Navigation -->
          <div class="flex flex-wrap items-center gap-2 pt-1">
            <a
              href="#destinations"
              class="px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
              <span>Destinations (14)</span>
            </a>
            <a
              href="#occupations"
              class="px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-brand-red"></span>
              <span>Occupational Areas</span>
            </a>
            <a
              href="#contract-factors"
              class="px-3 py-1.5 rounded-xl bg-white border border-brand-border text-xs font-bold text-brand-navy hover:border-brand-blue hover:text-brand-blue shadow-2xs transition-all flex items-center gap-1.5"
            >
              <span class="w-2 h-2 rounded-full bg-amber-500"></span>
              <span>Contract Checklist</span>
            </a>
            <a
              href="#enquiry"
              class="btn-primary text-xs py-1.5 px-3.5 shadow-sm inline-flex items-center gap-1.5"
            >
              <span>Verify Eligibility</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video">
            <img
              src="/assets/images/services/Global%20Work%20Visa%20Opportunities.png"
              alt="Visa Convention Global Work Visa Opportunities Guidance"
              width="1672"
              height="941"
              class="w-full h-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATUTORY REGULATORY DISCLOSURE BANNER (Essential Legal Guardrail) -->
  <section class="py-6 bg-amber-50/80 border-b border-amber-200">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-5 sm:p-6 rounded-2xl bg-white border border-amber-300 shadow-2xs">
        <div class="flex items-start gap-3">
          <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-900 flex items-center justify-center font-bold text-sm flex-shrink-0 mt-0.5">
            ⚠️
          </div>
          <div>
            <span class="text-xs font-extrabold uppercase tracking-wider text-amber-900 block mb-1">
              {statutoryWorkDisclaimer.title}
            </span>
            <p class="text-xs sm:text-sm font-bold text-brand-navy mb-2">
              {statutoryWorkDisclaimer.notice}
            </p>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-brand-muted mb-3">
              {statutoryWorkDisclaimer.rules.map((rule) => (
                <li class="flex items-start gap-1.5">
                  <span class="text-amber-700 font-bold">•</span>
                  <span>{rule}</span>
                </li>
              ))}
            </ul>
            <div class="text-[11px] text-amber-800 font-semibold border-t border-amber-100 pt-2 flex items-center justify-between flex-wrap gap-2">
              <span>Statutory Compliance: {statutoryWorkDisclaimer.lawReference}</span>
              <span>Advisory Service Only · Zero Placement Commissions</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 01: Explore Work Visa Destinations (Compact Searchable Accordion) -->
  <section id="destinations" class="py-10 sm:py-14 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Explore Work Visa Destinations
        </h2>
        <p class="text-sm text-brand-muted leading-relaxed">
          14 approved countries across Gulf, Europe, and global regions. Select any destination to review regulatory requirements and automatically apply it to your assessment.
        </p>
      </div>

      <!-- Reusable Compact Destination Accordion -->
      <DestinationAccordion
        groups={destinationGroups}
        serviceType="work"
        searchPlaceholder="Search work destination country (e.g. UAE, Saudi Arabia, Poland, Germany)..."
        searchInputId="destination-search-input"
      />

      <div class="mt-6 p-3.5 rounded-xl bg-blue-50/60 border border-blue-100 text-xs text-brand-muted leading-relaxed">
        <strong>Single UAE Country Entry:</strong> Dubai, Abu Dhabi, and Sharjah are emirates of the United Arab Emirates, governed under the federal MOHRE and respective residency authorities. They are grouped under one national country entry with specific emirate routing.
      </div>
    </div>
  </section>

  <!-- SECTION 02: Occupational Focus Areas (Compact Selector) -->
  <section id="occupations" class="py-10 sm:py-14 bg-brand-bg/60 border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Occupational Focus Areas
        </h2>
        <span class="inline-block px-3 py-1 mb-2 text-xs font-bold tracking-wider uppercase rounded-md bg-amber-100 text-amber-900 border border-amber-200">
          Occupational Categories — Not Live Job Vacancies
        </span>
        <p class="text-sm text-brand-muted leading-relaxed">
          12 trade and skilled work categories supported by Visa Convention for candidates with verified employer sponsorship. Select any occupation to review prerequisites and populate your assessment form.
        </p>
      </div>

      <!-- Compact Occupation Accordion -->
      <OccupationAccordion occupations={occupationalCategories} />
    </div>
  </section>

  <!-- SECTION 03: Employment Terms & Contract Evaluation (Compact Dropdown Drawer) -->
  <section id="contract-factors" class="py-10 sm:py-14 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Employment Terms & Contract Evaluation
        </h2>
        <p class="text-sm text-brand-muted leading-relaxed">
          Evaluating foreign employment contracts against statutory criteria protects workers from unverified offers and legal disputes. Expand below for the 6 critical evaluation criteria.
        </p>
      </div>

      <!-- Collapsed Contract Evaluation Dropdown Accordion -->
      <div class="max-w-4xl rounded-2xl border border-brand-border bg-white overflow-hidden shadow-2xs">
        <button
          type="button"
          id="contract-eval-toggle"
          class="w-full min-h-[52px] px-4 sm:px-5 py-3.5 bg-brand-bg/50 hover:bg-brand-bg text-left flex items-center justify-between gap-3 transition-colors focus-visible:outline-2 focus-visible:outline-brand-blue"
          aria-expanded="false"
          aria-controls="contract-eval-panel"
        >
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            <span class="text-sm sm:text-base font-bold text-brand-navy">
              6 Essential Contract Evaluation Criteria
            </span>
            <span class="hidden sm:inline-block text-[11px] text-brand-muted bg-white px-2 py-0.5 rounded-full border border-brand-border font-medium">
              Worker Protection Checklist
            </span>
          </div>

          <svg
            id="contract-eval-chevron"
            class="w-4 h-4 text-brand-navy transition-transform duration-200 flex-shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div id="contract-eval-panel" class="hidden px-4 sm:px-6 py-5 bg-white border-t border-brand-border/60">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 mb-4">
            {employmentEvaluationFactors.map((factor, idx) => (
              <div class="p-3.5 rounded-xl bg-brand-bg/40 border border-brand-border/70 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="text-xs font-bold text-brand-blue">Factor 0{idx + 1}</span>
                    <span class="text-[10px] font-semibold px-2 py-0.5 rounded-md bg-amber-100/80 text-amber-900 border border-amber-200/60">
                      {factor.importance}
                    </span>
                  </div>
                  <h4 class="text-sm font-bold text-brand-navy mb-1 leading-snug">
                    {factor.title}
                  </h4>
                  <p class="text-xs text-brand-muted leading-relaxed">
                    {factor.detail}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <div class="p-3 rounded-xl bg-amber-50/70 border border-amber-200/80 text-xs text-amber-900 leading-relaxed flex items-start gap-2">
            <svg class="w-4 h-4 text-amber-700 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <strong>Protective Advisory:</strong> Never pay cash for foreign employment or accept unstructured offers. A valid employment visa is issued only on the foundation of a registered company contract filed with host-nation labor ministries.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Frequently Asked Questions -->
  <section class="py-10 sm:py-14 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-8">
        <span class="inline-block px-3 py-1 mb-2 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
          Regulations & Clarity
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy tracking-tight mb-2">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-brand-muted">
          Important legal and operational answers regarding work permit documentation.
        </p>
      </div>

      <FAQAccordion faqs={workFaqs} />
    </div>
  </section>

  <!-- Compliance Disclosure Standard (Preserved Essential Legal Notice) -->
  <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <div class="p-4 rounded-xl bg-slate-50 border border-brand-border text-xs text-brand-muted leading-relaxed text-center">
      <strong class="text-brand-navy font-bold">Document Verification Standard:</strong> Visa Convention evaluates foreign employment contracts strictly for visa documentation and consular eligibility. We do not guarantee overseas employment, sponsor work permits, or charge recruitment commissions.
    </div>
  </div>

  <!-- Context-Aware Enquiry Form -->
  <section id="enquiry" class="py-10 sm:py-16 bg-brand-bg">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-6">
        <h2 class="text-2xl sm:text-3xl font-black text-brand-navy tracking-tight mb-2">
          Request Work Visa Documentation Guidance
        </h2>
        <p class="text-sm text-brand-muted max-w-xl mx-auto">
          Share your target destination country and occupational background. Our team will verify employer documentation prerequisites and guide your petition.
        </p>
      </div>

      <EnquiryForm
        selectedService="work-visa"
        title="Work Visa Assessment"
        subtitle="Confidential file evaluation for sponsored foreign employment and work authorization."
      />
    </div>
  </section>
</BaseLayout>

<script>
  // Work Visa Page Client Interactions
  document.addEventListener('DOMContentLoaded', () => {
    // Contract Evaluation Dropdown Accordion
    const evalToggle = document.getElementById('contract-eval-toggle');
    const evalPanel = document.getElementById('contract-eval-panel');
    const evalChevron = document.getElementById('contract-eval-chevron');

    evalToggle?.addEventListener('click', () => {
      const isExpanded = evalToggle.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;

      evalToggle.setAttribute('aria-expanded', String(nextState));
      if (evalPanel) evalPanel.classList.toggle('hidden', !nextState);
      if (evalChevron) evalChevron.classList.toggle('rotate-180', nextState);
    });
  });
</script>
