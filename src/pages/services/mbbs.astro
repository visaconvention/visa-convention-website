---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import { detailedServicesData } from '../../data/detailed-services';
import { siteConfig } from '../../data/site-config';

const mbbsService = detailedServicesData['mbbs'];
if (!mbbsService) throw new Error('Detailed service data not found for mbbs');

const pageTitle = 'MBBS Abroad Admissions 2026 — WDOMS-Listed & NMC FMGL-Compliant Universities | Visa Convention';
const pageDescription = 'Direct admission guidance for MBBS abroad in Uzbekistan, Kazakhstan, Russia, Kyrgyzstan, and Europe. Affordable fees, Indian food facilities, and FMGE/NExT screening support.';

// Preserve all 34 approved universities for application guidance
const universities = mbbsService.featuredInstitutions || [];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'MBBS Abroad', href: '/services/mbbs/', current: true },
      ]}
    />
  </div>

  <!-- Hero Section -->
  <section class="py-10 sm:py-14 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy -->
        <div class="lg:col-span-7 text-left">
          <span class="inline-block px-3.5 py-1 mb-4 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
            Medical Admissions Desk
          </span>
          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4">
            MBBS Abroad Admissions
          </h1>
          <p class="text-lg sm:text-xl font-semibold text-brand-blue mb-4 leading-snug">
            International Medical Degrees in WDOMS-Listed & NMC FMGL-Compliant Faculties
          </p>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6">
            Direct admission guidance for Indian medical aspirants seeking recognized medical universities in Uzbekistan, Kazakhstan, Russia, Kyrgyzstan, and Europe with zero capitation fees and FMGE/NExT screening preparation.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4">
            <a
              href="#enquiry"
              class="btn-primary inline-flex items-center gap-2"
            >
              <span>Check MBBS Eligibility & Fees</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a
              href="#universities"
              class="btn-secondary inline-flex items-center gap-2"
            >
              <span>View {universities.length} Guided Universities</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video flex items-center justify-center">
            <img
              src="/assets/images/services/MBBS%20&%20PhD%20Courses%20Abroad.png"
              alt="Visa Convention MBBS and PhD Courses Abroad Educational Guidance"
              width="1670"
              height="813"
              class="w-full h-full object-contain"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Essential Regulatory & Recognition Guidance (Compact Strip) -->
  <section class="py-8 bg-white border-b border-brand-border">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-6 rounded-2xl bg-brand-navy text-white shadow-md border-l-4 border-brand-red">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              <h2 class="text-base sm:text-lg font-bold text-white">
                National Medical Commission (NMC) FMGL Compliance & Standards
              </h2>
            </div>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-4xl">
              Foreign Medical Graduate Licentiate (FMGL) Regulations, 2021 mandate: 54-month minimum course duration + 12-month clinical internship at the same institution, 100% English medium of instruction, and mandatory NEET qualification prior to enrollment.
            </p>
          </div>
          <div class="flex-shrink-0">
            <span class="inline-block px-3 py-1.5 rounded-lg bg-white/10 text-amber-300 font-bold text-xs border border-white/20">
              WDOMS & WHO Directory Recognized
            </span>
          </div>
        </div>
      </div>

      <!-- Non-partnership integrity disclaimer -->
      <p class="text-[11px] text-brand-muted mt-3 text-center sm:text-left leading-relaxed">
        <strong>Integrity Notice:</strong> Visa Convention provides independent admissions guidance and visa documentation assistance. Listings do not imply formal partnership, direct affiliation, or institutional endorsement. Tuition fees are payable directly to official university bank accounts.
      </p>
    </div>
  </section>

  <!-- Universities for Application Guidance Section -->
  <section id="universities" class="py-12 sm:py-16 bg-brand-bg/40 border-b border-brand-border">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-brand-red"></span>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Approved Directory</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy">
            Universities for Application Guidance
          </h2>
          <p class="text-xs sm:text-sm text-brand-muted mt-1">
            Displaying all {universities.length} recognized medical faculties across Central Asia and Europe.
          </p>
        </div>
        <a
          href="/universities/"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-blue hover:text-brand-red transition-colors self-start sm:self-auto"
        >
          <span>Search Complete University Directory</span>
          <span class="text-brand-red">→</span>
        </a>
      </div>

      <!-- Responsive CSS Grid:
           ≥1440px: 4 columns
           1024–1439px: 3 columns
           600–1023px: 2 columns
           Below 600px: 1 column
           Gap: 14px-16px (gap-3.5 sm:gap-4)
      -->
      <div class="grid mbbs-grid gap-3.5 sm:gap-4">
        {universities.map((uni, idx) => (
          <div
            class="uni-card group relative p-4 rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer"
            data-university-name={uni.name}
            data-country-name={uni.country}
          >
            <div>
              <!-- Location Badge -->
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-brand-bg text-brand-navy border border-brand-border/60">
                  <span>📍</span>
                  <span>{uni.country}{uni.city ? ` • ${uni.city}` : ''}</span>
                </span>
                <span class="text-[10px] font-bold text-brand-muted/70">
                  #{idx + 1}
                </span>
              </div>

              <!-- Full University Name (Never truncated) -->
              <h3 class="font-bold text-sm text-brand-navy group-hover:text-brand-blue transition-colors mb-1.5 leading-snug break-words">
                {uni.name}
              </h3>

              <!-- Essential Details / Notes -->
              {uni.notes && (
                <p class="text-xs text-brand-muted leading-relaxed">
                  {uni.notes}
                </p>
              )}
            </div>

            <!-- Action Link / Button -->
            <div class="mt-4 pt-2.5 border-t border-brand-border/60 flex items-center justify-between text-xs font-bold text-brand-navy group-hover:text-brand-red transition-colors">
              <span>Request Guidance</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Consultation & Assessment Form Section -->
  <section id="enquiry" class="py-12 sm:py-16 bg-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Side: Advisory Info & Direct Channels -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 rounded-3xl bg-brand-bg border border-brand-border">
            <span class="badge-pill mb-3">Official Counseling Desk</span>
            <h2 class="text-2xl font-black text-brand-navy tracking-tight mb-2">
              Plan Your Medical Degree Abroad
            </h2>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-6">
              Our medical admissions counselors provide transparent fee schedules, hostel inspections, and NEET qualification verification for recognized universities across Central Asia and Europe.
            </p>

            <div class="space-y-4 text-xs">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-white border border-brand-border text-brand-navy flex items-center justify-center font-bold shrink-0">
                  🏢
                </div>
                <div>
                  <strong class="block text-brand-navy font-bold">Hanumangarh Counseling Office</strong>
                  <span class="text-brand-muted">{siteConfig.officeAddress}</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-white border border-brand-border text-brand-navy flex items-center justify-center font-bold shrink-0">
                  📞
                </div>
                <div>
                  <strong class="block text-brand-navy font-bold">Direct Medical Desk</strong>
                  <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="text-brand-blue font-bold hover:underline">
                    {siteConfig.phone}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-white border border-brand-border text-emerald-600 flex items-center justify-center font-bold shrink-0">
                  💬
                </div>
                <div>
                  <strong class="block text-brand-navy font-bold">WhatsApp Advisory</strong>
                  <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="text-emerald-700 font-bold hover:underline">
                    Chat on WhatsApp ({siteConfig.phone})
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Enquiry Form -->
        <div class="lg:col-span-7">
          <EnquiryForm
            selectedService="mbbs"
            title="Request MBBS Admission Assessment"
            subtitle="Submit your details for personalized university recommendations, transparent fee structures, and NEET eligibility guidance."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side script to populate form when clicking university cards -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const uniCards = document.querySelectorAll('.uni-card');
      const uniInput = document.getElementById('form-university');
      const countrySelect = document.getElementById('form-country');
      const contextBanner = document.getElementById('enquiry-context-banner');
      const contextBannerText = document.getElementById('context-banner-text');

      uniCards.forEach((card) => {
        card.addEventListener('click', () => {
          const uniName = card.getAttribute('data-university-name') || '';
          const countryName = card.getAttribute('data-country-name') || '';

          if (uniInput) {
            uniInput.value = uniName;
          }

          if (countrySelect && countryName) {
            // Match country option
            const options = Array.from(countrySelect.options);
            const match = options.find((opt) => opt.text.toLowerCase().includes(countryName.toLowerCase()));
            if (match) {
              countrySelect.value = match.value;
            }
          }

          if (contextBanner && contextBannerText) {
            contextBannerText.textContent = `Pre-selected: ${uniName} (${countryName})`;
            contextBanner.classList.remove('hidden');
          }

          // Scroll to enquiry form smoothly
          const enquiryEl = document.getElementById('enquiry');
          if (enquiryEl) {
            enquiryEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const nameInput = document.getElementById('form-full-name');
            if (nameInput) {
              setTimeout(() => nameInput.focus(), 600);
            }
          }
        });
      });
    });
  </script>

  <style>
    .mbbs-grid {
      grid-template-columns: repeat(1, minmax(0, 1fr));
    }
    @media (min-width: 600px) {
      .mbbs-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    @media (min-width: 1024px) {
      .mbbs-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    @media (min-width: 1440px) {
      .mbbs-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
  </style>
</BaseLayout>
