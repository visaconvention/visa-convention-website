---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import CountryCard from '../../components/countries/CountryCard.astro';
import { detailedServicesData } from '../../data/detailed-services';

const mbbsService = detailedServicesData['mbbs'];
if (!mbbsService) throw new Error('Detailed service data not found for mbbs');

const pageTitle = 'MBBS Abroad Admissions 2026 — WDOMS-Listed & NMC FMGL-Compliant Universities | Visa Convention';
const pageDescription = 'Direct admission guidance for MBBS abroad in Uzbekistan, Kazakhstan, Russia, Kyrgyzstan, and Europe. Affordable fees, Indian food facilities, and FMGE/NExT screening support.';

// Preserve all 34 approved universities for application guidance
const universities = mbbsService.featuredInstitutions || [];

// Country ISO mapping for official SVGs
const countryIsoMap: Record<string, string> = {
  'Uzbekistan': 'uz',
  'Kazakhstan': 'kz',
  'Russia': 'ru',
  'Kyrgyzstan': 'kg',
  'Moldova': 'md',
  'Latvia': 'lv',
  'Poland': 'pl',
  'Georgia': 'ge',
  'Portugal': 'pt',
  'Lithuania': 'lt',
  'Azerbaijan': 'az',
};

// Derive unique countries with counts from approved dataset
const uniqueCountryNames = Array.from(new Set(universities.map((u) => u.country)));
const mbbsCountries = uniqueCountryNames.map((name) => {
  const count = universities.filter((u) => u.country === name).length;
  const iso = countryIsoMap[name] || 'gl';
  const slug = name.toLowerCase().replace(/\s+/g, '-');
  return {
    name,
    slug,
    count,
    flagSvg: `/assets/flags/${iso}.svg`,
  };
});
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 page-header-gap pb-2 sm:pb-3">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'MBBS Abroad', href: '/services/mbbs/', current: true },
      ]}
    />
  </div>

  <!-- Hero Section -->
  <section class="pt-3 sm:pt-4 lg:pt-5 pb-8 sm:pb-10 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy -->
        <div class="lg:col-span-7 text-left">
          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4">
            MBBS Abroad Admissions
          </h1>
          <p class="text-lg sm:text-xl font-semibold text-brand-blue mb-4 leading-snug">
            International Medical Degrees in WDOMS-Listed & NMC FMGL-Compliant Faculties
          </p>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6">
            Direct admission guidance for Indian medical aspirants seeking recognized medical universities in Uzbekistan, Kazakhstan, Russia, Kyrgyzstan, and Europe with zero capitation fees and FMGE/NExT screening preparation.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4">
            <a
              href="#enquiry"
              class="btn-primary inline-flex items-center gap-2"
            >
              <span>Check MBBS Eligibility & Fees</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a
              href="#universities"
              class="btn-secondary inline-flex items-center gap-2"
            >
              <span>Explore {mbbsCountries.length} Destination Countries</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video flex items-center justify-center">
            <img
              src="/assets/images/services/MBBS%20&%20PhD%20Courses%20Abroad.png"
              alt="Visa Convention MBBS and PhD Courses Abroad Educational Guidance"
              width="1670"
              height="813"
              class="w-full h-full object-contain"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Two-Column Directory & Assessment Section -->
  <section id="universities" class="py-8 sm:py-10 max-w-[1240px] xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 min-[1100px]:grid-cols-12 gap-5 lg:gap-6 items-start">
      <!-- Left Column (~70%): MBBS Destination Countries & Universities Directory -->
      <div class="min-[1100px]:col-span-8 space-y-6">
        <!-- Section Header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy">
              Universities for Application Guidance
            </h2>
            <p class="text-xs sm:text-sm text-brand-muted mt-1">
              Select a destination country to display approved medical faculties across Central Asia and Europe ({universities.length} universities across {mbbsCountries.length} countries).
            </p>
          </div>
          <a
            href="/universities/"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-blue hover:text-brand-red transition-colors self-start sm:self-auto"
          >
            <span>Search Complete University Directory</span>
            <span class="text-brand-red">→</span>
          </a>
        </div>

        <!-- Compact Flag-Based Country Cards Grid (3-4 cols desktop, 3 tablet, 2 mobile) -->
        <div class="grid grid-cols-2 md:grid-cols-3 min-[1100px]:grid-cols-3 xl:grid-cols-4 gap-2.5 sm:gap-3 items-stretch" id="mbbs-countries-grid" role="tablist" aria-label="MBBS Destination Countries">
          {mbbsCountries.map((country) => (
            <CountryCard
              as="button"
              country={country}
              class="mbbs-country-btn"
            />
          ))}
        </div>

        <!-- Filtered Universities Container (Initially hidden, revealed on country click) -->
        <div id="mbbs-universities-section" class="pt-5 border-t border-brand-border hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
                <h3 class="text-base sm:text-lg font-bold text-brand-navy" id="mbbs-selected-country-heading">
                  Guided Universities
                </h3>
              </div>
              <p class="text-xs text-brand-muted mt-0.5" id="mbbs-selected-country-subheading">
                Click any medical university to pre-fill your evaluation request.
              </p>
            </div>
            <button
              type="button"
              id="mbbs-collapse-btn"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-muted hover:text-brand-navy self-start sm:self-auto py-1 px-2.5 rounded-lg border border-brand-border bg-white hover:bg-slate-50 transition-colors"
              aria-label="Collapse university list"
            >
              <span>Close List</span>
              <span class="text-brand-red">✕</span>
            </button>
          </div>

          <!-- University Cards Grid (Compact, responsive 1-2 columns) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4 items-start" id="mbbs-universities-grid">
            {universities.map((uni, idx) => (
              <div
                class="uni-card group relative p-4 rounded-xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer self-start w-full hidden"
                data-university-name={uni.name}
                data-country-name={uni.country}
                data-country-slug={uni.country.toLowerCase().replace(/\s+/g, '-')}
              >
                <div>
                  <!-- Location Badge -->
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-bold uppercase bg-brand-bg text-brand-navy border border-brand-border/60">
                      <span>📍</span>
                      <span>{uni.country}{uni.city ? ` • ${uni.city}` : ''}</span>
                    </span>
                    <span class="text-[10px] font-bold text-brand-muted/70">
                      #{idx + 1}
                    </span>
                  </div>

                  <!-- Full University Name -->
                  <h3 class="font-bold text-sm text-brand-navy group-hover:text-brand-blue transition-colors mb-1.5 leading-snug break-words">
                    {uni.name}
                  </h3>

                  <!-- Essential Details / Notes -->
                  {uni.notes && (
                    <p class="text-xs text-brand-muted leading-relaxed">
                      {uni.notes}
                    </p>
                  )}
                </div>

                <!-- Action Button -->
                <div class="mt-3.5 pt-2.5 border-t border-brand-border/60 flex items-center justify-between text-xs font-bold text-brand-navy group-hover:text-brand-red transition-colors">
                  <span>Request Guidance</span>
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column (~30%): Compact Sticky MBBS Assessment Form -->
      <aside class="min-[1100px]:col-span-4 w-full scroll-mt-24" id="enquiry">
        <div class="min-[1100px]:sticky min-[1100px]:top-24 space-y-4">
          <EnquiryForm
            selectedService="mbbs"
            title="Request MBBS Admission Assessment"
            subtitle=""
            singleColumn={true}
          />
        </div>
      </aside>
    </div>
  </section>

  <!-- Client-side script for Country Filter, Collapse, and Auto-population -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const countryBtns = document.querySelectorAll('.mbbs-country-btn');
      const unisSection = document.getElementById('mbbs-universities-section');
      const headingEl = document.getElementById('mbbs-selected-country-heading');
      const uniCards = document.querySelectorAll('#mbbs-universities-grid .uni-card');
      const collapseBtn = document.getElementById('mbbs-collapse-btn');
      const uniInput = document.getElementById('form-university');
      const countrySelect = document.getElementById('form-country');
      const contextBanner = document.getElementById('enquiry-context-banner');
      const contextBannerText = document.getElementById('context-banner-text');

      let currentSelectedCountry = null;

      function selectCountry(countryName, btn) {
        currentSelectedCountry = countryName;

        // Update button active styles & ARIA
        countryBtns.forEach((b) => {
          const isTarget = b === btn;
          b.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          if (isTarget) {
            b.classList.add('ring-2', 'ring-brand-blue', 'border-brand-navy', 'bg-brand-bg/60', 'shadow-sm');
            b.classList.remove('bg-white');
            const badge = b.querySelector('.country-badge');
            if (badge) {
              badge.classList.add('bg-brand-navy', 'text-white', 'border-brand-navy');
              badge.classList.remove('bg-brand-bg', 'text-brand-navy');
            }
          } else {
            b.classList.remove('ring-2', 'ring-brand-blue', 'border-brand-navy', 'bg-brand-bg/60', 'shadow-sm');
            b.classList.add('bg-white');
            const badge = b.querySelector('.country-badge');
            if (badge) {
              badge.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy');
              badge.classList.add('bg-brand-bg', 'text-brand-navy');
            }
          }
        });

        // Reveal section
        if (unisSection) {
          unisSection.classList.remove('hidden');
        }

        // Filter university cards
        let visibleCount = 0;
        uniCards.forEach((card) => {
          const cardCountry = card.getAttribute('data-country-name');
          if (cardCountry === countryName) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Update heading
        if (headingEl) {
          headingEl.textContent = `Guided Medical Universities in ${countryName} (${visibleCount})`;
        }

        // Sync enquiry form country dropdown
        if (countrySelect && countryName) {
          const options = Array.from(countrySelect.options);
          const match = options.find((opt) => opt.text.toLowerCase().includes(countryName.toLowerCase()));
          if (match) {
            countrySelect.value = match.value;
          }
        }
      }

      countryBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const countryName = btn.getAttribute('data-country-name') || '';
          if (currentSelectedCountry === countryName && unisSection && !unisSection.classList.contains('hidden')) {
            unisSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            selectCountry(countryName, btn);
          }
        });
      });

      if (collapseBtn) {
        collapseBtn.addEventListener('click', () => {
          if (unisSection) {
            unisSection.classList.add('hidden');
          }
          currentSelectedCountry = null;
          countryBtns.forEach((b) => {
            b.setAttribute('aria-selected', 'false');
            b.classList.remove('ring-2', 'ring-brand-blue', 'border-brand-navy', 'bg-brand-bg/60', 'shadow-sm');
            b.classList.add('bg-white');
            const badge = b.querySelector('.country-badge');
            if (badge) {
              badge.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy');
              badge.classList.add('bg-brand-bg', 'text-brand-navy');
            }
          });
        });
      }

      // University card click autofill
      uniCards.forEach((card) => {
        card.addEventListener('click', () => {
          const uniName = card.getAttribute('data-university-name') || '';
          const countryName = card.getAttribute('data-country-name') || '';

          if (uniInput) {
            uniInput.value = uniName;
          }

          if (countrySelect && countryName) {
            const options = Array.from(countrySelect.options);
            const match = options.find((opt) => opt.text.toLowerCase().includes(countryName.toLowerCase()));
            if (match) {
              countrySelect.value = match.value;
            }
          }

          if (contextBanner && contextBannerText) {
            contextBannerText.textContent = `Pre-selected: ${uniName} (${countryName})`;
            contextBanner.classList.remove('hidden');
          }

          // Smoothly scroll to enquiry form
          const enquiryEl = document.getElementById('enquiry');
          if (enquiryEl) {
            enquiryEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const nameInput = document.getElementById('form-full-name');
            if (nameInput) {
              setTimeout(() => nameInput.focus(), 600);
            }
          }
        });
      });
    });
  </script>
</BaseLayout>
