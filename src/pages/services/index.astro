---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/common/SectionHeading.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import ConsultationCTA from '../../components/common/ConsultationCTA.astro';
import { servicesData } from '../../data/services';
---

<BaseLayout
  title="Our Services — Visa Convention"
  description="Comprehensive advisory for Study Visas, MBBS/PhD Abroad, Tourist Visas, Work Visa documentation, and Flight Reservation Assistance."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={[{ label: 'Services', href: '/services/', current: true }]} />
  </div>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="Expert Consultancy"
      title="Comprehensive Visa & Education Verticals"
      description="Select from our specialized service streams. Each is managed with personalized documentation audits, regulatory compliance, and complete procedural clarity."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {servicesData.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>

    <div class="mt-16">
      <ConsultationCTA
        title="Unsure Which Visa Category Fits Your Profile?"
        subtitle="Schedule a consultation with our experienced advisors to evaluate your academic and immigration options."
      />
    </div>
  </section>
</BaseLayout>
