---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import CountryCard from '../../components/countries/CountryCard.astro';
import { detailedServicesData } from '../../data/detailed-services';

const phdService = detailedServicesData['phd'];
if (!phdService) throw new Error('Detailed service data not found for phd');

const pageTitle = 'PhD Abroad Guidance — Latvia, Lithuania & Portugal | Visa Convention';
const pageDescription = 'Specialized doctoral research proposal and admissions guidance for 7 approved universities in Latvia, Lithuania, and Portugal.';

// Strictly approved PhD destinations (3 countries with SVG flags)
const approvedCountries = [
  { slug: 'latvia', name: 'Latvia', count: 2, flagSvg: '/assets/flags/lv.svg' },
  { slug: 'lithuania', name: 'Lithuania', count: 3, flagSvg: '/assets/flags/lt.svg' },
  { slug: 'portugal', name: 'Portugal', count: 2, flagSvg: '/assets/flags/pt.svg' },
] as const;

// Strictly approved PhD universities (7 universities)
const approvedUniversities = [
  // Latvia (2)
  {
    id: 'rtu',
    name: 'Riga Technical University',
    country: 'Latvia',
    countrySlug: 'latvia',
    city: 'Riga',
    focus: 'Doctoral Engineering, Computer Science, Materials & Logistics',
  },
  {
    id: 'turiba',
    name: 'Turība University',
    country: 'Latvia',
    countrySlug: 'latvia',
    city: 'Riga',
    focus: 'Doctoral Business Administration, Management & Law',
  },
  // Lithuania (3)
  {
    id: 'vu',
    name: 'Vilnius University (VU)',
    country: 'Lithuania',
    countrySlug: 'lithuania',
    city: 'Vilnius',
    focus: 'Historic National Research University, Physics, Life Sciences & Humanities',
  },
  {
    id: 'ktu',
    name: 'Kaunas University of Technology (KTU)',
    country: 'Lithuania',
    countrySlug: 'lithuania',
    city: 'Kaunas',
    focus: 'Doctoral Informatics, Chemical Technology, Electronics & Robotics',
  },
  {
    id: 'vgtu',
    name: 'Vilnius Gediminas Technical University (Vilnius Tech)',
    country: 'Lithuania',
    countrySlug: 'lithuania',
    city: 'Vilnius',
    focus: 'Doctoral Civil, Transport, Mechanical & Environmental Engineering',
  },
  // Portugal (2)
  {
    id: 'ulisboa',
    name: 'University of Lisbon',
    country: 'Portugal',
    countrySlug: 'portugal',
    city: 'Lisbon',
    focus: 'Leading Portuguese Research University & FCT Doctoral Frameworks',
  },
  {
    id: 'uporto',
    name: 'University of Porto',
    country: 'Portugal',
    countrySlug: 'portugal',
    city: 'Porto',
    focus: 'Doctoral Engineering, Biomedical Sciences, Computer Science & Architecture',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'PhD Abroad', href: '/services/phd/', current: true },
      ]}
    />
  </div>

  <!-- 1. PhD Hero Section -->
  <section class="py-8 sm:py-12 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy -->
        <div class="lg:col-span-7 text-left">
          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4">
            PhD Abroad Guidance
          </h1>
          <p class="text-lg sm:text-xl font-semibold text-brand-blue mb-4 leading-snug">
            Doctoral Research Guidance in Latvia, Lithuania & Portugal
          </p>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6">
            Specialized documentation assistance, research statement structuring, and academic supervisor outreach for doctoral candidates targeting recognized institutions across Latvia, Lithuania, and Portugal.
          </p>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4">
            <a
              href="#enquiry"
              class="btn-primary inline-flex items-center gap-2"
            >
              <span>Request PhD Profile Review</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a
              href="#universities"
              class="btn-secondary inline-flex items-center gap-2"
            >
              <span>Explore 3 Approved Countries ({approvedUniversities.length} Universities)</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video flex items-center justify-center">
            <img
              src="/assets/images/services/MBBS%20&%20PhD%20Courses%20Abroad.png"
              alt="Visa Convention MBBS & PhD Courses Abroad Educational Guidance"
              width="1670"
              height="813"
              class="w-full h-full object-contain"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Two-Column Directory & Assessment Section -->
  <section id="universities" class="py-8 sm:py-10 max-w-[1240px] xl:max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 min-[1100px]:grid-cols-12 gap-5 lg:gap-6 items-start">
      <!-- Left Column (~70%): PhD Destination Countries & Approved Doctoral Universities -->
      <div class="min-[1100px]:col-span-8 space-y-6">
        <!-- Section Header -->
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy">
            Approved Doctoral Universities
          </h2>
          <p class="text-xs sm:text-sm text-brand-muted mt-1">
            Select a destination country to display approved doctoral institutions across Latvia, Lithuania, and Portugal ({approvedUniversities.length} universities across 3 countries).
          </p>
        </div>

        <!-- Compact Flag-Based Country Cards Grid (3 columns across tablet/desktop, 1-2 mobile) -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 items-stretch" id="phd-countries-grid" role="tablist" aria-label="PhD Target Countries">
          {approvedCountries.map((country) => (
            <CountryCard
              as="button"
              country={country}
              class="phd-country-btn"
            />
          ))}
        </div>

        <!-- Filtered Universities Container (Initially hidden, revealed on country click) -->
        <div id="phd-universities-section" class="pt-5 border-t border-brand-border hidden">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-brand-blue"></span>
                <h3 class="text-base sm:text-lg font-bold text-brand-navy" id="phd-selected-country-heading">
                  Approved Doctoral Universities
                </h3>
              </div>
              <p class="text-xs text-brand-muted mt-0.5" id="phd-selected-country-subheading">
                Click any doctoral institution to pre-fill your PhD evaluation request.
              </p>
            </div>
            <button
              type="button"
              id="phd-collapse-btn"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-muted hover:text-brand-navy self-start sm:self-auto py-1 px-2.5 rounded-lg border border-brand-border bg-white hover:bg-slate-50 transition-colors"
              aria-label="Collapse doctoral university list"
            >
              <span>Close List</span>
              <span class="text-brand-red">✕</span>
            </button>
          </div>

          <!-- University Cards Grid (Compact, responsive 1-2 columns) -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5 sm:gap-4" id="phd-university-grid">
            {approvedUniversities.map((uni, idx) => (
              <div
                class="phd-uni-card group relative p-4 sm:p-5 rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer hidden"
                data-country={uni.countrySlug}
                data-university-name={uni.name}
                data-country-name={uni.country}
              >
                <div>
                  <!-- Location Pill -->
                  <div class="flex items-center justify-between gap-2 mb-2.5">
                    <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md bg-brand-bg text-brand-navy font-bold text-xs border border-brand-border/60">
                      <span>📍</span>
                      <span>{uni.country} • {uni.city}</span>
                    </span>
                    <span class="text-3xs font-bold text-brand-muted/70 uppercase">
                      PhD #{idx + 1}
                    </span>
                  </div>

                  <!-- University Name in Full -->
                  <h3 class="font-bold text-base text-brand-navy group-hover:text-brand-blue transition-colors mb-2 leading-snug break-words">
                    {uni.name}
                  </h3>

                  <!-- Focus Area / Details -->
                  <p class="text-xs text-brand-muted leading-relaxed">
                    {uni.focus}
                  </p>
                </div>

                <!-- Action Button -->
                <div class="mt-4 pt-3 border-t border-brand-border/60 flex items-center justify-between text-xs font-bold text-brand-navy group-hover:text-brand-red transition-colors">
                  <span>Select for Consultation</span>
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column (~30%): Compact Sticky PhD Assessment Form -->
      <aside class="min-[1100px]:col-span-4 w-full scroll-mt-24" id="enquiry">
        <div class="min-[1100px]:sticky min-[1100px]:top-24 space-y-4">
          <EnquiryForm
            selectedService="phd"
            allowedCountries={['latvia', 'lithuania', 'portugal']}
            title="Request PhD Profile Assessment"
            subtitle=""
            singleColumn={true}
          />
        </div>
      </aside>
    </div>
  </section>

  <!-- Interactive Client-side Script for Country Filter & Auto-population -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const countryBtns = document.querySelectorAll('.phd-country-btn');
      const unisSection = document.getElementById('phd-universities-section');
      const headingEl = document.getElementById('phd-selected-country-heading');
      const uniCards = document.querySelectorAll('#phd-university-grid .phd-uni-card');
      const collapseBtn = document.getElementById('phd-collapse-btn');
      const uniInput = document.getElementById('form-university');
      const countrySelect = document.getElementById('form-country');
      const contextBanner = document.getElementById('enquiry-context-banner');
      const contextBannerText = document.getElementById('context-banner-text');

      let currentSelectedCountry = null;

      function selectCountry(countrySlug, countryName, btn) {
        currentSelectedCountry = countrySlug;

        // Update button active styles & ARIA
        countryBtns.forEach((b) => {
          const isTarget = b === btn;
          b.setAttribute('aria-selected', isTarget ? 'true' : 'false');
          if (isTarget) {
            b.classList.add('ring-2', 'ring-brand-blue', 'border-brand-navy', 'bg-brand-bg/60', 'shadow-sm');
            b.classList.remove('bg-white');
            const badge = b.querySelector('.country-badge');
            if (badge) {
              badge.classList.add('bg-brand-navy', 'text-white', 'border-brand-navy');
              badge.classList.remove('bg-brand-bg', 'text-brand-navy');
            }
          } else {
            b.classList.remove('ring-2', 'ring-brand-blue', 'border-brand-navy', 'bg-brand-bg/60', 'shadow-sm');
            b.classList.add('bg-white');
            const badge = b.querySelector('.country-badge');
            if (badge) {
              badge.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy');
              badge.classList.add('bg-brand-bg', 'text-brand-navy');
            }
          }
        });

        // Reveal section
        if (unisSection) {
          unisSection.classList.remove('hidden');
        }

        // Filter cards
        let visibleCount = 0;
        uniCards.forEach((card) => {
          const cardCountry = card.getAttribute('data-country');
          if (cardCountry === countrySlug) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Update heading
        if (headingEl) {
          headingEl.textContent = `Approved Doctoral Universities in ${countryName} (${visibleCount})`;
        }

        // Sync enquiry form country dropdown
        if (countrySelect && countrySlug) {
          countrySelect.value = countrySlug;
          if (contextBanner && contextBannerText) {
            contextBannerText.textContent = `Pre-selected Destination: ${countryName}`;
            contextBanner.classList.remove('hidden');
          }
        }
      }

      countryBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const countrySlug = btn.getAttribute('data-country') || '';
          const countryName = btn.getAttribute('data-country-name') || '';
          if (currentSelectedCountry === countrySlug && unisSection && !unisSection.classList.contains('hidden')) {
            unisSection.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            selectCountry(countrySlug, countryName, btn);
          }
        });
      });

      if (collapseBtn) {
        collapseBtn.addEventListener('click', () => {
          if (unisSection) {
            unisSection.classList.add('hidden');
          }
          currentSelectedCountry = null;
          countryBtns.forEach((b) => {
            b.setAttribute('aria-selected', 'false');
            b.classList.remove('ring-2', 'ring-brand-blue', 'border-brand-navy', 'bg-brand-bg/60', 'shadow-sm');
            b.classList.add('bg-white');
            const badge = b.querySelector('.country-badge');
            if (badge) {
              badge.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy');
              badge.classList.add('bg-brand-bg', 'text-brand-navy');
            }
          });
        });
      }

      // University Card Selection Logic
      uniCards.forEach((card) => {
        card.addEventListener('click', () => {
          const uniName = card.getAttribute('data-university-name') || '';
          const countrySlug = card.getAttribute('data-country') || '';
          const countryName = card.getAttribute('data-country-name') || '';

          if (uniInput) {
            uniInput.value = uniName;
          }

          if (countrySelect && countrySlug) {
            countrySelect.value = countrySlug;
          }

          if (contextBanner && contextBannerText) {
            contextBannerText.textContent = `Pre-selected: ${uniName} (${countryName})`;
            contextBanner.classList.remove('hidden');
          }

          // Smooth scroll to enquiry form
          const enquiryEl = document.getElementById('enquiry');
          if (enquiryEl) {
            enquiryEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const nameInput = document.getElementById('form-full-name');
            if (nameInput) {
              setTimeout(() => nameInput.focus(), 600);
            }
          }
        });
      });
    });
  </script>
</BaseLayout>
