---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import EnquiryForm from '../../components/forms/EnquiryForm.astro';
import { siteConfig } from '../../data/site-config';

const pageTitle = 'PhD Abroad Guidance — Latvia, Lithuania & Portugal | Visa Convention';
const pageDescription = 'Specialized doctoral research proposal and admissions guidance for 7 approved universities in Latvia, Lithuania, and Portugal.';

// Strictly approved PhD destinations (3 countries)
const approvedCountries = [
  { slug: 'latvia', name: 'Latvia', count: 2, flag: '🇱🇻' },
  { slug: 'lithuania', name: 'Lithuania', count: 3, flag: '🇱🇹' },
  { slug: 'portugal', name: 'Portugal', count: 2, flag: '🇵🇹' },
] as const;

// Strictly approved PhD universities (7 universities)
const approvedUniversities = [
  // Latvia (2)
  {
    id: 'rtu',
    name: 'Riga Technical University',
    country: 'Latvia',
    countrySlug: 'latvia',
    city: 'Riga',
    focus: 'Doctoral Engineering, Computer Science, Materials & Logistics',
  },
  {
    id: 'turiba',
    name: 'Turība University',
    country: 'Latvia',
    countrySlug: 'latvia',
    city: 'Riga',
    focus: 'Doctoral Business Administration, Management & Law',
  },
  // Lithuania (3)
  {
    id: 'vu',
    name: 'Vilnius University (VU)',
    country: 'Lithuania',
    countrySlug: 'lithuania',
    city: 'Vilnius',
    focus: 'Historic National Research University, Physics, Life Sciences & Humanities',
  },
  {
    id: 'ktu',
    name: 'Kaunas University of Technology (KTU)',
    country: 'Lithuania',
    countrySlug: 'lithuania',
    city: 'Kaunas',
    focus: 'Doctoral Informatics, Chemical Technology, Electronics & Robotics',
  },
  {
    id: 'vgtu',
    name: 'Vilnius Gediminas Technical University (Vilnius Tech)',
    country: 'Lithuania',
    countrySlug: 'lithuania',
    city: 'Vilnius',
    focus: 'Doctoral Civil, Transport, Mechanical & Environmental Engineering',
  },
  // Portugal (2)
  {
    id: 'ulisboa',
    name: 'University of Lisbon',
    country: 'Portugal',
    countrySlug: 'portugal',
    city: 'Lisbon',
    focus: 'Leading Portuguese Research University & FCT Doctoral Frameworks',
  },
  {
    id: 'uporto',
    name: 'University of Porto',
    country: 'Portugal',
    countrySlug: 'portugal',
    city: 'Porto',
    focus: 'Doctoral Engineering, Biomedical Sciences, Computer Science & Architecture',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Breadcrumbs -->
  <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: 'Services', href: '/services/' },
        { label: 'PhD Abroad', href: '/services/phd/', current: true },
      ]}
    />
  </div>

  <!-- 1. PhD Hero Section -->
  <section class="py-10 sm:py-14 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Hero Copy -->
        <div class="lg:col-span-7 text-left">
          <span class="inline-block px-3.5 py-1 mb-4 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
            Doctoral Research Advisory
          </span>
          <h1 class="text-3xl sm:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-4">
            PhD Abroad Guidance
          </h1>
          <p class="text-lg sm:text-xl font-semibold text-brand-blue mb-4 leading-snug">
            Doctoral Research Guidance in Latvia, Lithuania & Portugal
          </p>
          <p class="text-sm sm:text-base text-brand-muted leading-relaxed mb-6">
            Specialized documentation assistance, research statement structuring, and academic supervisor outreach for doctoral candidates targeting recognized institutions across Latvia, Lithuania, and Portugal.
          </p>

          <!-- Concise Statutory Notice -->
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-brand-muted leading-relaxed mb-6">
            <strong class="text-brand-navy font-bold block mb-1">Advisory Notice:</strong>
            Visa Convention provides independent doctoral application guidance and visa documentation assistance. Doctoral admission and supervisor acceptance depend entirely on faculty departmental evaluation. No admission outcome is or can be guaranteed.
          </div>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4">
            <a
              href="#enquiry"
              class="btn-primary inline-flex items-center gap-2"
            >
              <span>Request PhD Profile Review</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
            <a
              href="#universities"
              class="btn-secondary inline-flex items-center gap-2"
            >
              <span>View 7 Approved Universities</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Hero Image -->
        <div class="lg:col-span-5">
          <div class="relative rounded-3xl overflow-hidden border border-brand-border shadow-card bg-brand-bg aspect-video flex items-center justify-center">
            <img
              src="/assets/images/services/MBBS%20&%20PhD%20Courses%20Abroad.png"
              alt="Visa Convention MBBS & PhD Courses Abroad Educational Guidance"
              width="1670"
              height="813"
              class="w-full h-full object-contain"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Three Compact Country Selectors & 3. Filtered 7 Universities List -->
  <section id="universities" class="py-12 sm:py-16 bg-brand-bg/40 border-b border-brand-border">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header -->
      <div class="mb-8">
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2.5 h-2.5 rounded-full bg-brand-navy"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-muted">Target Destinations</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-brand-navy">
          Approved Doctoral Universities
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-1">
          Select a country to filter the approved 7 doctoral institutions or click any university to pre-fill your consultation request.
        </p>
      </div>

      <!-- 2. Three Compact Country Selectors -->
      <div class="flex flex-wrap items-center gap-2 sm:gap-3 mb-8" role="tablist" aria-label="PhD Target Countries">
        <button
          type="button"
          class="phd-country-filter-btn px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-150 border bg-brand-navy text-white border-brand-navy shadow-xs"
          data-country="all"
          role="tab"
          aria-selected="true"
        >
          <span>All Countries (7 Universities)</span>
        </button>
        {approvedCountries.map((c) => (
          <button
            type="button"
            class="phd-country-filter-btn px-4 py-2.5 rounded-xl font-bold text-xs sm:text-sm transition-all duration-150 border bg-white text-brand-navy border-brand-border hover:border-brand-navy hover:bg-brand-bg/60"
            data-country={c.slug}
            role="tab"
            aria-selected="false"
          >
            <span>{c.flag} {c.name} ({c.count} Universities)</span>
          </button>
        ))}
      </div>

      <!-- 3. Country-Filtered List of the Seven Approved Universities -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="phd-university-grid">
        {approvedUniversities.map((uni, idx) => (
          <div
            class="phd-uni-card group relative p-5 rounded-2xl bg-white border border-brand-border shadow-2xs hover:shadow-md hover:border-brand-navy hover:-translate-y-0.5 transition-all duration-200 flex flex-col justify-between text-left cursor-pointer"
            data-country={uni.countrySlug}
            data-university-name={uni.name}
            data-country-name={uni.country}
          >
            <div>
              <!-- Location Pill -->
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-md bg-brand-bg text-brand-navy font-bold text-xs border border-brand-border/60">
                  <span>📍</span>
                  <span>{uni.country} • {uni.city}</span>
                </span>
                <span class="text-3xs font-bold text-brand-muted/70 uppercase">
                  PhD #{idx + 1}
                </span>
              </div>

              <!-- University Name in Full -->
              <h3 class="font-bold text-base text-brand-navy group-hover:text-brand-blue transition-colors mb-2 leading-snug break-words">
                {uni.name}
              </h3>

              <!-- Focus Area / Details -->
              <p class="text-xs text-brand-muted leading-relaxed">
                {uni.focus}
              </p>
            </div>

            <!-- Action Button -->
            <div class="mt-5 pt-3 border-t border-brand-border/60 flex items-center justify-between text-xs font-bold text-brand-navy group-hover:text-brand-red transition-colors">
              <span>Select for Consultation</span>
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Existing Enquiry Form with Automatic Population -->
  <section id="enquiry" class="py-12 sm:py-16 bg-white">
    <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Advisory Overview & Direct Contacts -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 rounded-3xl bg-brand-bg border border-brand-border">
            <span class="badge-pill mb-3">Doctoral Advisory Desk</span>
            <h2 class="text-2xl font-black text-brand-navy tracking-tight mb-2">
              PhD Admissions Guidance
            </h2>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-6">
              Our postgraduate research counselors evaluate Master's academic profiles, published papers, and target research topics for accredited universities in Latvia, Lithuania, and Portugal.
            </p>

            <div class="space-y-4 text-xs">
              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-white border border-brand-border text-brand-navy flex items-center justify-center font-bold shrink-0">
                  🏢
                </div>
                <div>
                  <strong class="block text-brand-navy font-bold">Hanumangarh Counseling Office</strong>
                  <span class="text-brand-muted">{siteConfig.officeAddress}</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-white border border-brand-border text-brand-navy flex items-center justify-center font-bold shrink-0">
                  📞
                </div>
                <div>
                  <strong class="block text-brand-navy font-bold">Direct Research Desk</strong>
                  <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="text-brand-blue font-bold hover:underline">
                    {siteConfig.phone}
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <div class="w-8 h-8 rounded-lg bg-white border border-brand-border text-emerald-600 flex items-center justify-center font-bold shrink-0">
                  💬
                </div>
                <div>
                  <strong class="block text-brand-navy font-bold">WhatsApp Advisory</strong>
                  <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="text-emerald-700 font-bold hover:underline">
                    Chat on WhatsApp ({siteConfig.phone})
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Side: Enquiry Form Restricted to Latvia, Lithuania, Portugal -->
        <div class="lg:col-span-7">
          <EnquiryForm
            selectedService="phd"
            allowedCountries={['latvia', 'lithuania', 'portugal']}
            title="Request PhD Profile Assessment"
            subtitle="Submit your research focus and academic background for evaluation across approved Latvian, Lithuanian, and Portuguese universities."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Client-side Script for Country Filter & Auto-population -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.phd-country-filter-btn');
      const uniCards = document.querySelectorAll('.phd-uni-card');
      const uniInput = document.getElementById('form-university');
      const countrySelect = document.getElementById('form-country');
      const contextBanner = document.getElementById('enquiry-context-banner');
      const contextBannerText = document.getElementById('context-banner-text');

      // Country Filter Logic
      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const selectedCountry = btn.getAttribute('data-country') || 'all';

          // Update active button classes & ARIA
          filterBtns.forEach((b) => {
            const isTarget = b === btn;
            b.setAttribute('aria-selected', isTarget ? 'true' : 'false');
            if (isTarget) {
              b.classList.remove('bg-white', 'text-brand-navy', 'border-brand-border');
              b.classList.add('bg-brand-navy', 'text-white', 'border-brand-navy', 'shadow-xs');
            } else {
              b.classList.remove('bg-brand-navy', 'text-white', 'border-brand-navy', 'shadow-xs');
              b.classList.add('bg-white', 'text-brand-navy', 'border-brand-border');
            }
          });

          // Filter university cards
          uniCards.forEach((card) => {
            const cardCountry = card.getAttribute('data-country');
            if (selectedCountry === 'all' || cardCountry === selectedCountry) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });

          // Sync country dropdown in enquiry form if specific country selected
          if (countrySelect && selectedCountry !== 'all') {
            countrySelect.value = selectedCountry;
            if (contextBanner && contextBannerText) {
              contextBannerText.textContent = `Pre-selected Destination: ${btn.textContent.trim()}`;
              contextBanner.classList.remove('hidden');
            }
          }
        });
      });

      // University Card Selection Logic
      uniCards.forEach((card) => {
        card.addEventListener('click', () => {
          const uniName = card.getAttribute('data-university-name') || '';
          const countrySlug = card.getAttribute('data-country') || '';
          const countryName = card.getAttribute('data-country-name') || '';

          if (uniInput) {
            uniInput.value = uniName;
          }

          if (countrySelect && countrySlug) {
            countrySelect.value = countrySlug;
          }

          if (contextBanner && contextBannerText) {
            contextBannerText.textContent = `Pre-selected: ${uniName} (${countryName})`;
            contextBanner.classList.remove('hidden');
          }

          // Smooth scroll to enquiry form
          const enquiryEl = document.getElementById('enquiry');
          if (enquiryEl) {
            enquiryEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const nameInput = document.getElementById('form-full-name');
            if (nameInput) {
              setTimeout(() => nameInput.focus(), 600);
            }
          }
        });
      });
    });
  </script>
</BaseLayout>
