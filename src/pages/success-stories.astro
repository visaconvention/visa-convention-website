---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { successStoriesData } from '../data/success-stories';

const { hero, categories, stories } = successStoriesData;
---

<BaseLayout
  title="Verified Outcomes — Visa Convention | Hanumangarh, Rajasthan"
  description="Explore documented university admissions, consular visa grants, and authentic candidate journeys from Visa Convention's Hanumangarh advisory practice."
>
  <!-- Standardized Breadcrumbs Top Spacing -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 page-header-gap pb-2 sm:pb-3">
    <Breadcrumbs items={[{ label: 'Verified Outcomes', href: '/success-stories/', current: true }]} />
  </div>

  <!-- ========================================================================= -->
  <!-- SECTION 1: COMPACT HERO -->
  <!-- ========================================================================= -->
  <section class="pt-2 sm:pt-3 lg:pt-4 pb-6 sm:pb-8 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-2">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-brand-navy tracking-tight leading-tight text-balance">
          {hero.title}
        </h1>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed font-normal max-w-2xl mx-auto">
          {hero.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: DOCUMENTED OUTCOMES GALLERY (MAIN FOCUS) -->
  <!-- ========================================================================= -->
  <section class="py-8 sm:py-10 lg:py-12 max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8" id="stories-section">
    <!-- Filter Bar Header -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-7 pb-4 border-b border-brand-border">
      <div>
        <h2 class="text-xl sm:text-2xl font-black text-brand-navy tracking-tight">
          Documented Case Studies
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted mt-0.5">
          Verified academic admissions, consular permits, and travel documentation.
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2" id="story-filter-container">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat.id}
            class={`px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer min-h-[36px] ${
              idx === 0
                ? 'bg-brand-navy text-white shadow-2xs'
                : 'bg-white border border-brand-border text-brand-navy hover:bg-slate-50'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Stories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="stories-grid">
      {stories.map((story) => (
        <article
          class="story-card card-premium p-5 sm:p-6 rounded-2xl border border-brand-border bg-white shadow-xs hover:border-brand-blue/30 transition-all flex flex-col justify-between"
          data-story-category={story.category}
        >
          <div>
            <!-- Top Badges & Verification Status -->
            <div class="flex items-start justify-between gap-2 mb-3">
              <div class="flex flex-wrap items-center gap-1.5">
                <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-brand-navy bg-brand-bg px-2.5 py-1 rounded-md border border-brand-border">
                  {story.destinationCountry} • {story.yearGranted}
                </span>
                {story.outcomeType && (
                  <span class="inline-block text-[10px] font-bold text-brand-blue bg-brand-blue/10 px-2 py-0.5 rounded-md">
                    {story.outcomeType}
                  </span>
                )}
              </div>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 shrink-0">
                <svg class="w-3 h-3 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>Verified</span>
              </span>
            </div>

            <!-- Institution & Program Level -->
            <div class="mb-3">
              <h3 class="text-base sm:text-lg font-bold text-brand-navy leading-snug">
                {story.institutionName}
              </h3>
              <p class="text-xs text-brand-muted leading-tight mt-0.5">
                {story.courseName}
              </p>
            </div>

            <!-- Client Experience Quote -->
            <blockquote class="text-xs sm:text-sm text-brand-text leading-relaxed italic mb-4 pl-3 border-l-2 border-brand-red font-normal">
              "{story.quote}"
            </blockquote>

            <!-- Documented Milestones -->
            <div class="space-y-1.5 mb-4 pt-3 border-t border-brand-border/60">
              <span class="block text-[10px] font-bold uppercase tracking-wider text-brand-navy">Documented Milestones:</span>
              <div class="flex flex-wrap gap-1.5">
                {story.keyMilestones.map((ms) => (
                  <span class="px-2 py-0.5 rounded bg-brand-bg text-slate-700 border border-brand-border/80 text-[10px] font-semibold">
                    {ms}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Bottom Attribution: Anonymized Candidate & Category -->
          <div class="pt-3 border-t border-brand-border/70 flex items-center justify-between text-xs">
            <div>
              <span class="font-bold text-brand-navy block text-xs">
                Candidate: {story.candidateIdentifier}
              </span>
              <span class="text-[11px] text-brand-muted">
                {story.originCity}
              </span>
            </div>
            <span class="text-[11px] font-semibold text-brand-blue text-right">
              {story.visaCategory}
            </span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: OPTIONAL COMPACT CTA -->
  <!-- ========================================================================= -->
  <section class="py-8 sm:py-10 bg-brand-bg border-t border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center space-y-3">
        <h2 class="text-xl sm:text-2xl font-black text-brand-navy tracking-tight">
          Ready to Plan Your Own Journey?
        </h2>
        <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
          Book an in-person profile evaluation at our Hanumangarh center or request structured guidance for your destination of choice.
        </p>
        <div class="pt-1 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/contact/?service=study-visa"
            class="btn-primary inline-flex items-center gap-2 text-xs sm:text-sm py-2.5 px-5"
          >
            <span>Request Profile Evaluation</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/about/#office"
            class="btn-secondary inline-flex items-center gap-2 text-xs sm:text-sm py-2.5 px-5"
          >
            <span>Visit Our Hanumangarh Office</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function setupStoryFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('#story-filter-container button');
    const cards = document.querySelectorAll<HTMLElement>('.story-card');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selected = btn.dataset.category || 'all';

        // Update active button state
        buttons.forEach((b) => {
          b.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer min-h-[36px] bg-white border border-brand-border text-brand-navy hover:bg-slate-50';
        });
        btn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer min-h-[36px] bg-brand-navy text-white shadow-2xs';

        // Filter cards
        cards.forEach((card) => {
          const cat = card.dataset.storyCategory;
          if (selected === 'all' || cat === selected) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupStoryFilter();
  document.addEventListener('astro:page-load', setupStoryFilter);
</script>
