---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import EnquiryForm from '../components/forms/EnquiryForm.astro';
import { siteConfig } from '../data/site-config';
import { buildWhatsAppLink } from '../utils/whatsapp';

const whatsAppUrl = buildWhatsAppLink({
  customMessage: 'Hello Visa Convention, I am on your contact page and would like to schedule a counseling consultation.',
});
---

<BaseLayout
  title={`Contact Our Office — ${siteConfig.name} | Hanumangarh, Rajasthan`}
  description="Contact Visa Convention in Hanumangarh, Rajasthan. Physical address, telephone, WhatsApp direct chat, office hours, and confidential student visa assessment form."
>
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={[{ label: 'Contact Us', href: '/contact/', current: true }]} />
  </div>

  <section class="py-10 sm:py-14 max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      as="h1"
      badge="Direct Advisory Access"
      title="Connect with Visa Convention"
      description="Visit our consultation center in Hanumangarh, Rajasthan, or submit an assessment request below. Our counseling team will evaluate your case with total confidentiality."
      align="left"
    />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start mt-8">
      <!-- Left Column: Verified Office Information & Channels -->
      <div class="lg:col-span-5 space-y-6">
        <!-- Office Location & Map Card -->
        <div class="bg-white rounded-3xl p-7 sm:p-8 border border-brand-border shadow-xs space-y-6">
          <h3 class="text-xl font-bold text-brand-navy border-b border-brand-border pb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Physical Center in Hanumangarh</span>
          </h3>

          <!-- Address -->
          <div class="space-y-1.5">
            <strong class="block text-xs font-bold uppercase tracking-wider text-brand-muted">Physical Address</strong>
            <p class="text-sm text-brand-navy font-semibold leading-relaxed">
              {siteConfig.officeAddress}
            </p>
            <span class="block text-xs text-brand-muted">District: Hanumangarh • State: Rajasthan • PIN: 335512</span>
            
            <div class="pt-2">
              <a
                href={siteConfig.googleMapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-blue hover:text-brand-navy hover:underline"
              >
                <span>Open in Google Maps for Directions</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Working Hours -->
          <div class="space-y-1.5 pt-4 border-t border-brand-border/70">
            <strong class="block text-xs font-bold uppercase tracking-wider text-brand-muted">Counseling & Desk Hours</strong>
            <p class="text-sm text-brand-navy font-semibold">
              {siteConfig.businessHours}
            </p>
            <span class="block text-xs text-brand-muted">Walk-ins welcomed; advance appointment recommended</span>
          </div>

          <!-- Phone & WhatsApp Direct Links -->
          <div class="space-y-3 pt-4 border-t border-brand-border/70">
            <strong class="block text-xs font-bold uppercase tracking-wider text-brand-muted">Direct Advisory Channels</strong>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <a
                href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
                class="flex items-center gap-2.5 p-3 rounded-xl bg-brand-bg hover:bg-slate-100 border border-brand-border text-xs font-bold text-brand-navy transition-colors"
                id="contact-phone-link"
              >
                <div class="w-7 h-7 rounded-lg bg-white text-brand-navy flex items-center justify-center shadow-2xs">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <span>Call {siteConfig.phone}</span>
              </a>

              <a
                href={whatsAppUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-2.5 p-3 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-xs font-bold text-emerald-900 transition-colors"
                id="contact-whatsapp-link"
              >
                <div class="w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center shadow-2xs">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                    <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.634.06-1.579-.319-.945-.379-1.597-.991-2.228-1.621-.631-.63-1.243-1.282-1.622-2.227-.379-.945-.364-1.267-.319-1.579.05-.333.419-1.026.824-1.17.405-.145.74-.084.975.25.234.334.795 1.706.795 1.706s.069.172.016.326c-.053.154-.15.252-.279.39-.129.138-.28.32-.401.442-.144.143-.298.297-.13.585.167.288.74 1.218 1.589 1.975 1.092.973 1.996 1.267 2.284 1.41.288.143.456.126.626-.067.17-.193.729-.847.923-1.137.194-.29.387-.243.649-.145.262.098 1.666.786 1.954.93.288.144.48.216.55.337.07.121.07.701-.219 1.106zM12 2C6.477 2 2 6.477 2 12c0 1.821.487 3.53 1.338 5.003L2 22l5.127-1.319C8.563 21.528 10.229 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.2c-1.636 0-3.155-.494-4.425-1.341l-.317-.213-3.044.783.811-2.966-.234-.338C3.896 14.806 3.4 13.435 3.4 12 3.4 7.258 7.258 3.4 12 3.4c4.742 0 8.6 3.858 8.6 8.6 0 4.742-3.858 8.6-8.6 8.6z" />
                  </svg>
                </div>
                <span>Chat on WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- Email Contacts -->
          <div class="space-y-1.5 pt-4 border-t border-brand-border/70">
            <strong class="block text-xs font-bold uppercase tracking-wider text-brand-muted">Electronic Mail</strong>
            <div class="text-xs text-brand-navy space-y-1">
              <div>General Inquiries: <a href={`mailto:${siteConfig.email}`} class="font-bold text-brand-blue hover:underline">{siteConfig.email}</a></div>
              <div>Admissions Desk: <a href={`mailto:${siteConfig.admissionsEmail}`} class="font-bold text-brand-blue hover:underline">{siteConfig.admissionsEmail}</a></div>
            </div>
          </div>

          <!-- Social Media Profiles -->
          <div class="space-y-2 pt-4 border-t border-brand-border/70">
            <strong class="block text-xs font-bold uppercase tracking-wider text-brand-muted">Connect On Official Channels</strong>
            <div class="flex items-center gap-2">
              <a href={siteConfig.socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-brand-bg text-brand-navy hover:text-brand-blue hover:bg-slate-100 transition-colors" title="Facebook">
                <span class="sr-only">Facebook</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
              </a>
              <a href={siteConfig.socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-brand-bg text-brand-navy hover:text-brand-red hover:bg-slate-100 transition-colors" title="Instagram">
                <span class="sr-only">Instagram</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
              <a href={siteConfig.socialLinks.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-brand-bg text-brand-navy hover:text-brand-blue hover:bg-slate-100 transition-colors" title="LinkedIn">
                <span class="sr-only">LinkedIn</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
              </a>
              <a href={siteConfig.socialLinks.youtube} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-brand-bg text-brand-navy hover:text-brand-red hover:bg-slate-100 transition-colors" title="YouTube">
                <span class="sr-only">YouTube</span>
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Strict Data Privacy Guarantee Box -->
        <div class="p-6 rounded-3xl bg-slate-900 text-white space-y-3">
          <h4 class="font-bold text-sm text-emerald-400 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <span>Initial Inquiry Privacy Guarantee</span>
          </h4>
          <p class="text-xs text-slate-300 leading-relaxed font-normal">
            We only collect basic contact coordinates necessary to initiate your counseling assessment. We <strong>never request passport scans, Aadhaar numbers, or sensitive financial statements</strong> over initial online forms. Physical document verification is conducted securely in person at our Hanumangarh center.
          </p>
        </div>
      </div>

      <!-- Right Column: Interactive Multi-Service Enquiry Form -->
      <div class="lg:col-span-7">
        <EnquiryForm
          title="Confidential Advisory Assessment"
          subtitle="Select your required service category below. Our counseling team will evaluate your profile and contact you within 24 business hours."
        />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { trackPhoneClick, trackWhatsAppClick } from '../utils/analytics';

  function setupContactTracking() {
    const phoneBtn = document.getElementById('contact-phone-link');
    const waBtn = document.getElementById('contact-whatsapp-link');

    phoneBtn?.addEventListener('click', () => {
      trackPhoneClick({ location: 'contact_page_card' });
    });

    waBtn?.addEventListener('click', () => {
      trackWhatsAppClick({ location: 'contact_page_card' });
    });
  }

  setupContactTracking();
  document.addEventListener('astro:page-load', setupContactTracking);
</script>
