      <h1 class="text-2xl font-bold text-brand-navy mb-4">Redirecting to About Us</h1>
      <p class="text-brand-muted">
        If you are not redirected automatically, please <a href="/about/" class="text-brand-red underline font-bold">click here</a>.
      </p>
    </div>
  </section>
</BaseLayout>
