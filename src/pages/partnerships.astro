---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import ConsultationCTA from '../components/common/ConsultationCTA.astro';
import PartnershipEnquiryForm from '../components/forms/PartnershipEnquiryForm.astro';
import { partnershipsData } from '../data/partnerships';

const { hero, compliancePillars, collaborationTracks, partnerIntegrityPolicy } = partnershipsData;
---

<BaseLayout
  title="Institutional & Regional Partnerships — Visa Convention | Hanumangarh"
  description="Collaborate with Visa Convention. Transparent institutional student recruitment, regional coaching referral agreements, and compliant overseas education partnerships."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={[{ label: 'Partnerships', href: '/partnerships/', current: true }]} />
  </div>

  <!-- Hero Section -->
  <section class="py-12 sm:py-16 lg:py-20 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-brand-blue bg-white px-3.5 py-1.5 rounded-full border border-brand-blue/20 shadow-2xs mb-4">
          {hero.badge}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-6">
          {hero.title}
        </h1>
        <p class="text-base sm:text-lg text-brand-muted leading-relaxed font-normal mb-10 max-w-3xl mx-auto">
          {hero.subtitle}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="#partnership-form-container"
            class="px-6 py-3.5 rounded-xl bg-brand-navy hover:bg-slate-800 text-white font-bold text-xs sm:text-sm shadow-md transition-colors inline-flex items-center gap-2"
          >
            <span>Initiate B2B Inquiry</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </a>
          <a
            href="#collaboration-tracks"
            class="px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-brand-border text-brand-navy font-bold text-xs sm:text-sm shadow-2xs transition-colors"
          >
            Explore Collaboration Tracks
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Institutional Compliance Pillars -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="Compliance Benchmark"
      title="Our Institutional Partnership Standards"
      description="We believe lasting educational partnerships are built on student caliber, procedural compliance, and zero document fraud."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
      {compliancePillars.map((pillar) => (
        <div class="card-premium p-6 sm:p-7 rounded-2xl border border-brand-border bg-white shadow-xs flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 mb-3">
              {pillar.metric}
            </span>
            <h3 class="text-lg font-bold text-brand-navy mb-2.5">
              {pillar.title}
            </h3>
            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 4 Collaboration Pathways -->
  <section class="py-16 sm:py-20 bg-brand-bg border-y border-brand-border" id="collaboration-tracks">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        badge="Collaboration Spectrum"
        title="Who We Partner With"
        description="Structured, compliant engagement pathways tailored for universities, coaching institutes, sub-agents, and travel operators."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
        {collaborationTracks.map((track) => (
          <div class="card-premium p-8 rounded-3xl border border-brand-border bg-white shadow-xs flex flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-4 mb-4">
                <div>
                  <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-brand-blue bg-brand-bg px-2.5 py-1 rounded-md border border-brand-blue/20 mb-2">
                    {track.subtitle}
                  </span>
                  <h3 class="text-xl sm:text-2xl font-bold text-brand-navy leading-snug">
                    {track.title}
                  </h3>
                </div>
                <div class="w-12 h-12 rounded-2xl bg-brand-navy text-white flex items-center justify-center font-bold flex-shrink-0">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
              </div>

              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-6 font-normal">
                {track.description}
              </p>

              <!-- Offerings list -->
              <div class="space-y-2 mb-6">
                <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-navy">What We Deliver:</span>
                <ul class="space-y-1.5 text-xs text-brand-text">
                  {track.offerings.map((offering) => (
                    <li class="flex items-start gap-2">
                      <span class="text-brand-blue font-bold">•</span>
                      <span>{offering}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Eligibility Criteria -->
              <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-700 space-y-1.5 mb-2">
                <span class="block font-bold text-brand-navy uppercase text-[10px] tracking-wider">Partner Requirements:</span>
                <ul class="space-y-1 text-[11px]">
                  {track.eligibilityCriteria.map((crit) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-emerald-700">✓</span>
                      <span>{crit}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-6 border-t border-brand-border/70 mt-6">
              <a
                href="#partnership-form-container"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-red hover:underline"
              >
                <span>Discuss {track.title} Collaboration →</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Authorized Partner Policy Banner (Omission of Unverified Logos Rule) -->
  <section class="py-12 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="p-6 sm:p-8 rounded-3xl bg-white border border-brand-border shadow-xs flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-slate-100 text-brand-navy flex items-center justify-center font-bold flex-shrink-0 mt-1">
        <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="space-y-1.5">
        <h4 class="text-sm font-bold text-brand-navy">
          {partnerIntegrityPolicy.title}
        </h4>
        <p class="text-xs sm:text-sm text-brand-muted leading-relaxed">
          {partnerIntegrityPolicy.content}
        </p>
      </div>
    </div>
  </section>

  <!-- Dedicated Partnership Inquiry Form -->
  <section class="py-12 sm:py-16 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <PartnershipEnquiryForm />
  </section>

  <!-- Final CTA -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <ConsultationCTA
      title="Build a Transparent Admissions Channel"
      subtitle="Connect with our Hanumangarh leadership team to review institutional representation or referral frameworks."
      primaryBtnText="Initiate Partnership Discussion"
      primaryBtnHref="#partnership-form-container"
    />
  </div>
</BaseLayout>
