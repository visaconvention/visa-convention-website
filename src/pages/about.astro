---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { aboutData } from '../data/about';
import { siteConfig } from '../data/site-config';

const { hero, story, whyChooseUs, physicalOffice } = aboutData;
---

<BaseLayout
  title={`Our Story & Office — ${siteConfig.name} | Hanumangarh, Rajasthan`}
  description="Learn about Visa Convention: our ethical visa and study abroad advisory, transparent counseling principles, and physical center in Hanumangarh, Rajasthan."
>
  <!-- Breadcrumbs -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 page-header-gap pb-2 sm:pb-3">
    <Breadcrumbs items={[{ label: 'About Us', href: '/about/', current: true }]} />
  </div>

  <!-- ========================================================================= -->
  <!-- SECTION 1: OUR STORY (EDITORIAL HERO & AUTHENTIC NARRATIVE) -->
  <!-- ========================================================================= -->
  <section class="pt-3 sm:pt-4 lg:pt-5 pb-8 sm:pb-12 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Column: Narrative -->
        <div class="lg:col-span-7 space-y-4 text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg bg-brand-navy/5 border border-brand-navy/10 text-xs font-bold text-brand-navy uppercase tracking-wider">
            {hero.badge}
          </div>
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-brand-navy tracking-tight leading-tight text-balance">
            {hero.title}
          </h1>
          <p class="text-base sm:text-lg font-bold text-brand-blue leading-snug">
            {story.headline}
          </p>
          <div class="space-y-3 text-sm sm:text-base text-brand-text leading-relaxed font-normal">
            {story.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </div>

        <!-- Right Column: Guiding Principles Card -->
        <div class="lg:col-span-5">
          <div class="bg-brand-navy text-white rounded-3xl p-6 sm:p-8 shadow-card relative overflow-hidden border border-brand-navy-light/40">
            <div class="relative z-10 space-y-4">
              <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-brand-red bg-white/10 px-2.5 py-1 rounded-md">
                Guiding Transparency
              </span>
              <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
                Our Counseling Principles
              </h2>
              <ul class="space-y-3.5 text-xs sm:text-sm text-slate-200">
                {story.principles.map((pr) => (
                  <li class="flex items-start gap-2.5">
                    <svg class="w-5 h-5 text-emerald-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                    </svg>
                    <div>
                      <strong class="text-white block font-bold mb-0.5">{pr.title}</strong>
                      <span class="text-slate-300 text-xs leading-relaxed">{pr.description}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 2: WHY VISA CONVENTION (CLEAR, CREDIBLE DIFFERENTIATORS) -->
  <!-- ========================================================================= -->
  <section class="py-8 sm:py-12 lg:py-16 bg-white border-b border-brand-border">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center mb-8 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-brand-navy tracking-tight leading-tight mb-2">
          {whyChooseUs.title}
        </h2>
        <p class="text-sm sm:text-base text-brand-muted leading-relaxed font-normal">
          {whyChooseUs.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
        {whyChooseUs.points.map((pt, idx) => (
          <div class="p-6 sm:p-7 rounded-2xl bg-brand-bg/50 border border-brand-border hover:border-brand-blue/40 shadow-xs transition-all flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-brand-navy text-white flex items-center justify-center font-bold text-sm mb-4 shadow-2xs">
                0{idx + 1}
              </div>
              <h3 class="text-base sm:text-lg font-bold text-brand-navy mb-2 leading-snug">
                {pt.title}
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
                {pt.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- SECTION 3: OUR OFFICE (VERIFIED LOCATION, CONTACT & MAP DIRECTIONS) -->
  <!-- ========================================================================= -->
  <section class="py-8 sm:py-12 lg:py-16 bg-brand-bg" id="office">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Column: Verified Office Info & Contact Action -->
        <div class="lg:col-span-6 space-y-6 text-left">
          <div>
            <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-brand-blue bg-white px-2.5 py-1 rounded-md border border-brand-border mb-2">
              Physical Location
            </span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-brand-navy tracking-tight leading-tight mb-2">
              {physicalOffice.title}
            </h2>
            <p class="text-sm sm:text-base text-brand-muted leading-relaxed font-normal">
              {physicalOffice.subtitle}
            </p>
          </div>

          <!-- Verified Details Card -->
          <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-xs space-y-4 text-xs sm:text-sm">
            <!-- Address -->
            <div>
              <span class="block text-brand-muted uppercase font-bold text-[10px] tracking-wider mb-1">
                Office Address
              </span>
              <div class="font-bold text-brand-navy text-sm leading-relaxed">
                {physicalOffice.addressLines.map((line: string) => (
                  <span class="block">{line}</span>
                ))}
              </div>
            </div>

            <!-- Hours -->
            <div class="pt-3 border-t border-brand-border/70">
              <span class="block text-brand-muted uppercase font-bold text-[10px] tracking-wider mb-1">
                Counseling Hours
              </span>
              <p class="font-semibold text-brand-navy">
                {physicalOffice.businessHours}
              </p>
            </div>

            <!-- Contact Channels -->
            <div class="pt-3 border-t border-brand-border/70 flex flex-wrap gap-6">
              <div>
                <span class="block text-brand-muted uppercase font-bold text-[10px] tracking-wider mb-0.5">
                  Phone / WhatsApp
                </span>
                <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="font-bold text-brand-blue hover:text-brand-navy transition-colors">
                  {siteConfig.phone}
                </a>
              </div>
              <div>
                <span class="block text-brand-muted uppercase font-bold text-[10px] tracking-wider mb-0.5">
                  Email
                </span>
                <a href={`mailto:${siteConfig.email}`} class="font-bold text-brand-blue hover:text-brand-navy transition-colors">
                  {siteConfig.email}
                </a>
              </div>
            </div>
          </div>

          <!-- Clear Primary & Secondary Contact Actions -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href={physicalOffice.googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center gap-2"
            >
              <span>Get Directions on Google Maps</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href="/contact/"
              class="btn-secondary inline-flex items-center gap-2"
            >
              <span>Book In-Person Consultation</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Column: Interactive Google Map / Location Card -->
        <div class="lg:col-span-6">
          <div class="rounded-3xl overflow-hidden border border-brand-border shadow-card bg-white aspect-[4/3] sm:aspect-[16/10] relative">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3463.7661002242095!2d74.32148737637848!3d29.75549047506983!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39142512f716616b%3A0x868b446eaef4f77c!2sDurga%20Market%2C%20Hanumangarh%20Junction%2C%20Rajasthan%20335512!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
              title="Visa Convention Office Location in Hanumangarh Junction"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="w-full h-full"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
