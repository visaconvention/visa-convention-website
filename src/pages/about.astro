---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import ConsultationCTA from '../components/common/ConsultationCTA.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import { aboutData } from '../data/about';
import { servicesData } from '../data/services';
import { siteConfig } from '../data/site-config';

const { hero, story, missionPhilosophy, directorsMessage, teamMembers, physicalOffice, verifiedMilestones } = aboutData;
---

<BaseLayout
  title={`About Us — ${siteConfig.name} | Hanumangarh, Rajasthan`}
  description="Discover Visa Convention: our ethical student counseling mission, transparent visa advisory principles, physical Hanumangarh center, and experienced advisory team."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={[{ label: 'About Us', href: '/about/', current: true }]} />
  </div>

  <!-- Hero Section -->
  <section class="py-12 sm:py-16 lg:py-20 bg-gradient-to-b from-white to-brand-bg border-b border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest text-brand-blue bg-white px-3.5 py-1.5 rounded-full border border-brand-blue/20 shadow-2xs mb-4">
          {hero.badge}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-brand-navy tracking-tight leading-tight mb-6">
          {hero.title}
        </h1>
        <p class="text-base sm:text-lg text-brand-muted leading-relaxed font-normal mb-10 max-w-3xl mx-auto">
          {hero.subtitle}
        </p>

        <!-- Trust Pillars Metric Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl mx-auto text-left">
          {hero.trustPillars.map((pillar) => (
            <div class="bg-white rounded-2xl p-4 border border-brand-border/80 shadow-xs">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-muted mb-1">
                {pillar.label}
              </span>
              <span class="text-base sm:text-lg font-black text-brand-navy">
                {pillar.value}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Business Story & Heritage -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-red">
          <span class="w-2 h-2 rounded-full bg-brand-red animate-pulse"></span>
          <span>Our Origin & Purpose</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-brand-navy tracking-tight leading-snug">
          {story.headline}
        </h2>
        <div class="space-y-4 text-sm sm:text-base text-brand-text leading-relaxed font-normal">
          {story.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </div>

      <!-- Verified Standards Highlight Card -->
      <div class="lg:col-span-5">
        <div class="bg-brand-navy text-white rounded-3xl p-8 sm:p-10 shadow-lg relative overflow-hidden">
          <div class="absolute -right-12 -top-12 w-48 h-48 bg-brand-blue/20 rounded-full blur-2xl pointer-events-none"></div>
          <div class="relative z-10 space-y-6">
            <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-white/80 bg-white/10 px-3 py-1 rounded-md border border-white/20">
              Institutional Baseline
            </span>
            <h3 class="text-2xl font-bold text-white">
              Why Families in Northern Rajasthan Choose Us
            </h3>
            <ul class="space-y-3.5 text-xs sm:text-sm text-slate-200">
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>No Fake Promises:</strong> We will never tell you a visa is 100% guaranteed when sovereign embassies decide outcomes.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Accredited Institutional Catalog:</strong> Direct admission guidance across 1,015+ recognized universities worldwide.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <svg class="w-5 h-5 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span><strong>Transparent Financial Remittances:</strong> Tuition fee remissions processed through authorized banking channels only.</span>
              </li>
            </ul>

            <div class="pt-4 border-t border-white/15 flex items-center justify-between text-xs text-slate-300">
              <span>Established & Operating in Hanumangarh</span>
              <span class="font-bold text-white">Mon–Sat Counseling</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Working Philosophy -->
  <section class="py-16 sm:py-20 bg-brand-bg border-y border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeading
        badge="Operating Philosophy"
        title="Our Mission & Ethical Standards"
        description={missionPhilosophy.mission}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
        {missionPhilosophy.pillars.map((pillar) => (
          <div class="bg-white rounded-2xl p-6 sm:p-7 border border-brand-border shadow-xs flex flex-col justify-between">
            <div>
              <div class="w-10 h-10 rounded-xl bg-brand-bg border border-brand-blue/20 text-brand-blue flex items-center justify-center font-bold mb-4">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-brand-navy mb-2.5">
                {pillar.title}
              </h3>
              <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal">
                {pillar.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Founder / Directorship Welcome Section -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-slate-900 to-brand-navy text-white rounded-3xl p-8 sm:p-12 lg:p-16 shadow-xl relative overflow-hidden">
      <div class="max-w-3xl mx-auto text-center space-y-6">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-brand-red bg-white/10 px-4 py-1.5 rounded-full border border-white/15">
          Executive Leadership
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-white tracking-tight leading-tight">
          {directorsMessage.title}
        </h2>
        <blockquote class="text-base sm:text-xl font-medium text-slate-200 italic leading-relaxed">
          "{directorsMessage.quote}"
        </blockquote>
        <div class="pt-2 text-xs font-semibold text-brand-blue uppercase tracking-wider">
          {directorsMessage.context}
        </div>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl mx-auto leading-relaxed pt-2">
          {directorsMessage.invitation}
        </p>
        <div class="pt-4">
          <a
            href="/contact/"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-brand-red hover:bg-red-700 text-white font-bold text-xs sm:text-sm shadow-md transition-colors"
          >
            <span>Schedule Directorship Consultation</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Functional Advisory & Counseling Team -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="Expertise Across Verticals"
      title="Our Specialized Counseling Practice"
      description="Our advisory practice is structured around rigorous functional expertise, ensuring every student file is evaluated by domain specialists."
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
      {teamMembers.map((member) => (
        <div class="card-premium p-7 sm:p-8 rounded-3xl border border-brand-border bg-white shadow-xs flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div>
                <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-brand-blue bg-brand-bg px-2.5 py-1 rounded-md border border-brand-blue/20 mb-2">
                  {member.department}
                </span>
                <h3 class="text-xl font-bold text-brand-navy leading-snug">
                  {member.roleTitle}
                </h3>
              </div>
              <div class="w-12 h-12 rounded-2xl bg-brand-bg border border-brand-border text-brand-navy font-bold flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-brand-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
            </div>

            <p class="text-xs sm:text-sm text-brand-muted leading-relaxed mb-5 font-normal">
              {member.bio}
            </p>

            <div class="space-y-2 mb-6">
              <span class="block text-[11px] font-bold uppercase tracking-wider text-brand-navy">Core Advisory Responsibilities:</span>
              <ul class="space-y-1.5 text-xs text-brand-text">
                {member.responsibilities.map((resp) => (
                  <li class="flex items-start gap-2">
                    <span class="text-brand-red font-bold">•</span>
                    <span>{resp}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-brand-border/70 flex items-center justify-between text-xs">
            <span class="font-semibold text-slate-600">Specialization:</span>
            <span class="font-bold text-brand-navy text-right">{member.specialization}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Physical Office Showcase — Hanumangarh, Rajasthan -->
  <section class="py-16 sm:py-20 bg-brand-bg border-y border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-brand-blue">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Verified Physical Presence</span>
          </div>

          <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-brand-navy tracking-tight leading-snug">
            Our Physical Advisory Center in Hanumangarh
          </h2>

          <p class="text-sm text-brand-muted leading-relaxed font-normal">
            Trust begins with accountability. Visa Convention operates a permanent, fully equipped consultation center in Hanumangarh, Rajasthan, welcoming walk-in students, parents, and working professionals across the region.
          </p>

          <!-- Address & Hours Card -->
          <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-xs space-y-4 text-xs sm:text-sm">
            <div>
              <span class="block text-brand-muted uppercase font-bold text-[10px] tracking-wider mb-1">Center Address</span>
              <p class="font-bold text-brand-navy text-sm leading-relaxed">
                {physicalOffice.address}
              </p>
            </div>
            <div class="pt-3 border-t border-brand-border/70">
              <span class="block text-brand-muted uppercase font-bold text-[10px] tracking-wider mb-1">Counseling Hours</span>
              <p class="font-semibold text-brand-navy">
                {physicalOffice.businessHours}
              </p>
            </div>
            <div class="pt-3 border-t border-brand-border/70">
              <span class="block text-brand-muted uppercase font-bold text-[10px] tracking-wider mb-1">Appointment Protocol</span>
              <p class="text-slate-600">
                {physicalOffice.consultationMode}
              </p>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 text-xs font-bold text-brand-blue hover:text-brand-navy transition-colors hover:underline"
            >
              <span>Get Directions & Book Walk-in Appointment</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Office Infrastructure Features -->
        <div class="lg:col-span-7">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {physicalOffice.features.map((feat) => (
              <div class="p-6 rounded-2xl bg-white border border-brand-border shadow-xs flex flex-col justify-between">
                <div>
                  <div class="w-9 h-9 rounded-xl bg-brand-bg text-brand-navy flex items-center justify-center font-bold mb-3 border border-brand-border">
                    <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  </div>
                  <h3 class="text-base font-bold text-brand-navy mb-2">
                    {feat.title}
                  </h3>
                  <p class="text-xs text-brand-muted leading-relaxed font-normal">
                    {feat.description}
                  </p>
                </div>
              </div>
            ))}
          </div>

          <!-- Photo Availability Notice Banner -->
          <div class="mt-6 p-5 rounded-2xl bg-slate-100 border border-slate-200 text-xs text-slate-700 leading-relaxed flex items-center gap-3">
            <svg class="w-5 h-5 text-brand-blue flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>
              <strong>Authentic Facility Notice:</strong> We feature genuine office facilities only. Authentic photography sessions of our Hanumangarh center interior are maintained on file and can be inspected in person.
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Verified Capabilities & Milestones -->
  <section class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="Evidence-Based Integrity"
      title="Measurable Institutional Scale"
      description="We measure our reputation not through exaggerated slogans, but through verified operational capabilities and strict compliance."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
      {verifiedMilestones.map((item) => (
        <div class="card-premium p-6 sm:p-7 rounded-2xl border border-brand-border bg-white shadow-xs text-center">
          <div class="text-3xl sm:text-4xl font-black text-brand-navy tracking-tight mb-1.5">
            {item.metric}
          </div>
          <div class="text-sm font-bold text-brand-blue mb-2">
            {item.label}
          </div>
          <p class="text-xs text-brand-muted leading-relaxed">
            {item.detail}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- Six Core Services Summary -->
  <section class="py-16 sm:py-20 bg-brand-bg border-t border-brand-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-10">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-brand-blue">Our Service Spectrum</span>
          <h2 class="text-2xl sm:text-3xl font-bold text-brand-navy mt-1">
            End-to-End International Guidance
          </h2>
        </div>
        <a
          href="/services/"
          class="text-xs font-bold text-brand-blue hover:text-brand-navy hover:underline hidden sm:inline-flex items-center gap-1"
        >
          <span>View Detailed Service Matrix</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {servicesData.slice(0, 6).map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

  <!-- Final Consultation CTA -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <ConsultationCTA
      title="Meet Our Hanumangarh Advisory Team"
      subtitle="Experience honest, uncompromised student visa counseling. Schedule your personal 1-on-1 session at our Hanumangarh center today."
      primaryBtnText="Book Consultation Session"
      primaryBtnHref="/contact/"
    />
  </div>
</BaseLayout>
