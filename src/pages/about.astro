---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/common/SectionHeading.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import ConsultationCTA from '../components/common/ConsultationCTA.astro';
import { siteConfig } from '../data/site-config';
---

<BaseLayout
  title={`About Us — ${siteConfig.name}`}
  description="Learn about Visa Convention, our ethical student counseling mission, transparent visa advisory principles, and our Hanumangarh office."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6">
    <Breadcrumbs items={[{ label: 'About Us', href: '/about/', current: true }]} />
  </div>

  <section class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading
      badge="About Visa Convention"
      title="Integrity, Precision & Global Opportunities"
      description="Established in Hanumangarh, Rajasthan, Visa Convention provides professional guidance for ambitious students, scholars, and international travelers."
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
      <div class="space-y-6 text-brand-text leading-relaxed">
        <h3 class="text-2xl font-bold text-brand-navy">
          Bridging Hanumangarh to the World’s Leading Institutions
        </h3>
        <p class="text-brand-muted">
          Visa Convention was founded to bring transparent, ethical, and high-caliber international education guidance to regional students and families. We believe every aspiring scholar deserves honest profile assessments without inflated promises or deceptive marketing.
        </p>
        <p class="text-brand-muted">
          Our scope encompasses over 35 destination countries, including premier education hubs such as Canada, the United Kingdom, Australia, the United States, Germany, Ireland, and leading European medical faculties.
        </p>

        <div class="p-6 rounded-2xl bg-white border border-brand-border space-y-3">
          <h4 class="font-bold text-brand-navy text-lg flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-brand-red"></span>
            Our Core Principles
          </h4>
          <ul class="space-y-2 text-sm text-brand-text">
            <li class="flex items-start gap-2">
              <strong class="text-brand-navy">• Factual Transparency:</strong> We never promise guaranteed visas; decisions rest solely with embassies.
            </li>
            <li class="flex items-start gap-2">
              <strong class="text-brand-navy">• Direct Institution Matching:</strong> University options are shortlisted strictly on academic merit, budget, and long-term career goals.
            </li>
            <li class="flex items-start gap-2">
              <strong class="text-brand-navy">• Zero Hidden Fees:</strong> Complete fee disclosures before initiating any documentation.
            </li>
          </ul>
        </div>
      </div>

      <div class="bg-brand-navy text-white rounded-3xl p-8 sm:p-12 space-y-6">
        <h3 class="text-2xl font-bold text-white">
          Our Operational Standards
        </h3>
        <p class="text-sm text-gray-300 leading-relaxed">
          We operate in strict adherence to national and international immigration guidelines. Every file undergoes a multi-point documentation check before consulate submission to eliminate clerical discrepancies.
        </p>
        <div class="grid grid-cols-2 gap-6 pt-4 border-t border-white/10">
          <div>
            <span class="block text-3xl font-black text-brand-red">35+</span>
            <span class="text-xs text-gray-300">Countries Guided</span>
          </div>
          <div>
            <span class="block text-3xl font-black text-white">6</span>
            <span class="text-xs text-gray-300">Service Categories</span>
          </div>
        </div>
      </div>
    </div>

    <ConsultationCTA
      title="Consult With Our Advisory Team"
      subtitle="Visit our Hanumangarh office or schedule a comprehensive online counseling session."
    />
  </section>
</BaseLayout>
