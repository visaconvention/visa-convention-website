---
import { buildWhatsAppLink } from '../../utils/whatsapp';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  primaryBtnText?: string;
  primaryBtnHref?: string;
  secondaryBtnText?: string;
  secondaryBtnHref?: string;
  disclaimer?: string;
  class?: string;
}

const {
  badge = 'PERSONALIZED GUIDANCE',
  title = 'Ready to Plan Your Next Step?',
  subtitle = 'Speak with our team about your study abroad, visa or travel requirements.',
  primaryBtnText = 'Request Consultation',
  primaryBtnHref = '/contact/',
  secondaryBtnText = 'Chat on WhatsApp',
  secondaryBtnHref,
  disclaimer = 'Visa decisions are made by the relevant government authorities.',
  class: className = '',
} = Astro.props;

const resolvedSecondaryHref = secondaryBtnHref || buildWhatsAppLink({
  customMessage: 'Hello Visa Convention, I would like to speak with your team about my study abroad, visa or travel requirements.'
});

const isExternal = resolvedSecondaryHref.startsWith('http');
---

<section class={`relative overflow-hidden bg-brand-navy text-white rounded-[16px] p-8 sm:p-10 lg:p-12 shadow-md ${className}`}>
  <!-- Decorative background subtle glow -->
  <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-brand-blue/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-brand-red/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">
    {badge && (
      <span class="inline-block px-3.5 py-1 mb-3.5 text-xs font-bold tracking-widest uppercase rounded-full bg-white/10 text-white border border-white/20">
        {badge}
      </span>
    )}
    
    <h2 class="text-2xl sm:text-3xl lg:text-[2.25rem] font-extrabold text-white tracking-tight leading-tight mb-3 text-balance">
      {title}
    </h2>
    
    <p class="text-sm sm:text-base text-gray-200 mb-7 max-w-xl mx-auto leading-relaxed font-normal">
      {subtitle}
    </p>

    <!-- Side-by-side on desktop, stacked on mobile -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4">
      <a
        href={primaryBtnHref}
        class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-brand-red text-white font-bold text-sm hover:bg-brand-red-hover shadow-sm transition-all duration-150 transform hover:-translate-y-0.5 text-center min-h-[48px] flex items-center justify-center"
      >
        <span>{primaryBtnText}</span>
      </a>
      
      <a
        href={resolvedSecondaryHref}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noopener noreferrer' : undefined}
        class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-white/10 text-white font-bold text-sm hover:bg-white/20 border border-white/30 transition-all duration-150 text-center min-h-[48px] flex items-center justify-center gap-2"
      >
        {isExternal && (
          <svg class="w-4 h-4 fill-current text-emerald-400 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.698.057-2.18-.555-1.776-.732-2.909-2.535-2.997-2.653-.088-.118-.718-.957-.718-1.823 0-.866.452-1.292.613-1.468.161-.176.353-.221.471-.221.118 0 .235.001.338.006.109.005.253-.041.396.302.147.353.501 1.222.545 1.31.044.088.073.191.015.308-.059.117-.088.19-.176.293-.088.103-.186.23-.265.309-.091.09-.187.189-.081.371.106.182.471.777 1.01 1.258.694.619 1.28.811 1.462.902.182.091.289.076.396-.046.107-.123.456-.532.578-.714.122-.182.245-.152.41-.091.166.061 1.054.497 1.236.588.182.091.303.136.348.212.044.076.044.441-.1.846z"/>
          </svg>
        )}
        <span>{secondaryBtnText}</span>
      </a>
    </div>

    {disclaimer && (
      <p class="mt-5 text-xs text-gray-300/90 font-normal">
        {disclaimer}
      </p>
    )}
  </div>
</section>
