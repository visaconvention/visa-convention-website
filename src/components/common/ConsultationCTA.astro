---
interface Props {
  title?: string;
  subtitle?: string;
  primaryBtnText?: string;
  primaryBtnHref?: string;
  secondaryBtnText?: string;
  secondaryBtnHref?: string;
  class?: string;
}

const {
  title = 'Ready to Plan Your Study Abroad or Visa Journey?',
  subtitle = 'Schedule a personal assessment with our Hanumangarh advisory team or begin with a transparent online evaluation.',
  primaryBtnText = 'Book a Free Consultation',
  primaryBtnHref = '/contact/',
  secondaryBtnText = 'Explore Destinations',
  secondaryBtnHref = '/study-abroad/',
  class: className = '',
} = Astro.props;
---

<section class={`relative overflow-hidden bg-brand-navy text-white rounded-3xl p-8 sm:p-12 lg:p-16 my-16 shadow-lg ${className}`}>
  <!-- Decorative background subtle glow -->
  <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-brand-blue/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-brand-red/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <span class="inline-block px-3 py-1 mb-4 text-xs font-bold tracking-widest uppercase rounded-full bg-white/10 text-white border border-white/20">
      Personalized & Transparent Guidance
    </span>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight mb-4">
      {title}
    </h2>
    <p class="text-base sm:text-lg text-gray-200 mb-8 max-w-2xl mx-auto leading-relaxed">
      {subtitle}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={primaryBtnHref}
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-brand-red text-white font-bold text-base hover:bg-brand-red-hover shadow-md transition-all duration-150 transform hover:-translate-y-0.5 text-center"
      >
        {primaryBtnText}
      </a>
      <a
        href={secondaryBtnHref}
        class="w-full sm:w-auto px-8 py-4 rounded-xl bg-white/10 text-white font-bold text-base hover:bg-white/20 border border-white/30 transition-all duration-150 text-center"
      >
        {secondaryBtnText}
      </a>
    </div>

    <p class="mt-6 text-xs text-gray-300">
      Independent advisory. Zero hidden charges. Embassy decisions remain under governmental jurisdiction.
    </p>
  </div>
</section>
