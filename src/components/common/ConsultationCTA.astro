---
interface Props {
  title?: string;
  subtitle?: string;
  primaryBtnText?: string;
  primaryBtnHref?: string;
  secondaryBtnText?: string;
  secondaryBtnHref?: string;
  class?: string;
}

const {
  title = 'Ready to Plan Your Study Abroad or Visa Journey?',
  subtitle = 'Schedule a personal assessment with our Hanumangarh advisory team or begin with a transparent online evaluation.',
  primaryBtnText = 'Book a Free Consultation',
  primaryBtnHref = '/contact/',
  secondaryBtnText = 'Explore Destinations',
  secondaryBtnHref = '/study-abroad/',
  class: className = '',
} = Astro.props;
---

<section class={`relative overflow-hidden bg-brand-navy text-white rounded-2xl p-6 sm:p-8 lg:p-10 shadow-md ${className}`}>
  <!-- Decorative background subtle glow -->
  <div class="absolute -top-24 -right-24 w-72 h-72 rounded-full bg-brand-blue/20 blur-3xl pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -bottom-24 -left-24 w-72 h-72 rounded-full bg-brand-red/10 blur-3xl pointer-events-none" aria-hidden="true"></div>

  <div class="relative z-10 max-w-2xl mx-auto text-center">
    <span class="inline-block px-3 py-1 mb-3 text-xs font-bold tracking-widest uppercase rounded-full bg-white/10 text-white border border-white/20">
      Personalized & Transparent Guidance
    </span>
    <h2 class="text-2xl sm:text-3xl lg:text-[2rem] font-extrabold tracking-tight leading-tight mb-3">
      {title}
    </h2>
    <p class="text-sm sm:text-base text-gray-200 mb-6 max-w-xl mx-auto leading-relaxed">
      {subtitle}
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href={primaryBtnHref}
        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-brand-red text-white font-bold text-sm hover:bg-brand-red-hover shadow-xs transition-all duration-150 transform hover:-translate-y-0.5 text-center min-h-[46px] flex items-center justify-center"
      >
        {primaryBtnText}
      </a>
      <a
        href={secondaryBtnHref}
        class="w-full sm:w-auto px-6 py-3 rounded-xl bg-white/10 text-white font-bold text-sm hover:bg-white/20 border border-white/30 transition-all duration-150 text-center min-h-[46px] flex items-center justify-center"
      >
        {secondaryBtnText}
      </a>
    </div>

    <p class="mt-4 text-xs text-gray-300/90">
      Independent advisory. Sovereign consular decisions remain under official government jurisdiction.
    </p>
  </div>
</section>
