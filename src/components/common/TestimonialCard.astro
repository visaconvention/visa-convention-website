---
import type { Testimonial } from '../../types';

interface Props {
  testimonial: Testimonial;
  class?: string;
}

const { testimonial, class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-2xl p-6 sm:p-8 border border-brand-border shadow-xs flex flex-col justify-between ${className}`}>
  <div>
    <!-- Rating or Quote Icon -->
    <div class="text-brand-red mb-4">
      <svg class="w-8 h-8 opacity-80" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
      </svg>
    </div>
    <p class="text-brand-text text-sm sm:text-base leading-relaxed italic mb-6">
      "{testimonial.quote}"
    </p>
  </div>

  <div class="pt-4 border-t border-brand-border flex items-center justify-between">
    <div>
      <div class="font-bold text-brand-navy text-sm sm:text-base">
        {testimonial.studentName}
      </div>
      <div class="text-xs text-brand-muted">
        {testimonial.institutionName} • {testimonial.destinationCountry}
      </div>
    </div>
    {testimonial.verified && (
      <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200">
        Verified Student
      </span>
    )}
  </div>
</div>
