---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
}

const {
  badge,
  title,
  description,
  align = 'center',
  class: className = '',
  as: HeadingTag = 'h2',
} = Astro.props;

const alignmentClasses = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-3xl mb-12 ${alignmentClasses} ${className}`}>
  {badge && (
    <span class="inline-block px-3.5 py-1 mb-3 text-xs font-semibold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
      {badge}
    </span>
  )}
  <HeadingTag class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight">
    {title}
  </HeadingTag>
  {description && (
    <p class="mt-4 text-base sm:text-lg text-brand-muted leading-relaxed">
      {description}
    </p>
  )}
</div>
