---
interface Props {
  badge?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
}

const {
  badge,
  title,
  description,
  align = 'center',
  class: className = '',
  as: HeadingTag = 'h2',
} = Astro.props;

const isLeft = align === 'left';
const containerAlignment = isLeft ? 'section-heading-left' : 'section-heading-centered';
---

<div class={`mb-10 sm:mb-12 ${containerAlignment} ${className}`}>
  {badge && (
    <span class="badge-pill mb-3">
      {badge}
    </span>
  )}
  <HeadingTag class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
    {title}
  </HeadingTag>
  {description && (
    <p class="mt-3.5 text-base sm:text-lg text-brand-muted leading-relaxed font-normal">
      {description}
    </p>
  )}
</div>
