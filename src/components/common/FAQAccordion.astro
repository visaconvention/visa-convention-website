---
import type { FAQItem } from '../../types';

interface Props {
  faqs: FAQItem[];
  class?: string;
}

const { faqs, class: className = '' } = Astro.props;
---

<div class={`space-y-4 max-w-3xl mx-auto ${className}`}>
  {faqs.map((faq, index) => (
    <details
      class="group border border-brand-border rounded-xl bg-white p-5 transition-all duration-200 [&_summary::-webkit-details-marker]:hidden"
      open={index === 0}
    >
      <summary class="flex items-center justify-between cursor-pointer list-none select-none text-left font-bold text-brand-navy hover:text-brand-blue transition-colors">
        <span class="text-base sm:text-lg pr-4">{faq.question}</span>
        <span class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-bg flex items-center justify-center text-brand-navy group-open:rotate-180 transition-transform duration-200">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <div class="mt-4 pt-3 border-t border-brand-border/60 text-brand-muted text-sm sm:text-base leading-relaxed">
        {faq.answer}
      </div>
    </details>
  ))}
</div>
