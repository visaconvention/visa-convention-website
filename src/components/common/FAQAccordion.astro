---
import type { FAQItem } from '../../types';

interface Props {
  faqs: FAQItem[];
  class?: string;
  allCollapsed?: boolean;
}

const { faqs, class: className = '', allCollapsed = false } = Astro.props;
---

<div class={`space-y-3.5 ${className}`}>
  {faqs.map((faq, index) => (
    <details
      class="group border border-brand-border rounded-xl bg-white p-4 sm:p-5 transition-all duration-200 [&_summary::-webkit-details-marker]:hidden"
      open={!allCollapsed && index === 0}
    >
      <summary class="flex items-center justify-between cursor-pointer list-none select-none text-left font-bold text-brand-navy hover:text-brand-blue transition-colors">
        <span class="text-sm sm:text-base font-bold pr-3 leading-snug">{faq.question}</span>
        <span class="flex-shrink-0 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-brand-bg flex items-center justify-center text-brand-navy group-open:rotate-180 transition-transform duration-200">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </span>
      </summary>
      <div class="mt-3 pt-3 border-t border-brand-border/60 text-brand-muted text-xs sm:text-sm leading-relaxed">
        {faq.answer}
      </div>
    </details>
  ))}
</div>
