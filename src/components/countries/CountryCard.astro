---
import type { Country } from '../../types';

interface Props {
  country: Country;
  class?: string;
  showImage?: boolean;
}

const { country, class: className = '', showImage = true } = Astro.props;

// Friendly flag representation using flagCode or fallback
const flagCode = country.flagCode || country.isoCode || 'GL';
const imagePath = `/assets/images/destinations/${country.slug}.jpg`;

// Set of verified destination photography assets available
const DESTINATIONS_WITH_PHOTOS = new Set([
  'canada',
  'united-kingdom',
  'australia',
  'usa',
  'germany',
  'ireland',
]);

const hasImage = showImage && DESTINATIONS_WITH_PHOTOS.has(country.slug);

// Specific alt texts for recognizable photography
const ALT_TEXTS: Record<string, string> = {
  'usa': 'New York City skyline, United States',
  'canada': 'Vancouver cityscape and university faculties, Canada',
  'united-kingdom': 'London historic skyline and universities, United Kingdom',
  'australia': 'Sydney Harbour and higher education institutions, Australia',
  'germany': 'Historic architecture and premier universities, Germany',
  'ireland': 'Dublin cityscape and technology education hub, Ireland',
};

const altText = ALT_TEXTS[country.slug] || `${country.name} study destination scenery and universities`;

// Complete, polished descriptions without truncation or ellipses
const POLISHED_DESCRIPTIONS: Record<string, string> = {
  'canada': 'World-class research universities, diverse academic communities, and structured post-study work pathways.',
  'united-kingdom': 'Historic global institutions, intensive degree programs, and comprehensive graduate career opportunities.',
  'australia': 'Top-ranked international universities, exceptional student support, and generous post-study work rights.',
  'usa': 'The world’s largest higher education network, renowned faculties, and extensive academic specializations.',
  'germany': 'Tuition-free public universities, premier engineering curricula, and strong post-graduation employment options.',
  'ireland': 'European technology and research hub offering world-recognized degrees in an English-speaking environment.',
};

const cardDescription = POLISHED_DESCRIPTIONS[country.slug] || country.shortDescription || country.shortSummary;
---

<div
  class={`card-premium overflow-hidden flex flex-col justify-between group country-card h-full min-w-0 rounded-2xl border border-brand-border bg-white shadow-2xs hover:shadow-md hover:border-brand-navy transition-all duration-200 ${className}`}
  data-country-card
  data-country-name={country.name.toLowerCase()}
  data-continent={country.continent.toLowerCase()}
  data-featured={country.featured ? 'true' : 'false'}
>
  {hasImage && (
    <div class="relative h-44 sm:h-48 w-full overflow-hidden bg-brand-bg border-b border-brand-border">
      <img
        src={imagePath}
        alt={altText}
        width="600"
        height="338"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
      />
    </div>
  )}

  <!-- Card Body Area -->
  <div class="p-6 text-left flex-1 flex flex-col justify-between">
    <div>
      {!hasImage && (
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-brand-bg text-brand-navy flex items-center justify-center font-extrabold text-xs border border-brand-border shadow-2xs group-hover:bg-brand-navy group-hover:text-white transition-colors">
            {flagCode}
          </div>
          <div>
            <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors leading-none text-left">
              {country.name}
            </h3>
            <span class="text-xs text-brand-subtle mt-1 block text-left">{country.continent}</span>
          </div>
        </div>
      )}

      {hasImage && (
        <h3 class="text-xl sm:text-2xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors leading-tight mb-2.5 text-left">
          {country.name}
        </h3>
      )}

      <p class="text-xs sm:text-sm text-brand-muted leading-relaxed font-normal text-left">
        {cardDescription}
      </p>
    </div>

    <!-- Bottom Action Row: One clear primary link -->
    <div class="pt-5 mt-4 border-t border-brand-border/70 flex items-center justify-between text-xs font-bold">
      <a
        href={`/study-abroad/${country.slug}/`}
        class="inline-flex items-center gap-1.5 text-brand-navy group-hover:text-brand-red font-bold text-xs sm:text-sm transition-colors"
      >
        <span>Explore {country.name}</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>
