---
import type { Country } from '../../types';

interface Props {
  country: Country;
  class?: string;
  showImage?: boolean;
}

const { country, class: className = '' } = Astro.props;

// Friendly flag representation using flagCode or fallback
const flagCode = country.flagCode || country.isoCode || 'GL';
const flagSrc = country.flagSvg || `/assets/flags/${flagCode.toLowerCase()}.svg`;
---

<div
  class={`card-premium group country-card h-full min-w-0 rounded-xl border border-brand-border bg-white shadow-2xs hover:shadow-md hover:border-brand-navy hover:-translate-y-0.5 transition-all duration-200 ${className}`}
  data-country-card
  data-country-name={country.name.toLowerCase()}
  data-continent={country.continent.toLowerCase()}
  data-featured={country.featured ? 'true' : 'false'}
>
  <a
    href={`/study-abroad/${country.slug}/`}
    class="flex flex-col justify-between h-full p-3 sm:p-3.5 text-left focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue rounded-xl min-h-[82px] sm:min-h-[88px]"
    aria-label={`Explore study opportunities in ${country.name}`}
  >
    <!-- Top Row: Official Flag + Navigation Indicator -->
    <div class="flex items-center justify-between gap-2 mb-2.5">
      <div class="w-8 h-6 sm:w-9 sm:h-6.5 rounded overflow-hidden shadow-2xs border border-slate-200/90 bg-slate-50 flex items-center justify-center shrink-0">
        <img
          src={flagSrc}
          alt={`Flag of ${country.name}`}
          width="36"
          height="26"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-brand-bg flex items-center justify-center text-brand-subtle group-hover:bg-brand-navy group-hover:text-white transition-colors shrink-0">
        <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </div>

    <!-- Bottom Row: Country Name -->
    <div class="mt-auto">
      <span class="text-xs sm:text-sm font-bold text-brand-navy group-hover:text-brand-blue transition-colors leading-tight line-clamp-2 block">
        {country.name}
      </span>
    </div>
  </a>
</div>
