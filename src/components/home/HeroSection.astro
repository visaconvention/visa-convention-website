---
interface Props {
  headline?: string;
  subheadline?: string;
  description?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  headline = 'Explore the World with Visa Convention',
  subheadline = 'STUDY ABROAD, VISA & TRAVEL SERVICES',
  description = 'Structured guidance for university admissions across 35+ countries, consular visa dossiers, and flight reservations from our Hanumangarh counseling practice.',
  primaryCtaText = 'Explore Study Abroad',
  primaryCtaHref = '/study-abroad/',
  secondaryCtaText = 'Explore Services',
  secondaryCtaHref = '#services',
} = Astro.props;
---

<!--
  Hero Section — Visa Convention
  Layout: Centered, high-authority typographic composition
  Design: Full-width responsive centered layout, zero external images
  Desktop target height: ~380–460px content-driven
-->
<section class="hero-centered-section bg-gradient-to-b from-[#EAF4FF] via-[#F5F8FC] to-white border-b border-brand-border py-8 sm:py-9 lg:py-10">
  <div class="site-container">
    <div class="max-w-[920px] mx-auto text-center px-3 sm:px-4">

      <!-- Eyebrow / Small Heading -->
      <p class="text-xs sm:text-sm md:text-[15px] font-bold uppercase tracking-wider md:tracking-widest text-brand-blue mb-2.5 sm:mb-3">
        {subheadline}
      </p>

      <!-- Main Headline H1 -->
      <h1 class="text-[2.15rem] min-[390px]:text-[2.45rem] sm:text-5xl md:text-6xl lg:text-[66px] xl:text-[70px] font-black text-brand-navy tracking-tight leading-[1.08] sm:leading-[1.1] text-balance mb-3.5 sm:mb-4">
        {headline === 'Explore the World with Visa Convention' ? (
          <>
            Explore the World
            <span class="block sm:inline"> </span>
            <br class="hidden sm:inline" />
            with <span class="text-brand-red">Visa Convention</span>
          </>
        ) : (
          headline
        )}
      </h1>

      <!-- Supporting Description -->
      <p class="text-[15px] sm:text-base md:text-[19px] lg:text-[20px] text-brand-muted leading-relaxed font-normal max-w-[700px] mx-auto text-balance mb-5 sm:mb-6">
        {description}
      </p>

      <!-- Centered CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4 max-w-md sm:max-w-none mx-auto">
        <a
          href={primaryCtaHref}
          class="btn-primary text-center px-6 py-3.5 sm:px-7 sm:py-3.5 text-sm sm:text-base min-h-[48px] w-full sm:w-auto shadow-sm hover:shadow-md transition-all flex items-center justify-center gap-2 rounded-xl"
        >
          <span>{primaryCtaText}</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href={secondaryCtaHref}
          class="btn-outline text-center px-6 py-3.5 sm:px-7 sm:py-3.5 text-sm sm:text-base min-h-[48px] w-full sm:w-auto bg-white hover:bg-brand-bg transition-all flex items-center justify-center rounded-xl"
        >
          <span>{secondaryCtaText}</span>
        </a>
      </div>

    </div>
  </div>
</section>
