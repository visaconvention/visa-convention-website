---
interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  description?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  eyebrow,
  headline = 'Explore the World with Visa Convention',
  subheadline = 'Study Abroad, Visa & Travel Services',
  description = 'Structured guidance for university admissions, consular visa files, and flight reservations from our Hanumangarh counseling office.',
  primaryCtaText = 'Explore Services',
  primaryCtaHref = '#services',
  secondaryCtaText = 'Contact Us',
  secondaryCtaHref = '/contact/',
  imageSrc = '/assets/images/hero-landmarks.jpg',
  imageAlt = 'World iconic landmarks including the Statue of Liberty, Big Ben, Eiffel Tower, and Sydney Opera House',
} = Astro.props;
---

<!--
  Hero Section — Visa Convention
  Layout: Custom two-column grid (text ~52% | image ~48%)
  Atmosphere: Sky Blue light gradient (#EAF4FF) fading to white
  Desktop targets (1366px):
    Hero height  : ~460–490px content-led
    Image width  : ~510px (pinned via max-w on right col)
    Image height : ~425px (aspect-ratio 6/5)
    Text column  : ~590–610px
    Gap          : ~40px (clamp 32–48px)
  Mobile: single column, text first, image ~260px tall
-->
<section class="bg-gradient-to-b from-[#EAF4FF] via-[#F5F8FC] to-white border-b border-brand-border py-6 sm:py-8 lg:py-10">
  <div class="site-container">
    <div class="hero-grid">

      <!-- ── Left: Copy & CTAs (~52%) ───────────────────────────────────── -->
      <div class="hero-content space-y-4 sm:space-y-5">

        <!-- Location label & trust tag (only rendered if eyebrow passed) -->
        {eyebrow && (
          <div class="flex items-center gap-2">
            <span class="inline-block px-3 py-1 text-xs font-bold tracking-wider uppercase rounded-full bg-white text-brand-navy border border-brand-border shadow-2xs">
              {eyebrow}
            </span>
          </div>
        )}

        <div>
          <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-blue mb-2">
            {subheadline}
          </p>
          <h1 class="text-[2rem] min-[420px]:text-[2.3rem] sm:text-[2.9rem] lg:text-[3.35rem] font-black text-brand-navy tracking-tight leading-[1.08] text-balance">
            Explore the World with <span class="text-brand-red">Visa Convention</span>
          </h1>
        </div>

        <p class="text-base sm:text-[1.08rem] text-brand-muted leading-relaxed max-w-[52ch] font-normal">
          {description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3.5 pt-1">
          <a
            href={primaryCtaHref}
            class="btn-primary text-center px-7 py-3.5 text-sm min-h-[50px] shadow-sm hover:shadow-md transition-all flex items-center gap-2"
          >
            <span>{primaryCtaText}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href={secondaryCtaHref}
            class="btn-outline text-center px-7 py-3.5 text-sm min-h-[50px] bg-white hover:bg-brand-bg transition-all"
          >
            <span>{secondaryCtaText}</span>
          </a>
        </div>
      </div>

      <!-- ── Right: Four-Landmark Hero Visual (~48%) ───────────────────── -->
      <div class="hero-image-wrap">
        <div class="hero-image-frame">
          <img
            src={imageSrc}
            alt={imageAlt}
            width="700"
            height="583"
            class="hero-image"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <!-- Subtle editorial caption badge -->
          <div class="absolute bottom-3 left-3 right-3 text-left pointer-events-none">
            <span class="inline-block px-2.5 py-1 rounded-md bg-brand-navy/85 text-[10px] font-bold uppercase tracking-wider text-white backdrop-blur-xs border border-white/20">
              New York • London • Paris • Sydney
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ── Hero Grid ──────────────────────────────────────────────────── */
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: clamp(1.75rem, 3vw, 2.5rem);
  }

  @media (min-width: 1024px) {
    .hero-grid {
      /* Text column fills ~52%; image column capped at ~510px (~48%) */
      grid-template-columns: 1fr minmax(0, 510px);
      gap: clamp(2rem, 3.5vw, 3rem);
    }
  }

  /* ── Content Column ─────────────────────────────────────────────── */
  .hero-content {
    min-width: 0;
    text-align: left;
  }

  /* ── Image Frame ────────────────────────────────────────────────── */
  .hero-image-wrap {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hero-image-wrap {
      justify-self: end;
    }
  }

  .hero-image-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 1.25rem;       /* 20px refined corner */
    border: 1px solid var(--color-brand-border);
    background-color: var(--color-brand-bg);
    box-shadow: 0 4px 20px -2px rgba(16, 42, 83, 0.08);
    aspect-ratio: 6 / 5;
  }

  @media (max-width: 1023px) {
    .hero-image-frame {
      max-height: 320px;
    }
  }

  @media (max-width: 479px) {
    .hero-image-frame {
      max-height: 260px;
    }
  }

  .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }
</style>
