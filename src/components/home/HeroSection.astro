---
interface Props {
  eyebrow?: string;
  headline?: string;
  subheadline?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  imageSrc?: string;
  imageAlt?: string;
}

const {
  eyebrow = 'VISA CONVENTION · HANUMANGARH',
  headline = 'Your Plans Abroad Start Here.',
  subheadline = 'Explore study destinations, find universities, and get assistance with visas and travel.',
  primaryCtaText = 'Explore Services',
  primaryCtaHref = '#services',
  secondaryCtaText = 'Contact Our Team',
  secondaryCtaHref = '/contact/',
  imageSrc = '/assets/images/hero-education.jpg',
  imageAlt = 'Students studying at an international university campus',
} = Astro.props;
---

<section class="bg-white border-b border-brand-border py-12 sm:py-16 lg:py-20">
  <div class="site-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center text-left">
      <!-- Left Column: Copy & Actions (~58% on desktop) -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-bg text-brand-navy border border-brand-border mb-4">
            <span class="w-2 h-2 rounded-full bg-brand-red"></span>
            {eyebrow}
          </span>
          <h1 class="text-3xl sm:text-5xl lg:text-[3.25rem] font-black text-brand-navy tracking-tight leading-[1.15] text-balance">
            {headline}
          </h1>
        </div>

        <p class="text-base sm:text-lg text-brand-muted leading-relaxed max-w-[54ch] font-normal">
          {subheadline}
        </p>

        <!-- Primary Action Buttons -->
        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href={primaryCtaHref}
            class="btn-primary text-center px-6 py-3.5 text-sm"
          >
            <span>{primaryCtaText}</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
            </svg>
          </a>
          <a
            href={secondaryCtaHref}
            class="btn-outline text-center px-6 py-3.5 text-sm"
          >
            <span>{secondaryCtaText}</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Authentic Educational Visual (~42% on desktop) -->
      <div class="lg:col-span-5 relative">
        <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-brand-border shadow-lg bg-brand-bg">
          <img
            src={imageSrc}
            alt={imageAlt}
            width="600"
            height="450"
            class="w-full h-[300px] sm:h-[360px] lg:h-[400px] object-cover"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>
