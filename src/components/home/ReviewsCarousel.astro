<style>
  /* ========================================================================= */
  /* CONTINUOUS LEFT-TO-RIGHT MARQUEE ANIMATION                                 */
  /* ========================================================================= */
  /*
   * Left-to-Right Translation:
   * Moves from calc(-100% - 1.5rem) to 0.
   * Group 2 starts at 0 at 0% keyframe.
   * Group 1 reaches 0 at 100% keyframe.
   * Loop wraps seamlessly with 0ms visual snap or jump.
   */
  .marquee-group {
    animation: marquee-ltr 52s linear infinite;
    will-change: transform;
  }

  @keyframes marquee-ltr {
    0% {
      transform: translateX(calc(-100% - 1.5rem));
    }
    100% {
      transform: translateX(0);
    }
  }

  /* Interaction Pause: Hover, Focus-Within, Active Drag */
  .marquee-track-wrapper:hover .marquee-group,
  .marquee-track-wrapper:focus-within .marquee-group,
  .marquee-track-wrapper[data-paused="true"] .marquee-group {
    animation-play-state: paused !important;
  }

  /* Accessible Card Hover Lift */
  .review-card {
    will-change: transform, box-shadow;
  }
  @media (hover: hover) and (pointer: fine) {
    .review-card:hover {
      transform: translateY(-4px);
    }
  }

  /* Reduced Motion Alternative: Accessible Static Horizontal Scroll */
  @media (prefers-reduced-motion: reduce) {
    .marquee-group {
      animation: none !important;
    }
    .marquee-track-wrapper {
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
    }
    .review-card {
      scroll-snap-align: start;
    }
    #marquee-group-clone {
      display: none !important;
    }
  }
</style>

<script>
  function setupMovingReviews() {
    const section = document.getElementById('reviews-section') as HTMLElement | null;
    const wrapper = document.getElementById('reviews-marquee-wrapper') as HTMLElement | null;
    const pauseBtn = document.getElementById('reviews-pause-toggle-btn');
    const pauseLabel = document.getElementById('reviews-pause-label');
    const pauseIcon = document.getElementById('reviews-pause-icon');
    const nudgeLeftBtn = document.getElementById('reviews-nudge-left-btn');
    const nudgeRightBtn = document.getElementById('reviews-nudge-right-btn');
    const viewport = document.getElementById('reviews-marquee-viewport');

    if (!wrapper || !section) return;

    // 1. Entrance Fade-In via IntersectionObserver
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              section.classList.remove('opacity-95');
              section.classList.add('opacity-100');
              observer.unobserve(section);
            }
          });
        },
        { threshold: 0.15 }
      );
      observer.observe(section);
    }

    // 2. Visible Pause / Resume Control
    let isUserPaused = false;

    function updatePauseState(paused: boolean) {
      isUserPaused = paused;
      wrapper?.setAttribute('data-paused', paused ? 'true' : 'false');
      if (pauseBtn) {
        pauseBtn.setAttribute('aria-pressed', paused ? 'true' : 'false');
        pauseBtn.setAttribute('aria-label', paused ? 'Resume client reviews auto-scroll' : 'Pause client reviews auto-scroll');
      }
      if (pauseLabel) {
        pauseLabel.textContent = paused ? 'Resume' : 'Pause';
      }
      if (pauseIcon) {
        if (paused) {
          // Play Icon (triangle)
          pauseIcon.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8 5v14l11-7z"/>
            </svg>
          `;
        } else {
          // Pause Icon (two vertical bars)
          pauseIcon.innerHTML = `
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
            </svg>
          `;
        }
      }
    }

    pauseBtn?.addEventListener('click', () => {
      updatePauseState(!isUserPaused);
    });

    // 3. Manual Nudge Buttons (Smooth directional offset)
    let autoResumeTimeout: ReturnType<typeof setTimeout> | null = null;

    function handleNudge(direction: 'left' | 'right') {
      // Temporarily pause animation so user can inspect
      wrapper?.setAttribute('data-paused', 'true');
      
      // If wrapper is horizontally scrollable (e.g. reduced motion or mobile touch)
      const scrollAmount = direction === 'left' ? -360 : 360;
      wrapper?.scrollBy({ left: scrollAmount, behavior: 'smooth' });

      // Auto-resume after 4 seconds only if user hasn't explicitly locked pause
      if (!isUserPaused) {
        if (autoResumeTimeout) clearTimeout(autoResumeTimeout);
        autoResumeTimeout = setTimeout(() => {
          if (!isUserPaused) {
            wrapper?.setAttribute('data-paused', 'false');
          }
        }, 4000);
      }
    }

    nudgeLeftBtn?.addEventListener('click', () => handleNudge('left'));
    nudgeRightBtn?.addEventListener('click', () => handleNudge('right'));

    // 4. Keyboard Arrow Key Navigation
    viewport?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        handleNudge('left');
      } else if (e.key === 'ArrowRight') {
        handleNudge('right');
      } else if (e.key === ' ' || e.key === 'Enter') {
        if (document.activeElement === pauseBtn) return;
        // Spacebar toggles pause when viewport is focused
        e.preventDefault();
        updatePauseState(!isUserPaused);
      }
    });

    // 5. Touch swipe handling for mobile
    let touchStartX = 0;
    wrapper.addEventListener('touchstart', (e) => {
      touchStartX = e.touches[0].clientX;
      wrapper.setAttribute('data-paused', 'true');
    }, { passive: true });

    wrapper.addEventListener('touchend', (e) => {
      const touchEndX = e.changedTouches[0].clientX;
      const diffX = touchStartX - touchEndX;
      if (Math.abs(diffX) > 40) {
        handleNudge(diffX > 0 ? 'right' : 'left');
      } else if (!isUserPaused) {
        wrapper.setAttribute('data-paused', 'false');
      }
    }, { passive: true });
  }

  // Initialize on load and Astro page transitions
  setupMovingReviews();
  document.addEventListener('astro:page-load', setupMovingReviews);
</script>
