---
import { successStoriesData } from '../../data/success-stories';

const reviews = successStoriesData.stories;
---

<section
  id="reviews-section"
  class="py-12 sm:py-16 bg-white border-t border-brand-border relative overflow-hidden transition-all duration-700 opacity-95"
  aria-label="Client Reviews and Verified Outcomes"
>
  <div class="site-container">
    <!-- Section Heading & Controls Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 text-left gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3.5 py-1 mb-2.5 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20 shadow-2xs">
          <span class="w-2 h-2 rounded-full bg-brand-red animate-pulse" aria-hidden="true"></span>
          <span>Verified Client Outcomes</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
          Real Journeys, Verified Approvals
        </h2>
        <p class="mt-2 text-sm sm:text-base text-brand-muted max-w-[64ch]">
          Authentic feedback from students and families across Rajasthan who processed admissions, APS verifications, and visa dossiers through Visa Convention.
        </p>
      </div>

      <!-- Controls: Pause/Resume Toggle + Directional Nudges + All Link -->
      <div class="flex items-center flex-wrap gap-2.5 self-start md:self-end">
        <a
          href="/success-stories/"
          class="text-xs font-bold text-brand-blue hover:text-brand-navy hover:underline hidden lg:inline-block mr-2"
        >
          All Case Studies ({reviews.length}) →
        </a>

        <!-- Visible Pause / Resume Control -->
        <button
          type="button"
          id="reviews-pause-toggle-btn"
          class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl border border-brand-border bg-white text-brand-navy hover:bg-brand-bg hover:border-brand-navy transition-colors text-xs font-bold shadow-2xs focus:outline-hidden focus:ring-2 focus:ring-brand-blue cursor-pointer"
          aria-label="Pause client reviews auto-scroll"
          aria-pressed="false"
        >
          <span id="reviews-pause-icon" class="text-brand-blue" aria-hidden="true">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"/>
            </svg>
          </span>
          <span id="reviews-pause-label">Pause</span>
        </button>

        <!-- Manual Nudge Controls -->
        <div class="flex items-center gap-1.5" role="group" aria-label="Manual review navigation">
          <button
            type="button"
            id="reviews-nudge-left-btn"
            class="w-9 h-9 rounded-xl border border-brand-border bg-white text-brand-navy hover:bg-brand-bg hover:border-brand-navy flex items-center justify-center transition-colors shadow-2xs focus:outline-hidden focus:ring-2 focus:ring-brand-blue cursor-pointer"
            aria-label="Scroll reviews left"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            id="reviews-nudge-right-btn"
            class="w-9 h-9 rounded-xl border border-brand-border bg-white text-brand-navy hover:bg-brand-bg hover:border-brand-navy flex items-center justify-center transition-colors shadow-2xs focus:outline-hidden focus:ring-2 focus:ring-brand-blue cursor-pointer"
            aria-label="Scroll reviews right"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Full-Bleed Continuous Left-to-Right Marquee Viewport -->
  <div
    id="reviews-marquee-viewport"
    class="marquee-viewport relative w-full overflow-hidden py-4 select-none"
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Client Reviews Continuous Carousel"
  >
    <!-- Subtle Edge Gradient Masks for Smooth Ingress / Egress -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 sm:w-20 bg-gradient-to-r from-white to-transparent z-10" aria-hidden="true"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 sm:w-20 bg-gradient-to-l from-white to-transparent z-10" aria-hidden="true"></div>

    <!-- The Infinite Marquee Wrapper -->
    <div
      id="reviews-marquee-wrapper"
      class="marquee-track-wrapper flex items-stretch overflow-x-hidden touch-pan-x"
      data-paused="false"
    >
      <!-- Set 1: Fully Accessible Interactive Review Cards -->
      <div class="marquee-group flex gap-6 shrink-0 py-2 pl-4 sm:pl-6" id="marquee-group-primary">
        {reviews.map((story, index) => (
          <article
            class="review-card shrink-0 w-[290px] sm:w-[350px] md:w-[390px] rounded-2xl bg-brand-bg/60 border border-brand-border p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1 hover:border-brand-blue hover:bg-white text-left group"
            tabindex="0"
            aria-label={`Review ${index + 1} of ${reviews.length}: ${story.candidateIdentifier} for ${story.destinationCountry}`}
          >
            <div>
              <!-- Card Header: Rating Stars & Destination Pill -->
              <div class="flex items-center justify-between mb-4 gap-2">
                <!-- 5 Authentic Stars -->
                <div class="flex items-center gap-0.5 text-amber-500" aria-label="5 out of 5 stars">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                </div>

                <!-- Destination Pill -->
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-white text-brand-navy border border-brand-border shadow-2xs">
                  {story.destinationCountry}
                </span>
              </div>

              <!-- Top Quote Icon -->
              <div class="text-brand-red mb-3" aria-hidden="true">
                <svg class="w-6 h-6 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
              </div>

              <!-- Genuine Review Quote -->
              <p class="text-brand-text text-xs sm:text-sm leading-relaxed italic mb-5 line-clamp-4 group-hover:line-clamp-none transition-all duration-300">
                "{story.quote}"
              </p>
            </div>

            <!-- Author & Institutional Attribution -->
            <div class="pt-4 border-t border-brand-border/70 flex items-end justify-between gap-2">
              <div class="min-w-0">
                <div class="font-bold text-brand-navy text-xs sm:text-sm flex items-center gap-1.5">
                  <span>{story.candidateIdentifier}</span>
                  <span class="text-[11px] font-normal text-brand-muted truncate">({story.originCity})</span>
                </div>
                <div class="text-[11px] text-brand-muted truncate mt-0.5 font-medium" title={story.institutionName}>
                  {story.institutionName}
                </div>
              </div>

              <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                ✓ Verified
              </span>
            </div>
          </article>
        ))}
      </div>

      <!-- Set 2: Seamless Infinite Duplicate Clones (Hidden from Screen Readers & Tab Order) -->
      <div class="marquee-group flex gap-6 shrink-0 py-2 pl-6 pr-6" aria-hidden="true" id="marquee-group-clone">
        {reviews.map((story) => (
          <article
            class="review-card shrink-0 w-[290px] sm:w-[350px] md:w-[390px] rounded-2xl bg-brand-bg/60 border border-brand-border p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-lg hover:-translate-y-1 hover:border-brand-blue hover:bg-white text-left group pointer-events-auto"
            tabindex="-1"
          >
            <div>
              <div class="flex items-center justify-between mb-4 gap-2">
                <div class="flex items-center gap-0.5 text-amber-500">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                </div>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-white text-brand-navy border border-brand-border shadow-2xs">
