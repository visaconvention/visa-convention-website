  <div class="site-container">
    <!-- DPDP Statutory Notice & Mobile View Link -->
    <div class="mt-6 flex flex-col sm:flex-row items-center justify-between text-xs text-brand-muted gap-3 text-center sm:text-left">
      <p class="max-w-[70ch]">
        Candidate names are abbreviated to initials in strict compliance with the Digital Personal Data Protection Act. Visa issuance decisions remain the sole prerogative of sovereign host-country embassies.
      </p>
      <a
        href="/success-stories/"
        class="font-bold text-brand-blue hover:text-brand-navy hover:underline shrink-0"
