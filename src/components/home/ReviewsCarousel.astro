            <div class="pt-4 border-t border-brand-border/70 flex items-end justify-between gap-2">
              <div class="min-w-0">
                <div class="font-bold text-brand-navy text-xs sm:text-sm flex items-center gap-1.5">
                  <span>{story.candidateIdentifier}</span>
                  <span class="text-[11px] font-normal text-brand-muted truncate">({story.originCity})</span>
                </div>
                <div class="text-[11px] text-brand-muted truncate mt-0.5 font-medium" title={story.institutionName}>
                  {story.institutionName}
