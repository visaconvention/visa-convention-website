---
import { successStoriesData } from '../../data/success-stories';

const reviews = successStoriesData.stories;
---

<section class="py-12 sm:py-16 bg-white border-t border-brand-border" aria-label="Client Reviews">
  <div class="site-container">
    <!-- Section Heading -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 text-left">
      <div>
        <span class="inline-block px-3.5 py-1 mb-2.5 text-xs font-bold tracking-wider uppercase rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20 shadow-2xs">
          Client Experiences
        </span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-brand-navy tracking-tight leading-tight text-balance">
          What Our Clients Say
        </h2>
        <p class="mt-2 text-sm sm:text-base text-brand-muted max-w-[64ch]">
          Authentic journeys and verified outcomes from students and families who prepared their admissions and visa dossiers with Visa Convention.
        </p>
      </div>

      <!-- Controls & Link -->
      <div class="mt-4 sm:mt-0 flex items-center gap-3">
        <a href="/success-stories/" class="text-xs font-bold text-brand-blue hover:text-brand-navy hover:underline hidden md:inline-block">
          All Case Studies ({reviews.length}) →
        </a>

        <!-- Carousel Navigation Controls -->
        <div class="flex items-center gap-2" role="group" aria-label="Review Carousel Controls">
          <button
            type="button"
            id="review-prev-btn"
            class="w-11 h-11 rounded-xl border border-brand-border bg-white text-brand-navy hover:bg-brand-bg hover:border-brand-navy flex items-center justify-center transition-colors shadow-2xs focus:outline-hidden focus:ring-2 focus:ring-brand-blue"
            aria-label="Previous review"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <button
            type="button"
            id="review-next-btn"
            class="w-11 h-11 rounded-xl border border-brand-border bg-white text-brand-navy hover:bg-brand-bg hover:border-brand-navy flex items-center justify-center transition-colors shadow-2xs focus:outline-hidden focus:ring-2 focus:ring-brand-blue"
            aria-label="Next review"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Carousel Viewport -->
    <div
      id="reviews-carousel-viewport"
      class="overflow-hidden relative rounded-2xl touch-pan-y"
      tabindex="0"
      aria-roledescription="carousel"
      aria-label="What Our Clients Say Carousel"
    >
      <div
        id="reviews-carousel-track"
        class="flex transition-transform duration-350 ease-out"
        style="transform: translateX(0%);"
      >
        {reviews.map((story, index) => (
          <div
            class="review-slide shrink-0 w-full md:w-1/2 lg:w-1/3 px-2 sm:px-3 box-border"
            role="group"
            aria-roledescription="slide"
            aria-label={`Review ${index + 1} of ${reviews.length}`}
          >
            <div class="card-premium h-full p-6 sm:p-7 rounded-2xl bg-brand-bg border border-brand-border flex flex-col justify-between text-left">
              <div>
                <!-- Top Quote Icon & Program Badge -->
                <div class="flex items-center justify-between mb-4">
                  <div class="text-brand-red" aria-hidden="true">
                    <svg class="w-7 h-7 opacity-85" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                    </svg>
                  </div>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-bold bg-white text-brand-navy border border-brand-border">
                    {story.destinationCountry}
                  </span>
                </div>

                <!-- Quote Text -->
                <p class="text-brand-text text-sm sm:text-[15px] leading-relaxed italic mb-6">
                  "{story.quote}"
                </p>
              </div>

              <!-- Author / Candidate Info -->
              <div class="pt-4 border-t border-brand-border/70 flex items-end justify-between gap-3">
                <div class="min-w-0">
                  <div class="font-bold text-brand-navy text-sm sm:text-base flex items-center gap-1.5">
                    <span>{story.candidateIdentifier}</span>
                    <span class="text-[11px] font-normal text-brand-muted truncate">({story.originCity})</span>
                  </div>
                  <div class="text-xs text-brand-muted truncate mt-0.5" title={story.institutionName}>
                    {story.institutionName}
                  </div>
                </div>

                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-extrabold bg-emerald-50 text-emerald-700 border border-emerald-200 shrink-0">
                  ✓ Verified
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Carousel Indicator Dots & Counter -->
    <div class="flex items-center justify-between mt-6 pt-2">
      <div id="review-dots-container" class="flex items-center gap-2">
        {reviews.map((_, i) => (
          <button
            type="button"
            class="review-dot w-2.5 h-2.5 rounded-full transition-all focus:outline-hidden focus:ring-2 focus:ring-brand-blue"
            data-index={i}
            aria-label={`Go to slide ${i + 1}`}
          />
        ))}
      </div>

      <div class="text-xs text-brand-muted">
        <span id="review-current-index" class="font-bold text-brand-navy">1</span>
        <span> / </span>
        <span>{reviews.length}</span>
      </div>
    </div>

    <!-- Privacy & Statutory Notice -->
    <p class="mt-6 text-center text-xs text-brand-muted">
      Candidate names are abbreviated to initials in strict compliance with the Digital Personal Data Protection Act. Visa issuance decisions remain the sole prerogative of sovereign embassies.
    </p>
  </div>
</section>

<script>
  function setupReviewsCarousel() {
    const track = document.getElementById('reviews-carousel-track') as HTMLElement | null;
    const viewport = document.getElementById('reviews-carousel-viewport');
    const prevBtn = document.getElementById('review-prev-btn');
    const nextBtn = document.getElementById('review-next-btn');
    const dots = document.querySelectorAll('.review-dot');
    const currentIndexEl = document.getElementById('review-current-index');

    if (!track || !viewport) return;

    const slides = track.querySelectorAll('.review-slide');
    const totalSlides = slides.length;
    let currentIndex = 0;

    function getVisibleSlidesCount() {
      if (window.innerWidth >= 1024) return 3;
      if (window.innerWidth >= 768) return 2;
      return 1;
    }

    function getMaxIndex() {
      const visible = getVisibleSlidesCount();
      return Math.max(0, totalSlides - visible);
    }

    function updateCarousel() {
      if (!track) return;
      const visible = getVisibleSlidesCount();
      const maxIndex = getMaxIndex();
      if (currentIndex > maxIndex) currentIndex = maxIndex;
      if (currentIndex < 0) currentIndex = 0;

      const slideWidthPercent = 100 / visible;
      const offsetPercent = currentIndex * slideWidthPercent;
      track.style.transform = `translateX(-${offsetPercent}%)`;

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('w-6', 'bg-brand-navy');
          dot.classList.remove('w-2.5', 'bg-slate-300');
        } else {
          dot.classList.remove('w-6', 'bg-brand-navy');
          dot.classList.add('w-2.5', 'bg-slate-300');
        }
      });

      // Update counter
      if (currentIndexEl) {
        currentIndexEl.textContent = String(currentIndex + 1);
      }

      // Update button states
      if (prevBtn) {
        if (currentIndex <= 0) {
          prevBtn.classList.add('opacity-40', 'cursor-not-allowed');
        } else {
          prevBtn.classList.remove('opacity-40', 'cursor-not-allowed');
        }
      }

      if (nextBtn) {
        if (currentIndex >= maxIndex) {
          nextBtn.classList.add('opacity-40', 'cursor-not-allowed');
        } else {
          nextBtn.classList.remove('opacity-40', 'cursor-not-allowed');
        }
      }
    }

    function nextSlide() {
      if (currentIndex < getMaxIndex()) {
        currentIndex++;
        updateCarousel();
      }
    }

    function prevSlide() {
      if (currentIndex > 0) {
        currentIndex--;
        updateCarousel();
      }
    }

    nextBtn?.addEventListener('click', nextSlide);
    prevBtn?.addEventListener('click', prevSlide);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
        currentIndex = Math.min(idx, getMaxIndex());
        updateCarousel();
      });
    });

    // Touch swipe support
    let startX = 0;
    let endX = 0;

    viewport.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    viewport.addEventListener('touchend', (e) => {
      endX = e.changedTouches[0].clientX;
      const diff = startX - endX;
      if (Math.abs(diff) > 40) {
        if (diff > 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
    }, { passive: true });

    // Keyboard support
    viewport.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        nextSlide();
      } else if (e.key === 'ArrowLeft') {
        prevSlide();
      }
    });

    // Window resize handler
    window.addEventListener('resize', updateCarousel);

    // Initial render
    updateCarousel();
  }

  setupReviewsCarousel();
  document.addEventListener('astro:page-load', setupReviewsCarousel);
</script>
