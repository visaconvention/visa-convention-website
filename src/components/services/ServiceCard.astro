---
import type { Service } from '../../types';

interface Props {
  service: Service;
  class?: string;
}

const { service, class: className = '' } = Astro.props;
---

<div class={`card-premium p-7 sm:p-8 flex flex-col justify-between group h-full min-w-0 ${className}`}>
  <div>
    <!-- Top Icon & Category Tag -->
    <div class="flex items-center justify-between mb-6">
      <div class="w-12 h-12 rounded-xl bg-brand-bg text-brand-navy flex items-center justify-center group-hover:bg-brand-navy group-hover:text-white transition-colors duration-200 shadow-2xs">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <span class="badge-pill">
        Advisory Service
      </span>
    </div>

    <!-- Title & Short Description -->
    <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-3 leading-snug text-left">
      {service.title}
    </h3>
    <p class="text-sm text-brand-muted leading-relaxed mb-6 font-normal text-left">
      {service.shortDescription}
    </p>

    <!-- Key Offerings Checklist -->
    <ul class="space-y-2.5 mb-6 text-left">
      {service.keyOfferings.slice(0, 3).map((offering) => (
        <li class="flex items-start gap-2.5 text-xs sm:text-sm text-brand-text">
          <div class="w-4 h-4 rounded-full bg-brand-red/10 text-brand-red flex items-center justify-center flex-shrink-0 mt-0.5">
            <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <span class="leading-snug">{offering}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom Link (Bottom-aligned across rows) -->
  <div class="pt-5 border-t border-brand-border mt-auto">
    <a
      href={`/services/${service.slug}/`}
      class="inline-flex items-center gap-2 text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
    >
      <span>Explore Guidance Details</span>
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-150" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
