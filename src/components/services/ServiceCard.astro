---
import type { Service } from '../../types';

interface Props {
  service: Service;
  class?: string;
}

const { service, class: className = '' } = Astro.props;
---

<div class={`bg-white rounded-2xl p-6 sm:p-8 border border-brand-border shadow-xs hover:shadow-md hover:border-brand-blue/40 transition-all duration-200 flex flex-col justify-between group ${className}`}>
  <div>
    <!-- Icon Placeholder & Badge -->
    <div class="flex items-center justify-between mb-5">
      <div class="w-12 h-12 rounded-xl bg-brand-bg text-brand-navy flex items-center justify-center group-hover:bg-brand-navy group-hover:text-white transition-colors duration-200">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-bg text-brand-blue border border-brand-blue/20">
        Verified Service
      </span>
    </div>

    <!-- Title & Subtitle -->
    <h3 class="text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors mb-2">
      {service.title}
    </h3>
    <p class="text-sm text-brand-muted leading-relaxed mb-6">
      {service.shortDescription}
    </p>

    <!-- Key Offerings Bullets -->
    <ul class="space-y-2 mb-6">
      {service.keyOfferings.slice(0, 3).map((offering) => (
        <li class="flex items-start gap-2 text-xs sm:text-sm text-brand-text">
          <svg class="w-4 h-4 text-brand-red flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span>{offering}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom Link -->
  <div class="pt-4 border-t border-brand-border">
    <a
      href={`/services/${service.slug}/`}
      class="inline-flex items-center gap-1.5 text-sm font-bold text-brand-navy group-hover:text-brand-red transition-colors"
    >
      <span>Learn Guidance Details</span>
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</div>
