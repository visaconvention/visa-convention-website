---
import type { WorkOccupation } from '../../types';

interface Props {
  occupations: WorkOccupation[];
}

const { occupations } = Astro.props;
---

<div class="occupation-accordion-root w-full">
  <!-- Compact 2-Column Responsive Occupation Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5 sm:gap-3 items-start" role="region" aria-label="Occupational Focus Areas">
    {occupations.map((occ) => (
      <div
        class="occ-item rounded-xl border border-brand-border bg-white overflow-hidden shadow-2xs self-start w-full transition-all"
        data-occ-id={occ.id}
        data-occ-title={occ.title}
      >
        <!-- Collapsed Row: 48-56px high, shows Occupation Name + Chevron only (No badges) -->
        <button
          type="button"
          class="occ-toggle w-full min-h-[48px] sm:min-h-[54px] px-3.5 sm:px-4 py-2.5 text-left flex items-center justify-between gap-2.5 hover:bg-brand-bg/40 transition-colors focus-visible:outline-2 focus-visible:outline-brand-blue cursor-pointer"
          aria-expanded="false"
          aria-controls={`occ-details-${occ.id}`}
        >
          <span class="text-xs sm:text-sm font-semibold text-brand-navy leading-snug">
            {occ.title}
          </span>

          <svg
            class="occ-chevron w-4 h-4 text-brand-muted transition-transform duration-200 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Expanded Details Drawer (Collapsed by default, only one open at a time) -->
        <div
          id={`occ-details-${occ.id}`}
          class="occ-details hidden px-3.5 sm:px-4 pb-3.5 pt-2 bg-brand-bg/25 border-t border-brand-border/40 space-y-3"
        >
          <div class="flex items-center justify-between gap-2">
            <span class="text-[10px] font-bold text-brand-blue uppercase tracking-wider bg-brand-bg px-2 py-0.5 rounded border border-brand-border/60">
              {occ.sector}
            </span>
          </div>

          <p class="text-xs text-brand-muted leading-relaxed">
            {occ.description}
          </p>

          <div class="space-y-2">
            <!-- Sample Roles -->
            <div class="p-2.5 rounded-lg bg-white border border-brand-border/80">
              <span class="text-[10px] font-bold text-brand-navy block mb-1 uppercase tracking-wider">
                Sample Roles:
              </span>
              <div class="flex flex-wrap gap-1">
                {occ.sampleRoles.map((role) => (
                  <span class="text-[10px] bg-brand-bg px-1.5 py-0.5 rounded text-brand-navy border border-brand-border/50">
                    {role}
                  </span>
                ))}
              </div>
            </div>

            <!-- Document Readiness -->
            <div class="p-2.5 rounded-lg bg-white border border-brand-border/80">
              <span class="text-[10px] font-bold text-brand-navy block mb-1 uppercase tracking-wider">
                Prerequisite Documentation:
              </span>
              <ul class="text-[11px] text-brand-muted space-y-0.5">
                {occ.documentReadiness.map((doc) => (
                  <li class="flex items-start gap-1">
                    <span class="text-brand-blue font-bold">✓</span>
                    <span>{doc}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Select & Apply Action Button -->
          <div>
            <button
              type="button"
              class="occ-select-btn inline-flex items-center justify-center gap-1.5 w-full px-3 py-2 rounded-xl bg-brand-navy hover:bg-brand-blue text-white text-xs font-bold transition-all shadow-2xs cursor-pointer"
              data-occ-id={occ.id}
              data-occ-title={occ.title}
            >
              <span>Select {occ.title} & Apply to Form</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  function initOccupationAccordion() {
    const root = document.querySelector('.occupation-accordion-root');
    if (!root || root.hasAttribute('data-initialized')) return;
    root.setAttribute('data-initialized', 'true');

    const items = root.querySelectorAll('.occ-item');
    const selectBtns = root.querySelectorAll('.occ-select-btn');

    items.forEach((item) => {
      const toggle = item.querySelector('.occ-toggle') as HTMLButtonElement | null;
      const details = item.querySelector('.occ-details') as HTMLElement | null;
      const chevron = item.querySelector('.occ-chevron') as HTMLElement | null;

      if (!toggle || !details) return;

      toggle.addEventListener('click', () => {
        const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

        // Collapse all other occupations
        if (!isExpanded) {
          items.forEach((other) => {
            if (other === item) return;
            const otherToggle = other.querySelector('.occ-toggle') as HTMLButtonElement | null;
            const otherDetails = other.querySelector('.occ-details') as HTMLElement | null;
            const otherChevron = other.querySelector('.occ-chevron') as HTMLElement | null;

            if (otherToggle && otherDetails) {
              otherToggle.setAttribute('aria-expanded', 'false');
              otherDetails.classList.add('hidden');
              if (otherChevron) otherChevron.classList.remove('rotate-180');
            }
          });
        }

        const nextState = !isExpanded;
        toggle.setAttribute('aria-expanded', String(nextState));
        details.classList.toggle('hidden', !nextState);
        if (chevron) chevron.classList.toggle('rotate-180', nextState);
      });
    });

    // Populate Enquiry Form
    selectBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-occ-title') || '';
        const messageField = document.getElementById('form-message') as HTMLTextAreaElement | null;
        const contextBanner = document.getElementById('enquiry-context-banner');
        const contextBannerText = document.getElementById('context-banner-text');

        if (title && messageField) {
          const prefix = `[Work Visa Occupation: ${title}] `;
          if (!messageField.value.includes(prefix)) {
            messageField.value = prefix + messageField.value.replace(/\[Work Visa Occupation:.*?\]\s*/g, '');
          }
        }

        if (contextBanner && contextBannerText) {
          contextBannerText.textContent = `Enquiring for: WORK VISA • ${title.toUpperCase()}`;
          contextBanner.classList.remove('hidden');
        }

        const enquirySection = document.getElementById('enquiry');
        if (enquirySection) {
          enquirySection.scrollIntoView({ behavior: 'smooth' });
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initOccupationAccordion);
</script>
