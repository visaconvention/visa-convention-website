---
import { siteConfig } from '../../data/site-config';
import { getFeaturedCountries } from '../../data/countries';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const featuredCountries = getFeaturedCountries();

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav aria-label="Main Navigation" class="hidden xl:flex items-center gap-1 xl:gap-1.5 shrink-0">
  {siteConfig.nav.map((item) => {
    const hasChildren = item.children && item.children.length > 0;
    const isStudyAbroad = item.label === 'Study Abroad';
    const isVisaServices = item.label === 'Visa Services';
    const isAbout = item.label === 'About';
    const active = isActive(item.href);

    // 1. Study Abroad Rich Mega-Menu Dropdown
    if (isStudyAbroad && hasChildren) {
      return (
        <div class="relative group shrink-0">
          <button
            type="button"
            class={`flex items-center gap-1 px-3 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all duration-150 ${
              active
                ? 'text-brand-navy bg-brand-bg font-bold shadow-2xs'
                : 'text-brand-text hover:text-brand-blue hover:bg-brand-bg/60'
            }`}
            aria-expanded="false"
          >
            <span class="whitespace-nowrap">{item.label}</span>
            <svg class="w-3.5 h-3.5 text-brand-subtle group-hover:rotate-180 group-hover:text-brand-blue transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Study Abroad Mega-Menu -->
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[640px] opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl shadow-2xl border border-brand-border p-6 ring-1 ring-black/5">
              <div class="pb-3 mb-4 border-b border-brand-border flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">
                    International Education Pathways
                  </span>
                  <p class="text-xs text-brand-muted">
                    Explore universities, medical faculties, and degree admissions across 35+ nations
                  </p>
                </div>
                <a href="/study-abroad/" class="text-xs font-bold text-brand-red hover:underline">
                  All 35+ Countries →
                </a>
              </div>

              <div class="grid grid-cols-12 gap-6">
                <!-- Left Column: Core Pathways -->
                <div class="col-span-7 space-y-1">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-brand-muted mb-2 px-2">
                    Guidance Verticals
                  </div>
                  {item.children?.map((child) => (
                    <a
                      href={child.href}
                      class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-brand-bg hover:border-brand-blue/30 border border-transparent transition-all group/item"
                    >
                      <div class="w-7 h-7 rounded-lg bg-brand-bg text-brand-navy group-hover/item:bg-brand-navy group-hover/item:text-white flex items-center justify-center flex-shrink-0 transition-colors mt-0.5 text-xs font-bold">
                        →
                      </div>
                      <div>
                        <span class="block text-xs sm:text-sm font-bold text-brand-navy group-hover/item:text-brand-blue leading-snug">
                          {child.label}
                        </span>
                        {child.description && (
                          <span class="block text-[11px] text-brand-muted line-clamp-1">
                            {child.description}
                          </span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>

                <!-- Right Column: Top Featured Destinations -->
                <div class="col-span-5 border-l border-brand-border/70 pl-5 space-y-2">
                  <div class="text-[11px] font-bold uppercase tracking-wider text-brand-muted mb-2">
                    Top Destinations
                  </div>
                  <div class="grid grid-cols-1 gap-1.5">
                    {featuredCountries.slice(0, 6).map((country) => (
                      <a
                        href={`/study-abroad/${country.slug}/`}
                        class="flex items-center gap-2 p-1.5 rounded-lg hover:bg-brand-bg text-xs font-semibold text-brand-navy hover:text-brand-blue transition-colors group/dest"
                      >
                        <span class="w-6 h-6 rounded bg-brand-bg text-brand-navy font-black text-3xs flex items-center justify-center flex-shrink-0 group-hover/dest:bg-brand-navy group-hover/dest:text-white transition-colors">
                          {country.flagCode}
                        </span>
                        <span class="truncate">{country.name}</span>
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Bottom Footer Bar -->
              <div class="pt-3 mt-4 border-t border-brand-border bg-brand-bg/50 -mx-6 -mb-6 p-4 rounded-b-2xl flex items-center justify-between text-xs text-brand-muted">
                <span>Looking for institution-specific shortlists?</span>
                <a href="/universities/" class="font-bold text-brand-red hover:underline">
                  Search 1,000+ Universities →
                </a>
              </div>
            </div>
          </div>
        </div>
      );
    }

    // 2. Visa Services Dropdown
    if (isVisaServices && hasChildren) {
      return (
        <div class="relative group shrink-0">
          <button
            type="button"
            class={`flex items-center gap-1 px-3 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all duration-150 ${
              active
                ? 'text-brand-navy bg-brand-bg font-bold shadow-2xs'
                : 'text-brand-text hover:text-brand-blue hover:bg-brand-bg/60'
            }`}
            aria-expanded="false"
          >
            <span class="whitespace-nowrap">{item.label}</span>
            <svg class="w-3.5 h-3.5 text-brand-subtle group-hover:rotate-180 group-hover:text-brand-blue transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Visa Services Dropdown -->
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[460px] opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl shadow-2xl border border-brand-border p-6 ring-1 ring-black/5">
              <div class="pb-3 mb-2 border-b border-brand-border flex items-center justify-between">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">
                    Visa Advisory & Compliance
                  </span>
                  <p class="text-xs text-brand-muted">
                    Tourist, work, and documentation assistance
                  </p>
                </div>
                <a href="/services/" class="text-xs font-bold text-brand-red hover:underline">
                  Compare Services →
                </a>
              </div>

              <div class="space-y-1">
                {item.children?.map((child) => (
                  <a
                    href={child.href}
                    class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-brand-bg hover:border-brand-blue/30 border border-transparent transition-all group/item"
                  >
                    <div class="w-7 h-7 rounded-lg bg-brand-bg text-brand-navy group-hover/item:bg-brand-navy group-hover/item:text-white flex items-center justify-center flex-shrink-0 transition-colors mt-0.5 text-xs font-bold">
                      ✓
                    </div>
                    <div>
                      <span class="block text-xs sm:text-sm font-bold text-brand-navy group-hover/item:text-brand-blue leading-snug">
                        {child.label}
                      </span>
                      {child.description && (
                        <span class="block text-xs text-brand-muted mt-0.5">
                          {child.description}
                        </span>
                      )}
                    </div>
                  </a>
                ))}
              </div>

              <div class="pt-3 mt-3 border-t border-brand-border bg-brand-bg/50 -mx-6 -mb-6 p-4 rounded-b-2xl flex items-center justify-between text-xs text-brand-muted">
                <span>Direct Embassy Appointment Prep</span>
                <a href="/contact/" class="font-bold text-brand-red hover:underline">
                  Book Desk Consultation →
                </a>
              </div>
            </div>
          </div>
        </div>
      );
    }

    // 3. About Dropdown
    if (isAbout && hasChildren) {
      return (
        <div class="relative group shrink-0">
          <button
            type="button"
            class={`flex items-center gap-1 px-3 py-2 rounded-xl text-sm font-semibold whitespace-nowrap transition-all duration-150 ${
              active
                ? 'text-brand-navy bg-brand-bg font-bold shadow-2xs'
                : 'text-brand-text hover:text-brand-blue hover:bg-brand-bg/60'
            }`}
            aria-expanded="false"
          >
            <span class="whitespace-nowrap">{item.label}</span>
            <svg class="w-3.5 h-3.5 text-brand-subtle group-hover:rotate-180 group-hover:text-brand-blue transition-transform duration-200 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- About Dropdown -->
          <div class="absolute left-1/2 -translate-x-1/2 top-full pt-3 w-[420px] opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white rounded-2xl shadow-2xl border border-brand-border p-6 ring-1 ring-black/5">
              <div class="pb-3 mb-2 border-b border-brand-border">
                <span class="text-xs font-bold uppercase tracking-wider text-brand-navy">
                  Corporate Credibility & Team
                </span>
                <p class="text-xs text-brand-muted">
                  Rooted in Hanumangarh, serving global aspirants
                </p>
              </div>

              <div class="space-y-1">
                {item.children?.map((child) => (
                  <a
                    href={child.href}
                    class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-brand-bg hover:border-brand-blue/30 border border-transparent transition-all group/item"
                  >
                    <div class="w-7 h-7 rounded-lg bg-brand-bg text-brand-navy group-hover/item:bg-brand-navy group-hover/item:text-white flex items-center justify-center flex-shrink-0 transition-colors mt-0.5 text-xs font-bold">
                      ★
                    </div>
                    <div>
                      <span class="block text-xs sm:text-sm font-bold text-brand-navy group-hover/item:text-brand-blue leading-snug">
                        {child.label}
                      </span>
                      {child.description && (
                        <span class="block text-xs text-brand-muted mt-0.5">
                          {child.description}
                        </span>
                      )}
                    </div>
                  </a>
                ))}
              </div>

              <div class="pt-3 mt-3 border-t border-brand-border bg-brand-bg/50 -mx-6 -mb-6 p-4 rounded-b-2xl flex items-center justify-between text-xs text-brand-muted">
                <span>Shop No.115, Durga Market, Hanumangarh</span>
                <a href="/about/" class="font-bold text-brand-red hover:underline">
                  Visit Center →
                </a>
              </div>
            </div>
          </div>
        </div>
      );
    }

    // 4. Regular Direct Links (Flight Booking, Contact, etc.)
    return (
      <a
        href={item.href}
        class={`px-3 py-2 rounded-xl text-sm font-semibold whitespace-nowrap shrink-0 transition-all duration-150 ${
          active
            ? 'text-brand-navy bg-brand-bg font-bold shadow-2xs'
            : 'text-brand-text hover:text-brand-blue hover:bg-brand-bg/60'
        }`}
      >
        <span class="whitespace-nowrap">{item.label}</span>
      </a>
    );
  })}
</nav>
