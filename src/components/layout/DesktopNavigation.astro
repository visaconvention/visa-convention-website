---
import { siteConfig } from '../../data/site-config';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

function slugify(text: string) {
  return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

// Explicit two-line labels mapping per specification
const twoLineLabels: Record<string, { line1: string; line2: string }> = {
  'Study Abroad': { line1: 'Study', line2: 'Abroad' },
  'Tourist Visa': { line1: 'Tourist', line2: 'Visa' },
  'Work Visa': { line1: 'Work', line2: 'Visa' },
  'Additional Services': { line1: 'Additional', line2: 'Services' },
};
---

<nav aria-label="Main Navigation" class="hidden xl:flex items-center gap-1 xl:gap-1.5 2xl:gap-2 shrink-0">
  {siteConfig.nav.map((item) => {
    const hasChildren = item.children && item.children.length > 0;
    const isStudyAbroad = item.label === 'Study Abroad';
    const isFlights = item.label === 'Flights';
    const isAdditionalServices = item.label === 'Additional Services';
    const isAbout = item.label === 'About';
    const active = isActive(item.href) || (hasChildren && item.children?.some(c => isActive(c.href)));
    const slug = slugify(item.label);
    const btnId = `nav-btn-${slug}`;
    const menuId = `nav-menu-${slug}`;
    const twoLine = twoLineLabels[item.label];

    // Dropdown items (Study Abroad, Flights, Additional Services, About)
    if (hasChildren) {
      // Determine panel alignment and width
      let panelClasses = 'left-1/2 -translate-x-1/2 w-[400px]';
      if (isStudyAbroad) {
        panelClasses = 'left-0 w-[360px]';
      } else if (isFlights) {
        panelClasses = 'left-1/2 -translate-x-1/2 w-[390px]';
      } else if (isAdditionalServices) {
        panelClasses = 'left-1/2 -translate-x-1/2 w-[460px]';
      } else if (isAbout) {
        panelClasses = 'right-0 w-[380px]';
      }

      return (
        <div class="relative group nav-dropdown-group shrink-0" data-nav-dropdown>
          <button
            type="button"
            id={btnId}
            class={`min-h-[44px] px-2.5 2xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-semibold transition-all duration-150 flex items-center justify-center text-center focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue ${
              active
                ? 'text-brand-navy bg-brand-bg font-bold shadow-2xs'
                : 'text-brand-text hover:text-brand-blue hover:bg-brand-bg/60'
            }`}
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls={menuId}
          >
            {twoLine ? (
              <span class="flex items-center justify-center gap-1 sm:gap-1.5">
                <span class="flex flex-col items-center justify-center text-center leading-[1.15]">
                  <span class="whitespace-nowrap">{twoLine.line1}</span>
                  <span class="whitespace-nowrap">{twoLine.line2}</span>
                </span>
                <svg
                  class="w-3.5 h-3.5 text-brand-subtle transition-transform duration-200 shrink-0 chevron-icon"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 justify-center whitespace-nowrap">
                <span>{item.label}</span>
                <svg
                  class="w-3.5 h-3.5 text-brand-subtle transition-transform duration-200 shrink-0 chevron-icon"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            )}
          </button>

          <!-- Dropdown Panel -->
          <div
            id={menuId}
            role="region"
            aria-labelledby={btnId}
            class={`nav-dropdown-menu absolute top-full pt-2.5 opacity-0 translate-y-1 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto group-focus-within:opacity-100 group-focus-within:translate-y-0 group-focus-within:pointer-events-auto transition-all duration-200 z-50 ${panelClasses}`}
          >
            <div class={`bg-white rounded-2xl shadow-xl border border-brand-border ring-1 ring-black/5 text-left ${isStudyAbroad ? 'p-4' : 'p-3 sm:p-3.5'}`}>
              
              {/* STUDY ABROAD PANEL */}
              {isStudyAbroad && (
                <>
                  <div class="space-y-1">
                    {item.children?.map((child) => (
                      <a
                        href={child.href}
                        class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-brand-bg hover:border-brand-blue/30 border border-transparent transition-all group/item focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue"
                      >
                        <div class="w-7 h-7 rounded-lg bg-brand-bg text-brand-navy group-hover/item:bg-brand-navy group-hover/item:text-white flex items-center justify-center shrink-0 transition-colors mt-0.5 text-xs font-bold">
                          →
                        </div>
                        <div class="min-w-0 flex-1">
                          <span class="block text-xs sm:text-sm font-bold text-brand-navy group-hover/item:text-brand-blue leading-snug">
                            {child.label}
                          </span>
                          {child.description && (
                            <span class="block text-[11px] text-brand-muted leading-tight mt-0.5 truncate">
                              {child.description}
                            </span>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>

                  <div class="pt-2.5 mt-2 border-t border-brand-border/70 bg-brand-bg/50 -mx-4 -mb-4 p-3 rounded-b-2xl flex items-center justify-between text-xs text-brand-muted">
                    <span>Looking for institutions?</span>
                    <a href="/universities/" class="font-bold text-brand-red hover:underline">
                      Search 1,000+ Universities →
                    </a>
                  </div>
                </>
              )}

              {/* FLIGHTS PANEL */}
              {isFlights && (
                <div class="space-y-1">
                  {item.children?.map((child) => (
                    <a
                      href={child.href}
                      class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-brand-bg hover:border-brand-blue/30 border border-transparent transition-all group/item focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue"
                    >
                      <div class="w-7 h-7 rounded-lg bg-brand-bg text-brand-navy group-hover/item:bg-brand-navy group-hover/item:text-white flex items-center justify-center shrink-0 transition-colors mt-0.5 text-xs font-bold">
                        ✈
                      </div>
                      <div class="min-w-0 flex-1">
                        <span class="block text-xs sm:text-sm font-bold text-brand-navy group-hover/item:text-brand-blue leading-snug">
                          {child.label}
                        </span>
                        {child.description && (
                          <span class="block text-[11px] text-brand-muted leading-tight mt-0.5 truncate">
                            {child.description}
                          </span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              )}

              {/* ADDITIONAL SERVICES PANEL */}
              {isAdditionalServices && (
                <div class="grid grid-cols-1 gap-1">
                  {item.children?.map((child, idx) => (
                    <a
                      href={child.href}
                      class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-brand-bg hover:border-brand-blue/30 border border-transparent transition-all group/item focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue"
                    >
                      <div class="w-6 h-6 rounded-md bg-brand-bg text-brand-navy group-hover/item:bg-brand-navy group-hover/item:text-white flex items-center justify-center shrink-0 transition-colors mt-0.5 text-[11px] font-bold">
                        0{idx + 1}
                      </div>
                      <div class="min-w-0 flex-1">
                        <span class="block text-xs sm:text-sm font-bold text-brand-navy group-hover/item:text-brand-blue leading-snug">
                          {child.label}
                        </span>
                        {child.description && (
                          <span class="block text-[11px] text-brand-muted leading-tight mt-0.5 truncate">
                            {child.description}
                          </span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              )}

              {/* ABOUT PANEL */}
              {isAbout && (
                <div class="space-y-1">
                  {item.children?.map((child) => (
                    <a
                      href={child.href}
                      class="flex items-start gap-2.5 p-2 rounded-xl hover:bg-brand-bg hover:border-brand-blue/30 border border-transparent transition-all group/item focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue"
                    >
                      <div class="w-7 h-7 rounded-lg bg-brand-bg text-brand-navy group-hover/item:bg-brand-navy group-hover/item:text-white flex items-center justify-center shrink-0 transition-colors mt-0.5 text-xs font-bold">
                        ★
                      </div>
                      <div class="min-w-0 flex-1">
                        <span class="block text-xs sm:text-sm font-bold text-brand-navy group-hover/item:text-brand-blue leading-snug">
                          {child.label}
                        </span>
                        {child.description && (
                          <span class="block text-[11px] text-brand-muted leading-tight mt-0.5 truncate">
                            {child.description}
                          </span>
                        )}
                      </div>
                    </a>
                  ))}
                </div>
              )}

            </div>
          </div>
        </div>
      );
    }

    // Direct link fallback (Tourist Visa, Work Visa, etc.)
    return (
      <a
        href={item.href}
        class={`min-h-[44px] px-2.5 2xl:px-3 py-1.5 rounded-xl text-xs xl:text-sm font-semibold shrink-0 transition-all duration-150 flex items-center justify-center text-center focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue ${
          active
            ? 'text-brand-navy bg-brand-bg font-bold shadow-2xs'
            : 'text-brand-text hover:text-brand-blue hover:bg-brand-bg/60'
        }`}
      >
        {twoLine ? (
          <span class="flex flex-col items-center justify-center text-center leading-[1.15]">
            <span class="whitespace-nowrap">{twoLine.line1}</span>
            <span class="whitespace-nowrap">{twoLine.line2}</span>
          </span>
        ) : (
          <span class="whitespace-nowrap">{item.label}</span>
        )}
      </a>
    );
  })}
</nav>

<style>
  .nav-dropdown-group:hover .nav-dropdown-menu,
  .nav-dropdown-group:focus-within .nav-dropdown-menu,
  .nav-dropdown-group[data-open="true"] .nav-dropdown-menu {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  .nav-dropdown-group:hover .chevron-icon,
  .nav-dropdown-group:focus-within .chevron-icon,
  .nav-dropdown-group[data-open="true"] .chevron-icon {
    transform: rotate(180deg);
    color: var(--color-brand-blue, #2367A4);
  }
</style>

<script>
  function setupDesktopNavigation() {
    const dropdownGroups = document.querySelectorAll<HTMLElement>('[data-nav-dropdown]');

    function closeAllDropdowns(except?: HTMLElement) {
      dropdownGroups.forEach((group) => {
        if (group !== except) {
          group.removeAttribute('data-open');
          const btn = group.querySelector<HTMLButtonElement>('button[aria-haspopup="true"]');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }
      });
    }

    dropdownGroups.forEach((group) => {
      const btn = group.querySelector<HTMLButtonElement>('button[aria-haspopup="true"]');
      if (!btn) return;

      // Click toggle
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = group.getAttribute('data-open') === 'true';
        if (isOpen) {
          group.removeAttribute('data-open');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          closeAllDropdowns(group);
          group.setAttribute('data-open', 'true');
          btn.setAttribute('aria-expanded', 'true');
        }
      });

      // Hover / focus sync
      group.addEventListener('mouseenter', () => {
        btn.setAttribute('aria-expanded', 'true');
      });

      group.addEventListener('mouseleave', () => {
        if (group.getAttribute('data-open') !== 'true') {
          btn.setAttribute('aria-expanded', 'false');
        }
      });

      // Close when link clicked inside
      const links = group.querySelectorAll('a');
      links.forEach((link) => {
        link.addEventListener('click', () => {
          closeAllDropdowns();
        });
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (!target?.closest('[data-nav-dropdown]')) {
        closeAllDropdowns();
      }
    });

    // Escape key closes open dropdown and focuses its button
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        dropdownGroups.forEach((group) => {
          const btn = group.querySelector<HTMLButtonElement>('button[aria-haspopup="true"]');
          if (group.getAttribute('data-open') === 'true' || group.contains(document.activeElement)) {
            group.removeAttribute('data-open');
            if (btn) {
              btn.setAttribute('aria-expanded', 'false');
              btn.focus();
            }
          }
        });
      }
    });
  }

  setupDesktopNavigation();
  document.addEventListener('astro:page-load', setupDesktopNavigation);
</script>
