---
import { siteConfig } from '../../data/site-config';
import SocialLinks from '../common/SocialLinks.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-navy text-white pt-7 pb-6 sm:pt-8 sm:pb-6 border-t border-brand-navy-light text-left">
  <div class="site-container">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 lg:gap-8 pb-5 border-b border-white/10 items-start">
      <!-- Column 1: Business Identity (~42% on desktop) -->
      <div class="md:col-span-5 space-y-2.5">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-brand-red text-white flex items-center justify-center font-black text-xs shadow-xs shrink-0">
            VC
          </div>
          <div>
            <span class="block text-base font-black tracking-tight text-white leading-none">
              VISA CONVENTION
            </span>
            <span class="block text-[11px] text-gray-300 mt-0.5">
              Hanumangarh, Rajasthan, India
            </span>
          </div>
        </div>
        <p class="text-xs text-gray-300 leading-relaxed max-w-sm font-normal">
          Study abroad counseling, visa assistance, and flight reservations from Hanumangarh, Rajasthan.
        </p>

        <!-- Official Social Media Channels (Verified) -->
        <div class="pt-1">
          <span class="sr-only">Follow Visa Convention on Official Social Media</span>
          <SocialLinks variant="dark" size="sm" />
        </div>
      </div>

      <!-- Column 2: Quick Links (~25% on desktop) -->
      <div class="md:col-span-3 space-y-2">
        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-200">
          Quick Links
        </h4>
        <ul class="space-y-1.5 text-xs text-gray-300">
          <li><a href="/study-abroad/" class="hover:text-white transition-colors">Study Abroad</a></li>
          <li><a href="/services/" class="hover:text-white transition-colors">Visa Services</a></li>
          <li><a href="/universities/" class="hover:text-white transition-colors">University Directory</a></li>
          <li><a href="/about/" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact/" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact (~33% on desktop) -->
      <div class="md:col-span-4 space-y-2 text-xs text-gray-300">
        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-200">
          Office & Contact
        </h4>
        <div class="space-y-1.5 leading-relaxed">
          <div class="text-gray-300">
            {siteConfig.addressLines.map((line) => (
              <span class="block">{line}</span>
            ))}
          </div>
          <p>
            Phone / WhatsApp: <a href={siteConfig.phoneTel} class="text-white hover:underline font-semibold">{siteConfig.phone}</a>
          </p>
          <p>
            Email: <a href={`mailto:${siteConfig.email}`} class="text-white hover:underline font-semibold">{siteConfig.email}</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Statutory Notice & Disclosures -->
    <div class="py-3 border-b border-white/10 text-[11px] text-gray-400 leading-relaxed">
      <p>
        <strong class="text-gray-300">Statutory Notice:</strong> Sovereign host-nation embassies and immigration authorities make all visa decisions independently. Visa Convention facilitates honest counseling and documentation audits, and strictly does not guarantee visa grants. Institutions listed represent universities for which independent application guidance and visa support are provided. Listing does not imply an official partnership, affiliation, or institutional endorsement.
      </p>
    </div>

    <!-- Bottom Row: Copyright & Legal (with clearance for floating WhatsApp) -->
    <div class="pt-4 pb-2 sm:pb-1 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-[11px] sm:text-xs text-gray-400">
      <div>
        © {currentYear} Visa Convention. All rights reserved.
      </div>
      <div class="flex items-center flex-wrap gap-x-4 sm:gap-x-5 gap-y-1 mr-36 sm:mr-44 lg:mr-0">
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <span aria-hidden="true">•</span>
        <a href="/terms/" class="hover:text-white transition-colors">Terms of Service</a>
        <span aria-hidden="true">•</span>
        <a href="/contact/" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
