---
import { siteConfig } from '../../data/site-config';

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-navy text-white pt-12 pb-8 border-t border-brand-navy-light text-left">
  <div class="site-container">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 pb-8 border-b border-white/10 items-start">
      <!-- Column 1: Business Identity (~40% on desktop) -->
      <div class="md:col-span-5 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-lg bg-brand-red text-white flex items-center justify-center font-black text-sm shadow-xs">
            VC
          </div>
          <div>
            <span class="block text-lg font-black tracking-tight text-white leading-none">
              VISA CONVENTION
            </span>
            <span class="block text-xs text-gray-300 mt-1">
              Hanumangarh, Rajasthan, India
            </span>
          </div>
        </div>
        <p class="text-xs text-gray-300 leading-relaxed max-w-sm font-normal">
          Study abroad counseling, visa assistance, and flight reservations from Hanumangarh, Rajasthan.
        </p>
      </div>

      <!-- Column 2: Quick Links (~30% on desktop) -->
      <div class="md:col-span-3 space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-200">
          Quick Links
        </h4>
        <ul class="space-y-2 text-xs text-gray-300">
          <li><a href="/study-abroad/" class="hover:text-white transition-colors">Study Abroad</a></li>
          <li><a href="/services/" class="hover:text-white transition-colors">Visa Services</a></li>
          <li><a href="/universities/" class="hover:text-white transition-colors">University Directory</a></li>
          <li><a href="/about/" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/contact/" class="hover:text-white transition-colors">Contact</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact (~30% on desktop) -->
      <div class="md:col-span-4 space-y-3 text-xs text-gray-300">
        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-200">
          Office & Contact
        </h4>
        <div class="space-y-2 leading-relaxed">
          <p>{siteConfig.officeAddress}</p>
          <p>
            Phone / WhatsApp: <a href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`} class="text-white hover:underline font-semibold">{siteConfig.phone}</a>
          </p>
          <p>
            Email: <a href={`mailto:${siteConfig.email}`} class="text-white hover:underline font-semibold">{siteConfig.email}</a>
          </p>
        </div>
      </div>
    </div>

    <!-- Statutory Notice & Disclosures -->
    <div class="py-4 border-b border-white/10 text-[11px] text-gray-400 leading-relaxed">
      <p>
        <strong class="text-gray-300">Statutory Notice:</strong> Sovereign host-nation embassies and immigration authorities make all visa decisions independently. Visa Convention facilitates honest counseling and documentation audits, and strictly does not guarantee visa grants. Institutions listed represent universities for which independent application guidance and visa support are provided. Listing does not imply an official partnership, affiliation, or institutional endorsement.
      </p>
    </div>

    <!-- Bottom Row: Copyright & Legal -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-400">
      <div>
        © {currentYear} Visa Convention. All rights reserved.
      </div>
      <div class="flex items-center gap-5">
        <a href="/privacy-policy/" class="hover:text-white transition-colors">Privacy Policy</a>
        <span aria-hidden="true">•</span>
        <a href="/terms/" class="hover:text-white transition-colors">Terms of Service</a>
        <span aria-hidden="true">•</span>
        <a href="/contact/" class="hover:text-white transition-colors">Contact</a>
      </div>
    </div>
  </div>
</footer>
