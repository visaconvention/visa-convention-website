---
import { siteConfig } from '../../data/site-config';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<!-- Mobile Menu Drawer Backdrop & Content -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-50 bg-brand-navy/60 backdrop-blur-xs hidden transition-opacity duration-300"
  aria-modal="true"
  role="dialog"
  aria-label="Mobile Navigation"
>
  <div class="fixed inset-y-0 right-0 w-full max-w-sm bg-white shadow-2xl flex flex-col justify-between overflow-y-auto">
    <!-- Top Header -->
    <div class="p-5 border-b border-brand-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-brand-navy text-white flex items-center justify-center font-bold text-sm">
          VC
        </div>
        <div>
          <span class="block font-bold text-brand-navy text-sm leading-none">Visa Convention</span>
          <span class="block text-[10px] text-brand-red font-semibold uppercase tracking-wider mt-0.5">Hanumangarh • Global</span>
        </div>
      </div>
      <button
        id="close-mobile-menu-btn"
        type="button"
        class="p-2 rounded-lg text-brand-muted hover:text-brand-navy hover:bg-brand-bg focus:outline-hidden focus:ring-2 focus:ring-brand-blue"
        aria-label="Close menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Groups -->
    <div class="p-5 space-y-4 flex-1">
      {siteConfig.nav.map((item) => {
        const hasChildren = item.children && item.children.length > 0;
        const isEurope = item.label === 'Study in Europe';
        const active = currentPath === item.href || (hasChildren && item.children?.some(c => c.href === currentPath));

        if (hasChildren) {
          return (
            <div class={`pb-2.5 border-b border-brand-border/60 ${isEurope ? 'bg-brand-blue-light/40 -mx-3 p-3 rounded-xl border border-brand-blue/20' : ''}`}>
              <div class="flex items-center justify-between py-1 px-1">
                <div class="flex items-center gap-1.5">
                  <span class={`text-xs font-black uppercase tracking-wider ${isEurope ? 'text-brand-blue' : 'text-brand-navy'}`}>
                    {item.label}
                  </span>
                  {isEurope && (
                    <span class="px-1.5 py-0.2 text-[9px] font-black uppercase tracking-wider bg-brand-red text-white rounded">
                      Focus
                    </span>
                  )}
                </div>
                <a href={item.href} class="text-[11px] font-bold text-brand-blue hover:underline py-1 px-1.5">
                  Overview →
                </a>
              </div>
              <div class="space-y-1 mt-1 pl-1">
                {item.children?.map((child) => {
                  const isChildActive = currentPath === child.href;
                  return (
                    <a
                      href={child.href}
                      class={`block px-3 py-2.5 text-xs sm:text-sm font-semibold rounded-lg transition-colors min-h-[44px] flex items-center ${
                        isChildActive
                          ? 'bg-brand-navy text-white font-bold'
                          : 'text-slate-700 hover:bg-brand-bg hover:text-brand-navy'
                      }`}
                    >
                      {child.label}
                    </a>
                  );
                })}
              </div>
            </div>
          );
        }

        return (
          <div class="pb-1 border-b border-brand-border/60">
            <a
              href={item.href}
              class={`block px-3 py-3 text-sm font-bold rounded-lg transition-colors min-h-[44px] flex items-center ${
                active
                  ? 'bg-brand-navy text-white'
                  : 'text-brand-navy hover:bg-brand-bg hover:text-brand-blue'
              }`}
            >
              {item.label}
            </a>
          </div>
        );
      })}
    </div>

    <!-- Bottom Actions & Direct Contacts -->
    <div class="p-5 border-t border-brand-border bg-brand-bg/50 space-y-3">
      <div class="grid grid-cols-2 gap-2 text-xs font-bold text-center">
        <a
          href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
          class="p-3 rounded-xl bg-white border border-brand-border text-brand-navy hover:bg-slate-50 transition-colors flex items-center justify-center gap-1.5 min-h-[44px]"
        >
          <span>📞 Call Us</span>
        </a>
        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent('Hello Visa Convention, I would like to inquire about your services.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded-xl bg-[#25D366] text-white hover:bg-[#20ba5a] transition-colors flex items-center justify-center gap-1.5 min-h-[44px]"
        >
          <span>💬 WhatsApp</span>
        </a>
      </div>

      <a
        href="/contact/"
        class="block w-full py-3.5 px-4 text-center rounded-xl bg-brand-red text-white font-bold text-sm hover:bg-brand-red-hover transition-colors shadow-sm min-h-[48px] flex items-center justify-center"
      >
        Request Consultation
      </a>
      <p class="text-center text-[11px] text-brand-muted">
        Shop No.115, Durga Market, Hanumangarh Junction
      </p>
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const openBtn = document.getElementById('open-mobile-menu-btn');
    const closeBtn = document.getElementById('close-mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!openBtn || !closeBtn || !drawer) return;
    const menuDrawer = drawer;

    function openMenu() {
      menuDrawer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menuDrawer.classList.add('hidden');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
        closeMenu();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
