---
import { siteConfig } from '../../data/site-config';
import { getFeaturedCountries } from '../../data/countries';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
const featuredCountries = getFeaturedCountries();
---

<!-- Mobile Menu Drawer Backdrop & Content -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-50 bg-brand-navy/60 backdrop-blur-xs hidden transition-opacity duration-300"
  aria-modal="true"
  role="dialog"
  aria-label="Mobile Navigation"
>
  <div class="fixed inset-y-0 right-0 w-full max-w-sm bg-white shadow-2xl flex flex-col justify-between overflow-y-auto">
    <!-- Top Header -->
    <div class="p-5 border-b border-brand-border flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-brand-navy text-white flex items-center justify-center font-bold text-sm">
          VC
        </div>
        <span class="font-bold text-brand-navy text-base">Visa Convention</span>
      </div>
      <button
        id="close-mobile-menu-btn"
        type="button"
        class="p-2 rounded-lg text-brand-muted hover:text-brand-navy hover:bg-brand-bg focus:outline-hidden focus:ring-2 focus:ring-brand-blue"
        aria-label="Close menu"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Navigation Links -->
    <div class="p-5 space-y-2 flex-1">
      {siteConfig.nav.map((item) => {
        const hasChildren = item.children && item.children.length > 0;
        const isStudyAbroad = item.href === '/study-abroad/';
        const active = currentPath === item.href;

        if (hasChildren) {
          return (
            <div class="py-1">
              <div class="text-xs font-bold uppercase tracking-wider text-brand-muted mb-2 px-3">
                {item.label}
              </div>
              <div class="space-y-1 pl-2">
                {item.children?.map((child) => (
                  <a
                    href={child.href}
                    class="block px-3 py-2 text-sm font-semibold rounded-lg text-brand-navy hover:bg-brand-bg hover:text-brand-blue transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          );
        }

        if (isStudyAbroad) {
          return (
            <div class="py-1">
              <a
                href="/study-abroad/"
                class={`block px-3 py-2.5 text-base font-bold rounded-lg transition-colors ${
                  active ? 'bg-brand-bg text-brand-blue' : 'text-brand-navy hover:bg-brand-bg hover:text-brand-blue'
                }`}
              >
                Study Abroad (35+ Countries)
              </a>
              <div class="space-y-1 pl-3 mt-1">
                {featuredCountries.slice(0, 4).map((country) => (
                  <a
                    href={`/study-abroad/${country.slug}/`}
                    class="block px-3 py-1.5 text-xs font-semibold rounded-md text-brand-muted hover:text-brand-navy hover:bg-brand-bg transition-colors"
                  >
                    {country.name}
                  </a>
                ))}
                <a
                  href="/study-abroad/"
                  class="block px-3 py-1.5 text-xs font-bold text-brand-red hover:underline"
                >
                  Explore All 35+ Destinations →
                </a>
              </div>
            </div>
          );
        }

        return (
          <a
            href={item.href}
            class={`block px-3 py-2.5 text-base font-semibold rounded-lg transition-colors ${
              active
                ? 'bg-brand-bg text-brand-blue font-bold'
                : 'text-brand-navy hover:bg-brand-bg hover:text-brand-blue'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </div>

    <!-- Bottom Actions -->
    <div class="p-5 border-t border-brand-border bg-brand-bg/50 space-y-3">
      <a
        href="/contact/"
        class="block w-full py-3 px-4 text-center rounded-xl bg-brand-red text-white font-bold text-sm hover:bg-brand-red-hover transition-colors shadow-sm"
      >
        Book Free Consultation
      </a>
      <p class="text-center text-xs text-brand-muted">
        Hanumangarh, Rajasthan • Global Services
      </p>
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const openBtn = document.getElementById('open-mobile-menu-btn');
    const closeBtn = document.getElementById('close-mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');

    if (!openBtn || !closeBtn || !drawer) return;
    const menuDrawer = drawer;

    function openMenu() {
      menuDrawer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      menuDrawer.classList.add('hidden');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);

    drawer.addEventListener('click', (e) => {
      if (e.target === drawer) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.classList.contains('hidden')) {
        closeMenu();
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>