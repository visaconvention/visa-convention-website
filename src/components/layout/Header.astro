---
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-border">
  <!-- Main Navigation Bar -->
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo Motif -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 min-w-0 group focus-visible:ring-2 focus-visible:ring-brand-blue rounded-xl p-1">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-brand-navy text-white flex items-center justify-center shadow-subtle relative overflow-hidden group-hover:bg-brand-navy-light transition-all duration-200 shrink-0">
          <!-- Stylized globe lines -->
          <svg class="w-5 h-5 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            <path d="M2 12h20" />
          </svg>
          <!-- Stylized Airplane Accent in Signature Red -->
          <svg class="w-3.5 h-3.5 text-brand-red absolute -top-0.5 -right-0.5 filter drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
          </svg>
        </div>

        <div class="min-w-0">
          <span class="block text-base sm:text-lg font-black tracking-tight text-brand-navy leading-none truncate">
            VISA CONVENTION
          </span>
          <span class="block text-[9px] sm:text-[10px] font-bold text-brand-red tracking-wider uppercase mt-1 truncate">
            Study Abroad, Visa & Travel
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <DesktopNavigation currentPath={currentPath} />

      <!-- Right Action CTA Button -->
      <div class="hidden xl:flex items-center gap-3 shrink-0">
        <a
          href="/contact/"
          class="btn-primary text-xs px-4 py-2.5 whitespace-nowrap shadow-xs"
        >
          <span>Request Consultation</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center xl:hidden">
        <button
          id="open-mobile-menu-btn"
          type="button"
          class="p-2.5 rounded-xl text-brand-navy hover:bg-brand-bg focus-visible:ring-2 focus-visible:ring-brand-blue"
          aria-label="Open navigation menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Component -->
  <MobileNavigation currentPath={currentPath} />
</header>
