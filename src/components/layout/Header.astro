---
import DesktopNavigation from './DesktopNavigation.astro';
import MobileNavigation from './MobileNavigation.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-brand-border">
  <!-- Top Utility Notice Bar -->
  <div class="bg-brand-navy text-white text-xs py-2.5 px-4 sm:px-6 lg:px-8 border-b border-brand-navy-light/40">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1.5 text-center sm:text-left">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 font-medium text-gray-200">
          <svg class="w-3.5 h-3.5 text-brand-red flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          Hanumangarh, Rajasthan • Global Consultation Desk
        </span>
        <span class="hidden md:inline text-gray-400" aria-hidden="true">•</span>
        <span class="hidden md:inline text-gray-300">Study Visa • MBBS • PhD • Tourist • Work • Flights</span>
      </div>
      <div class="flex items-center gap-4 text-gray-300 text-xs font-medium">
        <span>Mon – Sat: 9:30 AM – 6:30 PM IST</span>
        <a href="/contact/" class="text-white hover:text-brand-red-light font-bold underline underline-offset-4 decoration-brand-red">
          Book Consultation
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Brand Logo Motif (Preserving recognizable globe & airplane motif) -->
      <a href="/" class="flex items-center gap-3.5 group focus-visible:ring-2 focus-visible:ring-brand-blue rounded-xl p-1">
        <div class="w-12 h-12 rounded-xl bg-brand-navy text-white flex items-center justify-center shadow-subtle relative overflow-hidden group-hover:bg-brand-navy-light transition-all duration-200">
          <!-- Stylized globe lines -->
          <svg class="w-7 h-7 text-white/90" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
            <path d="M2 12h20" />
          </svg>
          <!-- Stylized Airplane Accent in Signature Red -->
          <svg class="w-5 h-5 text-brand-red absolute -top-0.5 -right-0.5 filter drop-shadow-xs" viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" />
          </svg>
        </div>

        <div>
          <span class="block text-xl font-black tracking-tight text-brand-navy leading-none">
            VISA CONVENTION
          </span>
          <span class="block text-[11px] font-bold text-brand-red tracking-widest uppercase mt-1">
            Global Education & Visa Advisory
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <DesktopNavigation currentPath={currentPath} />

      <!-- Right Action CTA Button -->
      <div class="hidden xl:flex items-center gap-3">
        <a
          href="/contact/"
          class="btn-primary"
        >
          <span>Book Consultation</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center xl:hidden">
        <button
          id="open-mobile-menu-btn"
          type="button"
          class="p-2.5 rounded-xl text-brand-navy hover:bg-brand-bg focus-visible:ring-2 focus-visible:ring-brand-blue"
          aria-label="Open navigation menu"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Component -->
  <MobileNavigation currentPath={currentPath} />
</header>
