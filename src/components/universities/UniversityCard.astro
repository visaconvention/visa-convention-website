---
import type { University } from '../../types';

interface Props {
  university: University;
  class?: string;
  showFiltersDataAttrs?: boolean;
}

const { university, class: className = '', showFiltersDataAttrs = false } = Astro.props;

// Prepare data attributes for client-side search & filter indexing if requested
const dataAttrs = showFiltersDataAttrs ? {
  'data-card-university': 'true',
  'data-name': university.name.toLowerCase(),
  'data-country-slug': university.countrySlug.toLowerCase(),
  'data-country-name': university.countryName.toLowerCase(),
  'data-city': (university.city || '').toLowerCase(),
  'data-levels': university.studyLevels.join(',').toLowerCase(),
  'data-subjects': university.subjectAreas.join(',').toLowerCase(),
  'data-detailed': university.hasDetailedProfile ? 'true' : 'false',
} : {};
---

<article 
  class={`card-premium p-6 sm:p-7 flex flex-col justify-between group transition-all duration-300 hover:shadow-lg border border-brand-border/80 bg-white h-full min-w-0 text-left ${className}`}
  {...dataAttrs}
>
  <div>
    <!-- Top Meta Row -->
    <div class="flex items-start justify-between gap-3 mb-3">
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-center gap-2 mb-2">
          <span class="inline-flex items-center text-[11px] font-bold uppercase tracking-wider text-brand-blue bg-brand-bg px-2.5 py-1 rounded-md border border-brand-blue/15">
            {university.countryName}
            {university.city && university.city !== university.countryName && (
              <span class="text-brand-muted font-normal ml-1">• {university.city}</span>
            )}
          </span>

        </div>
        <h3 class="text-lg sm:text-xl font-bold text-brand-navy group-hover:text-brand-blue transition-colors leading-snug">
          {university.hasDetailedProfile ? (
            <a href={`/universities/${university.slug}/`} class="hover:underline focus:outline-none focus:ring-2 focus:ring-brand-blue rounded">
              {university.name}
            </a>
          ) : (
            <span>{university.name}</span>
          )}
        </h3>
      </div>

      {university.worldRanking && (
        <span class="flex-shrink-0 px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-200" title="Recognized international ranking indicator">
          {university.worldRanking}
        </span>
      )}
    </div>

    <!-- Institution Type & Highlights -->
    <div class="text-xs text-brand-muted mb-3 flex items-center gap-2">
      <span class="font-medium text-slate-700">{university.institutionType || 'Higher Education Institution'}</span>
      {university.averageTuition && university.averageTuition !== 'Varies by program' && (
        <>
          <span class="text-slate-300">•</span>
          <span class="text-emerald-700 font-semibold">{university.averageTuition}</span>
        </>
      )}
    </div>

    {university.description && (
      <p class="text-xs sm:text-sm text-brand-muted line-clamp-2 mb-4 leading-relaxed font-normal">
        {university.description}
      </p>
    )}

    <!-- Study Levels Badges -->
    {university.studyLevels && university.studyLevels.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-3.5">
        {university.studyLevels.slice(0, 3).map((level) => (
          <span class="text-[11px] font-medium bg-slate-50 text-slate-700 border border-slate-200 px-2 py-0.5 rounded">
            {level}
          </span>
        ))}
        {university.studyLevels.length > 3 && (
          <span class="text-[10px] text-slate-500 self-center">
            +{university.studyLevels.length - 3} more
          </span>
        )}
      </div>
    )}

    <!-- Subject Areas / Popular Programs -->
    {university.subjectAreas && university.subjectAreas.length > 0 && (
      <div class="text-xs text-brand-muted mb-4 line-clamp-1">
        <span class="font-semibold text-brand-navy">Disciplines:</span> {university.subjectAreas.slice(0, 3).join(', ')}
        {university.subjectAreas.length > 3 && '...'}
      </div>
    )}
  </div>

  <!-- Bottom Action Bar & Navigation -->
  <div class="pt-4 border-t border-brand-border/70 flex flex-wrap items-center justify-between gap-3 text-xs mt-auto">
    <div class="flex items-center gap-2">
      {university.officialWebsite && (
        <a
          href={university.officialWebsite}
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-muted hover:text-brand-navy transition-colors inline-flex items-center gap-1 py-1 px-1.5 rounded hover:bg-slate-100 text-[11px]"
          title={`Visit official ${university.name} portal`}
        >
          <span>Official Portal</span>
          <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      )}
    </div>

    <div class="flex items-center gap-3 ml-auto">
      {university.hasDetailedProfile ? (
        <div class="flex items-center gap-2.5">
          <a
            href={`/contact/?service=study-visa&country=${university.countrySlug}&university=${encodeURIComponent(university.name)}`}
            class="text-[11px] font-bold text-brand-red hover:underline"
          >
            Get Guidance
          </a>
          <a
            href={`/universities/${university.slug}/`}
            class="font-bold text-brand-blue hover:text-brand-navy transition-colors inline-flex items-center gap-1 group/link"
          >
            <span>View Profile</span>
            <svg class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      ) : (
        <a
          href={`/contact/?service=study-visa&country=${university.countrySlug}&university=${encodeURIComponent(university.name)}`}
          class="font-semibold text-brand-red hover:text-red-700 transition-colors inline-flex items-center gap-1 group/btn"
        >
          <span>Get Application Guidance</span>
          <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
