---
import type { University } from '../../types';

interface Props {
  university: University;
  class?: string;
  showFiltersDataAttrs?: boolean;
}

const { university, class: className = '', showFiltersDataAttrs = false } = Astro.props;

// Prepare data attributes for client-side search & filter indexing if requested
const dataAttrs = showFiltersDataAttrs ? {
  'data-card-university': 'true',
  'data-name': university.name.toLowerCase(),
  'data-country-slug': university.countrySlug.toLowerCase(),
  'data-country-name': university.countryName.toLowerCase(),
  'data-city': (university.city || '').toLowerCase(),
  'data-levels': university.studyLevels.join(',').toLowerCase(),
  'data-subjects': university.subjectAreas.join(',').toLowerCase(),
  'data-detailed': university.hasDetailedProfile ? 'true' : 'false',
} : {};

const uniId = `uni-${university.slug || university.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div
  class={`university-accordion-card card-premium rounded-xl border border-brand-border bg-white shadow-2xs hover:border-brand-navy/60 transition-all duration-200 overflow-hidden w-full text-left ${className}`}
  data-university-card
  data-university-name={university.name}
  data-country-name={university.countryName}
  data-country-slug={university.countrySlug}
  {...dataAttrs}
>
  <!-- Collapsed Header Button (Entire header clickable, 52-64px tall, allows long names to wrap) -->
  <button
    type="button"
    class="uni-toggle-btn w-full min-h-[52px] sm:min-h-[58px] p-3 sm:p-3.5 text-left flex items-center justify-between gap-3 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-brand-blue cursor-pointer transition-colors hover:bg-slate-50/70"
    aria-expanded="false"
    aria-controls={`uni-content-${uniId}`}
    id={`uni-header-${uniId}`}
  >
    <div class="flex-1 min-w-0 pr-1">
      <h3 class="text-xs sm:text-sm font-bold text-brand-navy leading-snug line-clamp-2 block group-hover:text-brand-blue transition-colors">
        {university.name}
      </h3>
    </div>

    <!-- Chevron Action Indicator -->
    <div class="w-6 h-6 rounded-full bg-brand-bg flex items-center justify-center text-brand-subtle group-hover:bg-brand-navy group-hover:text-white transition-colors shrink-0 uni-chevron-circle">
      <svg
        class="w-3.5 h-3.5 transition-transform duration-200 uni-chevron text-brand-navy"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </button>

  <!-- Expanded Content Drawer (Hidden initially, revealed on click) -->
  <div
    id={`uni-content-${uniId}`}
    class="uni-drawer hidden border-t border-brand-border/70 p-3.5 sm:p-4 bg-slate-50/60 space-y-3 text-left"
    role="region"
    aria-labelledby={`uni-header-${uniId}`}
  >
    <!-- Top Meta Row: Country / City & World Ranking -->
    <div class="flex items-start justify-between gap-2.5">
      <span class="inline-flex items-center text-[11px] font-bold uppercase tracking-wider text-brand-blue bg-white px-2 py-0.5 rounded-md border border-brand-blue/20">
        {university.countryName}
        {university.city && university.city !== university.countryName && (
          <span class="text-brand-muted font-normal ml-1">• {university.city}</span>
        )}
      </span>

      {university.worldRanking && (
        <span
          class="flex-shrink-0 px-2 py-0.5 rounded-md text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-200"
          title="Recognized international ranking indicator"
        >
          {university.worldRanking}
        </span>
      )}
    </div>

    <!-- Institution Type & Average Tuition -->
    <div class="text-xs text-brand-muted flex flex-wrap items-center gap-1.5 pt-0.5">
      <span class="font-medium text-slate-700">{university.institutionType || 'Higher Education Institution'}</span>
      {university.averageTuition && university.averageTuition !== 'Varies by program' && (
        <>
          <span class="text-slate-300">•</span>
          <span class="text-emerald-700 font-semibold">{university.averageTuition}</span>
        </>
      )}
    </div>

    <!-- Description -->
    {university.description && (
      <p class="text-xs sm:text-sm text-brand-muted line-clamp-3 leading-relaxed font-normal">
        {university.description}
      </p>
    )}

    <!-- Study Levels Badges -->
    {university.studyLevels && university.studyLevels.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-1">
        {university.studyLevels.map((level) => (
          <span class="text-[10px] sm:text-[11px] font-medium bg-white text-slate-700 border border-slate-200 px-2 py-0.5 rounded">
            {level}
          </span>
        ))}
      </div>
    )}

    <!-- Disciplines / Subject Areas -->
    {university.subjectAreas && university.subjectAreas.length > 0 && (
      <div class="text-xs text-brand-muted">
        <span class="font-semibold text-brand-navy">Disciplines:</span> {university.subjectAreas.join(', ')}
      </div>
    )}

    <!-- Bottom Action Bar & Navigation -->
    <div class="pt-3 border-t border-brand-border/70 flex flex-wrap items-center justify-between gap-2.5 text-xs">
      <div>
        {university.officialWebsite && (
          <a
            href={university.officialWebsite}
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-muted hover:text-brand-navy transition-colors inline-flex items-center gap-1 py-1 px-1.5 rounded hover:bg-slate-100 text-[11px] font-medium"
            title={`Visit official ${university.name} portal`}
          >
            <span>Official Portal</span>
            <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>

      <div class="flex items-center gap-2.5 ml-auto">
        {university.hasDetailedProfile ? (
          <div class="flex items-center gap-2">
            <a
              href={`/contact/?service=study-visa&country=${university.countrySlug}&university=${encodeURIComponent(university.name)}`}
              class="text-[11px] font-bold text-brand-red hover:underline py-1 px-1"
            >
              Get Guidance
            </a>
            <a
              href={`/universities/${university.slug}/`}
              class="font-bold text-brand-blue hover:text-brand-navy transition-colors inline-flex items-center gap-1 group/link text-xs py-1 px-1"
            >
              <span>View Profile</span>
              <svg class="w-3.5 h-3.5 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        ) : (
          <a
            href={`/contact/?service=study-visa&country=${university.countrySlug}&university=${encodeURIComponent(university.name)}`}
            class="font-semibold text-brand-red hover:text-red-700 transition-colors inline-flex items-center gap-1 group/btn text-xs py-1 px-1"
          >
            <span>Get Application Guidance</span>
            <svg class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</div>

<script>
  function initUniversityAccordions() {
    const cards = document.querySelectorAll('.university-accordion-card');
    cards.forEach((card) => {
      const btn = card.querySelector('.uni-toggle-btn');
      const drawer = card.querySelector('.uni-drawer');
      const chevron = card.querySelector('.uni-chevron');

      if (!btn || !drawer || btn.hasAttribute('data-uni-init')) return;
      btn.setAttribute('data-uni-init', 'true');

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        // Find parent directory container to enforce "only one expanded per directory"
        const container = card.closest('[data-university-directory], #university-grid, #universities, section') || document;

        container.querySelectorAll('.university-accordion-card').forEach((otherCard) => {
          if (otherCard !== card) {
            const otherBtn = otherCard.querySelector('.uni-toggle-btn');
            const otherDrawer = otherCard.querySelector('.uni-drawer');
            const otherChevron = otherCard.querySelector('.uni-chevron');
            if (otherBtn && otherDrawer) {
              otherBtn.setAttribute('aria-expanded', 'false');
              otherDrawer.classList.add('hidden');
              otherChevron?.classList.remove('rotate-180');
              otherCard.classList.remove('ring-2', 'ring-brand-blue/30', 'border-brand-blue');
            }
          }
        });

        // Toggle clicked card
        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          drawer.classList.add('hidden');
          chevron?.classList.remove('rotate-180');
          card.classList.remove('ring-2', 'ring-brand-blue/30', 'border-brand-blue');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          drawer.classList.remove('hidden');
          chevron?.classList.add('rotate-180');
          card.classList.add('ring-2', 'ring-brand-blue/30', 'border-brand-blue');
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initUniversityAccordions);
  } else {
    initUniversityAccordions();
  }
</script>
