---
import { siteConfig } from '../../data/site-config';

interface Props {
  serviceName: string;
  submitButtonText: string;
  formId?: string;
  class?: string;
}

const {
  serviceName,
  submitButtonText,
  formId = `service-form-${Math.random().toString(36).substring(2, 8)}`,
  class: className = '',
} = Astro.props;
---

<div class={`bg-white rounded-2xl p-4 sm:p-5 lg:p-6 border border-brand-border shadow-card ${className}`} id={`${formId}-container`}>
  <!-- Screen Reader Live Announcer for Accessibility -->
  <div role="alert" aria-live="polite" class="sr-only" id={`${formId}-announcer`}></div>

  <!-- Submission Error Alert Banner -->
  <div id={`${formId}-delivery-error`} class="hidden mb-4 p-3.5 rounded-xl bg-red-50 border border-red-200 text-xs text-red-900 leading-relaxed space-y-2">
    <div class="flex items-center gap-2 font-bold text-red-800">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span>Enquiry Transmission Error</span>
    </div>
    <p id={`${formId}-error-message`}>
      We could not deliver your request. Please connect with our team directly via WhatsApp or Telephone.
    </p>
    <div class="pt-1 flex flex-wrap gap-2">
      <a
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello Visa Convention, I was submitting an enquiry for ${serviceName} and would like direct assistance.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 text-white font-bold text-[11px] hover:bg-emerald-700 transition-colors"
      >
        <span>Message on WhatsApp</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a
        href={`tel:${siteConfig.phone.replace(/[^0-9+]/g, '')}`}
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-red-300 text-red-900 font-bold text-[11px] hover:bg-red-100 transition-colors"
      >
        <span>Call {siteConfig.phone}</span>
      </a>
    </div>
  </div>

  <!-- Form Element -->
  <form id={formId} class="space-y-3.5" method="POST" action="/api/enquiry" novalidate>
    <!-- Hidden Security & Identification Fields -->
    <div class="hidden" aria-hidden="true">
      <label for={`${formId}-bot-trap`}>Do not fill this field</label>
      <input type="text" id={`${formId}-bot-trap`} name="website_url_check" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" id={`${formId}-timestamp`} name="form_timestamp" value="" />
    <input type="hidden" name="submissionType" value="service" />
    <input type="hidden" name="service" value={serviceName} />

    <!-- 1. Full Name -->
    <div>
      <label for={`${formId}-full-name`} class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
        Full Name <span class="text-brand-red">*</span>
      </label>
      <input
        type="text"
        id={`${formId}-full-name`}
        name="fullName"
        required
        aria-required="true"
        aria-invalid="false"
        aria-describedby={`${formId}-name-error`}
        placeholder="Enter your full name"
        class="w-full px-3.5 py-2.5 sm:py-3 rounded-xl bg-brand-bg/60 border border-brand-border text-sm text-brand-navy placeholder:text-brand-subtle/70 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-brand-blue focus:bg-white transition-all min-h-[44px] h-[44px] sm:h-[46px]"
      />
      <p id={`${formId}-name-error`} class="hidden text-xs text-brand-red font-medium mt-1">
        Please enter your full name.
      </p>
    </div>

    <!-- 2. Phone / WhatsApp Number -->
    <div>
      <label for={`${formId}-phone`} class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
        Phone / WhatsApp Number <span class="text-brand-red">*</span>
      </label>
      <input
        type="tel"
        id={`${formId}-phone`}
        name="phone"
        required
        aria-required="true"
        aria-invalid="false"
        aria-describedby={`${formId}-phone-error`}
        placeholder="e.g. +91 96803 95539"
        class="w-full px-3.5 py-2.5 sm:py-3 rounded-xl bg-brand-bg/60 border border-brand-border text-sm text-brand-navy placeholder:text-brand-subtle/70 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-brand-blue focus:bg-white transition-all min-h-[44px] h-[44px] sm:h-[46px]"
      />
      <p id={`${formId}-phone-error`} class="hidden text-xs text-brand-red font-medium mt-1">
        Please enter a valid phone or WhatsApp number.
      </p>
    </div>

    <!-- 3. Message (Optional) -->
    <div>
      <label for={`${formId}-message`} class="block text-xs font-bold uppercase tracking-wider text-brand-navy mb-1.5">
        Message <span class="text-brand-muted font-normal lowercase">(optional)</span>
      </label>
      <textarea
        id={`${formId}-message`}
        name="message"
        rows="3"
        placeholder="Any questions or additional information?"
        class="w-full px-3.5 py-2.5 rounded-xl bg-brand-bg/60 border border-brand-border text-sm text-brand-navy placeholder:text-brand-subtle/70 focus:outline-none focus:ring-2 focus:ring-brand-blue focus:border-brand-blue focus:bg-white transition-all h-[80px] min-h-[72px] max-h-[140px] resize-y"
      ></textarea>
    </div>

    <!-- Mandatory Consent Checkbox -->
    <div class="flex items-start gap-2.5 pt-0.5">
      <input
        type="checkbox"
        id={`${formId}-consent`}
        name="privacy_consent"
        required
        aria-required="true"
        aria-invalid="false"
        aria-describedby={`${formId}-consent-error`}
        class="mt-0.5 w-4 h-4 rounded text-brand-blue focus:ring-brand-blue border-gray-300 cursor-pointer shrink-0"
      />
      <div>
        <label for={`${formId}-consent`} class="text-xs text-brand-muted leading-relaxed cursor-pointer select-none">
          I consent to being contacted by Visa Convention regarding this service inquiry. My information will remain strictly confidential. <span class="text-brand-red">*</span>
        </label>
        <p id={`${formId}-consent-error`} class="hidden text-xs text-brand-red font-medium mt-0.5">
          Consent is required to proceed.
        </p>
      </div>
    </div>

    <!-- Submit Action -->
    <div class="pt-1">
      <button
        type="submit"
        id={`${formId}-submit-btn`}
        data-original-text={submitButtonText}
        class="btn-primary w-full text-sm sm:text-base py-3 sm:py-3.5 min-h-[44px] shadow-sm hover:shadow transition-all flex items-center justify-center gap-2 cursor-pointer font-bold"
      >
        <span id={`${formId}-btn-text`}>{submitButtonText}</span>
        <svg id={`${formId}-btn-arrow`} class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </button>
      <p class="text-center text-[11px] text-brand-subtle mt-2">
        Zero spam. Strict client privacy. Transparent guidance.
      </p>
    </div>
  </form>

  <!-- Success Confirmation View -->
  <div id={`${formId}-success-view`} class="hidden p-6 sm:p-8 rounded-2xl bg-emerald-50 border border-emerald-200 text-center space-y-3.5">
    <div class="w-12 h-12 mx-auto rounded-full bg-emerald-100 text-emerald-800 flex items-center justify-center">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <span class="inline-block px-3 py-1 text-[11px] font-bold uppercase tracking-wider rounded-md bg-emerald-200 text-emerald-900" id={`${formId}-success-ref`}>
      Reference ID: VC-SRV-PENDING
    </span>
    <h4 class="text-xl sm:text-2xl font-bold text-emerald-950">
      Assistance Request Delivered
    </h4>
    <p class="text-xs sm:text-sm text-emerald-900 max-w-md mx-auto leading-relaxed">
      Thank you! Your request for <strong>{serviceName}</strong> has reached the Visa Convention advisory desk. An advisor will contact you shortly via WhatsApp or phone.
    </p>

    <div class="pt-2 border-t border-emerald-200 max-w-sm mx-auto flex items-center justify-center gap-4 text-xs font-semibold text-emerald-950">
      <button
        type="button"
        id={`${formId}-reset-btn`}
        class="text-brand-blue hover:underline cursor-pointer py-1"
      >
        ← Submit Another Request
      </button>
      <span>•</span>
      <a
        id={`${formId}-whatsapp-confirm-link`}
        href={`https://wa.me/${siteConfig.whatsappNumber}?text=${encodeURIComponent(`Hello Visa Convention, I just submitted a request for ${serviceName} on your website and would like to confirm direct assistance.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="text-emerald-800 hover:text-emerald-950 hover:underline py-1 flex items-center gap-1"
      >
        <span>Confirm on WhatsApp</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script define:vars={{ formId, serviceName, submitButtonText }}>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById(formId);
    if (!form) return;

    const timestampInput = document.getElementById(`${formId}-timestamp`);
    if (timestampInput) timestampInput.value = Date.now().toString();

    const nameInput = document.getElementById(`${formId}-full-name`);
    const phoneInput = document.getElementById(`${formId}-phone`);
    const messageInput = document.getElementById(`${formId}-message`);
    const consentInput = document.getElementById(`${formId}-consent`);
    const botTrapInput = document.getElementById(`${formId}-bot-trap`);

    const nameError = document.getElementById(`${formId}-name-error`);
    const phoneError = document.getElementById(`${formId}-phone-error`);
    const consentError = document.getElementById(`${formId}-consent-error`);

    const submitBtn = document.getElementById(`${formId}-submit-btn`);
    const btnText = document.getElementById(`${formId}-btn-text`);
    const btnArrow = document.getElementById(`${formId}-btn-arrow`);

    const errorBanner = document.getElementById(`${formId}-delivery-error`);
    const errorMessage = document.getElementById(`${formId}-error-message`);
    const successView = document.getElementById(`${formId}-success-view`);
    const successRef = document.getElementById(`${formId}-success-ref`);
    const resetBtn = document.getElementById(`${formId}-reset-btn`);
    const announcer = document.getElementById(`${formId}-announcer`);
    const waConfirmLink = document.getElementById(`${formId}-whatsapp-confirm-link`);

    let isSubmitting = false;

    // Field live validation
    nameInput?.addEventListener('input', () => {
      if (nameInput.value.trim().length >= 2) {
        nameError?.classList.add('hidden');
        nameInput.setAttribute('aria-invalid', 'false');
      }
    });

    phoneInput?.addEventListener('input', () => {
      const cleanPhone = phoneInput.value.replace(/[^0-9]/g, '');
      if (cleanPhone.length >= 8) {
        phoneError?.classList.add('hidden');
        phoneInput.setAttribute('aria-invalid', 'false');
      }
    });

    consentInput?.addEventListener('change', () => {
      if (consentInput.checked) {
        consentError?.classList.add('hidden');
        consentInput.setAttribute('aria-invalid', 'false');
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isSubmitting) return;

      errorBanner?.classList.add('hidden');

      let isValid = true;
      const nameVal = nameInput ? nameInput.value.trim() : '';
      const phoneVal = phoneInput ? phoneInput.value.trim() : '';
      const cleanPhone = phoneVal.replace(/[^0-9]/g, '');

      if (!nameVal || nameVal.length < 2) {
        nameError?.classList.remove('hidden');
        nameInput?.setAttribute('aria-invalid', 'true');
        nameInput?.focus();
        isValid = false;
      } else {
        nameError?.classList.add('hidden');
        nameInput?.setAttribute('aria-invalid', 'false');
      }

      if (!phoneVal || cleanPhone.length < 8) {
        phoneError?.classList.remove('hidden');
        phoneInput?.setAttribute('aria-invalid', 'true');
        if (isValid) phoneInput?.focus();
        isValid = false;
      } else {
        phoneError?.classList.add('hidden');
        phoneInput?.setAttribute('aria-invalid', 'false');
      }

      if (!consentInput || !consentInput.checked) {
        consentError?.classList.remove('hidden');
        consentInput?.setAttribute('aria-invalid', 'true');
        if (isValid) consentInput?.focus();
        isValid = false;
      } else {
        consentError?.classList.add('hidden');
        consentInput?.setAttribute('aria-invalid', 'false');
      }

      if (!isValid) {
        if (announcer) announcer.textContent = 'Please fill out all required fields correctly.';
        return;
      }

      // Check honeypot
      if (botTrapInput && botTrapInput.value) {
        console.warn('Spam trap triggered.');
        return;
      }

      isSubmitting = true;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-80', 'cursor-not-allowed');
      }
      if (btnText) btnText.textContent = 'Submitting Request...';
      if (btnArrow) btnArrow.classList.add('hidden');

      const payload = {
        submissionType: 'service',
        service: serviceName,
        fullName: nameVal,
        phone: phoneVal,
        message: messageInput ? messageInput.value.trim() : '',
        website_url_check: botTrapInput ? botTrapInput.value : '',
        form_timestamp: timestampInput ? timestampInput.value : Date.now().toString(),
      };

      try {
        const response = await fetch('/api/enquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => null);

        if (response.ok && result && result.success) {
          const leadId = result.leadId || `VC-SRV-${Date.now().toString().slice(-6)}`;
          if (successRef) successRef.textContent = `Reference ID: ${leadId}`;
          if (waConfirmLink) {
            const waMsg = `Hello Visa Convention, I just submitted an inquiry for ${serviceName} (Ref: ${leadId}). Could you please share the next steps?`;
            waConfirmLink.href = `https://wa.me/919680395539?text=${encodeURIComponent(waMsg)}`;
          }

          form.classList.add('hidden');
          successView?.classList.remove('hidden');
          successView?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          if (announcer) announcer.textContent = 'Your service assistance request has been delivered successfully.';
        } else {
          throw new Error(result?.message || 'Submission could not be completed.');
        }
      } catch (err) {
        console.error('Service form error:', err);
        if (errorMessage) {
          errorMessage.textContent = err.message || 'We could not deliver your request. Please connect directly via WhatsApp or Telephone.';
        }
        errorBanner?.classList.remove('hidden');
        errorBanner?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        if (announcer) announcer.textContent = 'Error delivering request. Please reach out via WhatsApp.';
      } finally {
        isSubmitting = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-80', 'cursor-not-allowed');
        }
        if (btnText) btnText.textContent = submitButtonText;
        if (btnArrow) btnArrow.classList.remove('hidden');
      }
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      form.classList.remove('hidden');
      successView?.classList.add('hidden');
      if (timestampInput) timestampInput.value = Date.now().toString();
      form.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
